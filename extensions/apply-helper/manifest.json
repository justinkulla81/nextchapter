{
  "manifest_version": 3,
  "name": "NextChapter Apply Helper",
  "version": "1.0.0",
  "description": "Fills the boring parts of a job application (name, contact, current job, resume) from your NextChapter profile. You review everything and press Submit yourself.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://launchyournextchapter.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.lever.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://jobs.ashbyhq.com/*", "https://jobs.lever.co/*"],
      "js": ["field-map.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "NextChapter Apply Helper" }
}
