enum RelativeRank {
  BOTTOM_HALF
  TOP_HALF
  TOP_25
  TOP_10
  TOP_1
}

enum HireAgainLevel {
  NO
  PROBABLY_NOT
  PROBABLY
  DEFINITELY
}

// Manager-only — "when they left, what happened?"
enum DepartureContext {
  INITIATED_BY_ME
  RELIEVED
  UNDERSTOOD_SUPPORTED
  ASKED_TO_STAY
  FOUGHT_TO_KEEP
}

enum TakeAgainLevel {
  NO
  MAYBE
  YES
  YES_FIRST_CALL
}

enum TrustedScopeLevel {
  SAME
  SOMEWHAT_MORE
  MEANINGFULLY_MORE
  STEP_CHANGE
}

// Recruiter portal §A6.3.
enum HiringManagerCallAvailability {
  YES
  MAYBE_ASK_FIRST
