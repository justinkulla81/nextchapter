// One row per real login "sitting" — recordCandidateLoginIfDue (called from
// getDashboardData, the shared per-request candidate loader) collapses
// repeated page loads within LOGIN_DEDUPE_WINDOW_MS into a single row rather
// than logging every request, so this approximates session starts across all
// three sign-in paths (password, magic link, Google OAuth) without needing
// to hook each one separately. Admin-facing: a login history with shifting
// IPs/user agents is a stronger signal than a single lastLoginAt field.
model CandidateLoginEvent {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime         @default(now())

  @@index([candidateId, createdAt])
}

enum HomepageVisitEventType {
  PAGE_VIEW
  LINK_CLICK
}

// Lightweight self-hosted visitor tracking for the public homepage —
// deliberately NOT candidate/coach/recruiter/admin app usage (that's
// CandidateLoginEvent's job). Recorded via a client-side beacon
// (HomepageVisitTracker) so the homepage itself stays statically
// renderable — no per-request IP lookup inside the page's own render path.
// IPs in TRUSTED_OWNER_IPS (the site owner's own devices) are never
// recorded at all, not just filtered from display, so they can't leak into
// the daily digest even by accident.
model HomepageVisitEvent {
  id        String                 @id @default(cuid())
  ip        String?
  eventType HomepageVisitEventType
  href      String? // LINK_CLICK only — the destination the visitor clicked
  referrer  String? // PAGE_VIEW only — where the visitor came from
  userAgent String?
  createdAt DateTime               @default(now())

  // Set only when the beacon request carried a real (non-anonymous) Supabase
  // session — most homepage visitors are logged out, so this is null far
  // more often than not. Never used to look up/create a profile, only to
  // attach an existing one, so this never grows CandidateProfile rows.
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([ip, createdAt])
  @@index([createdAt])
  @@index([candidateId])
}

// Prompt: Portfolio — a candidate can hold several distinct narratives (e.g.
// "Why I'm leaving finance for product", "The RIF story"), not just one.
// The earliest-created row per candidate ("My Story") stays the one Interview
// Prep and the Guides unlock-gate read by default, so that existing single-
// narrative UX keeps working unchanged; everything past the first is a
// portfolio-only addition.
model CandidateNarrative {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  label         String @default("My Story") // candidate-facing name for this narrative/scenario
  coreStatement String // 2-3 sentence "Core Narrative Statement", candidate-editable
  adaptations   Json // {linkedinHeadline, linkedinAbout, resumeSummary, emailOpening, verbal30s, tellMeAboutYourself, friendsAndFamily, conversationOpener, coverLetterTemplate}

  // "Answers to the Hard Questions" — casual-register answers to
  // what-happened/why-are-you-looking/how's-it-going, generated once per
  // candidate and stored on the DEFAULT narrative row only (never on a
  // tailored-narrative row). See src/lib/narrative/hard-questions.ts.
  hardQuestions            Json?
  hardQuestionsGeneratedAt DateTime?
  // One-time per-row Weekly Sprint bonus for TAILORED_NARRATIVE_COMPLETE —
  // set the first time this row's `adaptations` populate. Only ever set on
  // non-default (tailored) rows; the default row's equivalent bonus is
  // CandidateProfile.waysToSayItBonusAt instead.
  tailoredBonusAwardedAt   DateTime?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Resumes uploaded/aligned to this narrative (see Resume.narrativeId) —
  // required back-relation, not otherwise traversed today.
  resumes Resume[]

  @@index([candidateId, generatedAt])
}

model WorkHistoryEntry {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyName     String
  companyIndustry String?
  roleTitle       String
  startDate       DateTime
  endDate         DateTime? // null = current
  isCurrent       Boolean              @default(false)
  teamSize        Int?
  managedPeople   Boolean              @default(false)
  keyAchievement  String?
  departureReason EmploymentSituation?
  verified        Boolean              @default(false)
  verifiedBy      String?

  // Never rendered as a qualifier on external-facing documents (Recruiter
  // Report, What They See) — see sanitizeRoleTitle() — but tracked so the
  // candidate can flag it and so concurrent fractional/interim engagements
  // can be collapsed to one displayed at a time via isPrimaryEngagement.
  engagementType      EngagementType @default(FULL_TIME)
  isPrimaryEngagement Boolean        @default(false)

  // Re-verification for active fractional/interim engagements (Prompt 51) —
  // Victoria checks in roughly every 30 days (or at expectedEndDate, if
  // given) asking "still doing this work?" so isCurrent/endDate stay
  // accurate — the resume's "one active engagement at a time" rule
  // (sanitize.ts) depends on this being current, not stale.
  expectedEndDate DateTime?
  nextReverifyAt  DateTime?

  // Normalized via normalizeOrgName() (src/lib/text/org-name-match.ts) —
  // used for company-group membership on Community and for resume-parsing
  // dedup, so "Google" and "Google LLC" collapse to the same group instead
  // of fragmenting. Backfilled for pre-existing rows by
  // scripts/backfill-profile-buckets.ts.
  companyNameNormalized String  @default("")
  // True only for rows written by the resume-parsing sync (never for
  // manually-entered rows) — lets that sync tell its own rows apart from
  // candidate-typed ones without a separate join table.
  resumeDerived         Boolean @default(false)

  references Reference[]

  @@index([candidateId])
  @@index([companyNameNormalized])
}

// Permanent, platform-wide cache of company name -> employee-count band.
// Keyed by normalizeOrgName() (src/lib/text/org-name-match.ts) so "Google" /
// "Google LLC" / "Google Inc." collapse to one row, resolved once and
// reused forever — this is what makes the LLM fallback in
// src/lib/market/company-size.ts one-time-per-distinct-company-name-ever,
// never per-candidate and never recurring. Shared by the candidate-side
// level-rank calibration (level-rank-service.ts) and the ATS job-board feed
// (ats-job-board-feed.ts). RoleProfile does NOT use this table — it reads
// its owning EmployerProfile.companySize directly (a free, direct relation,
// no lookup needed).
//
// Never exposed on any user-facing surface — internal calibration input
// only, same visibility rule as CandidateProfile.levelRankScore.
model CompanySizeLookup {
  id String @id @default(cuid())

  // via normalizeOrgName() — the only real key. Unique so a race between
  // two concurrent first-encounters of the same company resolves to one
  // row (see the upsert-based write in company-size.ts).
  companyNameNormalized String          @unique
  // First-seen raw name, kept only for admin/debugging readability — never
  // used for matching (companyNameNormalized is authoritative).
  companyNameOriginal   String
  sizeBand              CompanySizeBand

  // 'static' | 'llm' — 'static' rows are fully trusted (confidence always
  // null); 'llm' rows carry the model's own confidence.
  source      String
  // 0-1, only meaningful for source: 'llm'. Not currently used to gate
  // anything (an LLM guess, even low-confidence, beats no data at all per
  // the "unknown -> anchor, never blocks" fallback rule) — captured so a
  // future pass can decide to treat low-confidence rows differently
  // without needing a new column.
  confidence  Float?
  // The LLM's own free-text reasoning, kept for admin/QA debugging only —
  // never shown to any candidate/recruiter/coach/employer surface.
  llmRawNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sizeBand])
}

// Mirrors CompanySizeLookup above — permanent, platform-wide cache so a
// company's industry is classified by the LLM at most once ever, not
// per-candidate and not on every report view. Feeds the application-trends
// industry-consistency signal (src/lib/network/application-trends.ts).
model CompanyIndustryLookup {
  id String @id @default(cuid())

  companyNameNormalized String @unique
  companyNameOriginal   String
  // One of INDUSTRY_BUCKET_NAMES (src/lib/constants/industry-buckets.ts) —
  // a plain string, not a Prisma enum, since that bucket list lives in
  // admin-editable TS rather than the schema.
  industryBucket        String

  source      String // 'llm' only for now — no curated static list exists yet (unlike company size)
  confidence  Float?
  llmRawNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industryBucket])
}

// Structured, one-row-per-degree education history — mirrors WorkHistoryEntry's
// conventions exactly. Supports multiple degrees per candidate (undergrad +
// MBA at different schools, etc.); isPrimary marks the one that represents
// them for the alma-mater exec-ed lookup (Learning page) and the alumni
// community group.
model EducationEntry {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Normalized to the parent institution only (e.g. "Harvard University",
  // never "Harvard Kennedy School") — both the resume-extraction prompt and
  // schoolNameNormalized enforce this, so exec-ed lookup and alumni grouping
  // never fragment by sub-school/department.
  schoolName           String
  schoolNameNormalized String
  degree               String?
  fieldOfStudy         String?
  startDate            DateTime? // nullable — resumes routinely omit this
  graduationDate       DateTime?

  // Exactly one row per candidate should end up primary — see
  // syncResumeEducation() for the tie-break rule (most recent graduation
  // date wins, then degree rank, then first-listed).
  isPrimary     Boolean @default(false)
  resumeDerived Boolean @default(false)
  verified      Boolean @default(false)
  verifiedBy    String?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([schoolNameNormalized])
}

model Reference {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  refereeEmail         String
  refereeName          String
  refereeTitle         String? // the REFEREE's own title (e.g. "VP Engineering"), not the candidate's — see "Their title" on ReferenceRequestForm
  refereeCompany       String? // the REFEREE's own company, not the candidate's
  // Set only via admin-confirmed CandidateIdentityMatch — never inferred or
  // auto-linked. The referee is a real NextChapter member in their own
  // right; this is purely an FYI cross-link, not required for the
  // reference flow (token-based, email-only) to keep working.
  refereeCandidateId   String?
  refereeCandidate     CandidateProfile? @relation("RefereeCandidate", fields: [refereeCandidateId], references: [id], onDelete: SetNull)
  relationshipType     ReferenceType
  yearsWorkedTogether  Int?
  verifiedRelationship Boolean           @default(false)
  status               ReferenceStatus   @default(REQUESTED)
  requestedAt          DateTime          @default(now())
  completedAt          DateTime?
  declinedAt           DateTime? // set when the referee self-declines via /ref/[token] — distinct from an admin/candidate-set DECLINED status
  declineReason        String? // optional, referee-supplied — shown to the candidate
  lastFollowUpNudgedAt DateTime? // set when the candidate clicks "Follow up" on a pending reference — powers the REFERENCE_FOLLOW_UP Sprint action

  // Which of the candidate's jobs this reference is for — lets the ref
  // token page ask the referee to verify the CANDIDATE's actual title/
  // company (and the resume's keyAchievement bullet for that role) instead
  // of only re-confirming the referee's own claimed identity. Nullable:
  // older references predate this, and some references (e.g. a peer who
  // knew the candidate across multiple roles) don't map to one job.
  workHistoryEntryId String?
  workHistoryEntry   WorkHistoryEntry? @relation(fields: [workHistoryEntryId], references: [id], onDelete: SetNull)
  token              String            @unique @default(cuid())

  // Behavioral ratings (1-5 scale)
  ratingReliability   Int?
  ratingCommunication Int?
  ratingConflictNav   Int?
  ratingTeamLift      Int?
  ratingWorkEthic     Int?
  ratingGrowthMindset Int?
  ratingPositivity    Int?
  overallRating       Int?

  // Qualitative (shown to employers in summary only)
  strengthSummary   String?
  growthAreaSummary String?
  wouldHireAgain    Boolean?
  contextNotes      String?

  // Candidate-initiated dispute/correction, before this reference is ever
  // shared in a Certified Executive Dossier. A disputed-and-unresolved
  // reference is excluded from it — see getRecruiterReportData.
  candidateDisputeNote String?
  candidateDisputedAt  DateTime?
  disputeResolvedAt    DateTime?

  // BARS ratings per dimension (1-5 scale with behavioral anchors)
  // Used to compute CandidateAssessmentResponse.referenceDelta — see
  // src/lib/scoring/reference-delta.ts.
  barsVelocity          Int? // 1=deliberate, 5=urgent
  barsArchitecture      Int? // 1=creates playbook, 5=executes
  barsStructure         Int? // 1=needs clarity, 5=thrives in ambiguity
  barsCommunication     Int? // 1=async, 5=sync
  barsEnvironment       Int? // 1=deep focus, 5=constant collab
  barsLeadership        Int? // 1=coaching, 5=direct/blunt
  barsOversight         Int? // 1=hands-off, 5=micromanagement
  barsCommitment        Int? // 1=protects hours, 5=whatever it takes
  barsConscientiousness Int? // 1=flexible with process, 5=rigorous with detail

  // Reference Testimony Intake (Dossier Prompt 48) — five reference-only
  // character traits, deliberately NOT mirrored from Working Style's 9
  // neutral either-direction dimensions (Velocity, Structure, etc. don't
  // read as virtues on an external reference form). Each 1-5 rating pairs
  // with a required one-example text, same "give one example" spec as the
  // original prompt. Used for the Dossier's "confirmed by N of M
  // references" callout via testimony-processing.ts's strength-to-trait
  // mapping against the candidate's self-identified topStrengths.
  traitAdaptabilityRating   Int?
  traitAdaptabilityExample  String? @db.Text
  traitFollowThroughRating  Int?
  traitFollowThroughExample String? @db.Text
  traitPresenceRating       Int?
  traitPresenceExample      String? @db.Text
  traitCollaborationRating  Int?
  traitCollaborationExample String? @db.Text
  traitComposureRating      Int?
  traitComposureExample     String? @db.Text

  // Open-ended, reference-only questions (never asked of the candidate) —
  // raw material for Victoria's themed pull-quote drafts (ReferenceQuote).
  superpowerText           String? @db.Text
  underPressureStory       String? @db.Text
  definingStory            String? @db.Text // "one story that shows who they are, not just what they did"
  wouldWorkWithAgainReason String? @db.Text

  // null = not yet answered; true = ok to quote with name/title in the
  // Dossier; false = "available on request" only, never printed verbatim.
  quotableWithAttribution Boolean?

  quotes ReferenceQuote[]

  // Assessment Layer Reference Check (spec v1.0, Part A-D) — a SECOND,
  // independent rating layer alongside the BARS style ratings above. BARS
  // rates WORKING STYLE (velocity, structure, etc. — no right answer,
  // powers the existing style "friction" comparison in the Hiring Manager
  // Report). Everything below rates PERFORMANCE (right/wrong exists),
  // parallel to the candidate's own How I Perform self-report, and is a
  // distinct comparison the Hiring Manager Report will show alongside the
  // style one, not instead of it. All rating fields are 1-4 on the
  // anchored scale (1=Below what the role needed ... 4=Exceptional — see
  // src/lib/references/anchored-scale.ts) and nullable to support "Didn't
  // see this," which is excluded from aggregation entirely.

  // Part A — Performance (12 items, 4 dimensions x 3). Parallel to the
  // EXECUTION/JUDGMENT/COMPOSURE/INFLUENCE dimensions of How I Perform.
  // Integrity is deliberately absent here — spec keeps it self-report-only,
  // coach-only, never rated by a reference or scored into any category.
  perfExecutionDelivered        Int?
  perfExecutionQuality          Int?
  perfExecutionAutonomy         Int?
  perfJudgmentDecisionQuality   Int?
  perfJudgmentEscalation        Int?
  perfJudgmentSituationalRead   Int?
  perfComposureSteadiness       Int?
  perfComposureFeedbackResponse Int?
  perfComposureEffectOnOthers   Int?
  perfInfluenceOutcomes         Int?
  perfInfluenceCredibility      Int?
  perfInfluenceDirectness       Int?

  // Part B — Comparative (5 items). Self-normed against the rater's own
  // bench rather than a cross-candidate norm group — no n-size requirement.
  compRelativeRank     RelativeRank? // b1, manager-only in copy but stored regardless
  compWouldHireAgain   HireAgainLevel? // b2 — distinct from legacy wouldHireAgain (Boolean, different question)
  compDepartureContext DepartureContext? // b3, manager-only
  compWouldTakeAgain   TakeAgainLevel? // b4
  compTrustedScope     TrustedScopeLevel? // b5

  // Part C — Written, rotating. Exactly 2 questions per reference, assigned
  // at invite time from the pool (w1-w11) by inviteSequence + relationship,
  // stable across sessions. Position 1 always gets w11 (verification-tied)
  // + w1; every reference after that gets one relationship-specific
  // question plus one general question, never repeating a key within one
  // candidate's set. See src/lib/references/written-question-pool.ts.
  writtenQuestion1Key  String? // assigned question, e.g. "w1" — see written-question-pool.ts
  writtenQuestion1Text String? @db.Text // the assigned question's own copy, snapshotted at assignment
  writtenResponse1Text String? @db.Text // the reference's answer
  writtenQuestion2Key  String?
  writtenQuestion2Text String? @db.Text
  writtenResponse2Text String? @db.Text

  // Part D — Verification. Pre-filled from the candidate's own claims
  // (title/dates already on this row via refereeTitle/yearsWorkedTogether;
  // relationship via verifiedRelationship above); scope verification is
  // additive here since Track Record (candidate-side scope claims) doesn't
  // exist yet — these fields work standalone against whatever context the
  // reference was given at invite time.
  verifiedTitleCorrect     Boolean? // verifies the CANDIDATE's job title (workHistoryEntry.roleTitle), not the referee's own title
  correctedTitle           String?
  verifiedCompanyCorrect   Boolean? // verifies the CANDIDATE's employer (workHistoryEntry.companyName) for that role
  correctedCompany         String?
  verifiedBulletCorrect    Boolean? // verifies the resume's keyAchievement bullet for that role
  correctedBullet          String?
  verifiedDatesCorrect     Boolean?
  correctedDates           String?
  verifiedReportingCorrect Boolean?
  correctedReporting       String?
  verifiedScopeCorrect     Boolean?
  correctedScope           String?
  verificationConfidence   Int? // 1-4

  // Recruiter portal §A6.3 -- "If this person reaches final stages, would
  // you take a short call from the hiring manager?" Asked once, at
  // reference completion, alongside Part D verification. Aggregated on the
  // Dossier as "N of M references available for hiring manager calls" --
  // see buildReferenceVerification. Null = not yet answered (older
  // references that predate this field, or a reference still in progress).
  availableForHiringManagerCall HiringManagerCallAvailability?

  // Order this reference was invited in, 1-based per candidate — drives
  // Part C's "position 1 always gets w11+w1" assignment rule. Set once at
  // invite time, never recomputed (removing an earlier reference must not
  // reshuffle a later one's already-answered written questions).
  inviteSequence Int?

  // Paginated-form autosave (see ReferenceSubmissionForm) — a raw name:value
  // snapshot of every field answered so far, written on each "Next" click so
  // an abandoned-partway reference still leaves real data behind instead of
  // nothing. draftPage lets a returning referee resume where they left off.
  // Cleared (set back to null) once status flips to COMPLETED.
  draftAnswers   Json?
  draftPage      Int?
  draftUpdatedAt DateTime?

  @@index([candidateId, status])
  @@index([token])
}

// Victoria-drafted, themed pull-quote sourced from a reference's open-ended
// answers — MANDATORY candidate approval gate before it can appear in the
// Dossier (Prompt 47/48's "never auto-publish a reference's words" rule).
// approvedByCandidateAt null = not yet Dossier-eligible; rejectedAt set =
// candidate removed it, never resurface.
model ReferenceQuote {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  referenceId String
  reference   Reference        @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  theme     String // e.g. "Under pressure", "Developing people", "Raising the bar"
  quoteText String @db.Text

  approvedByCandidateAt DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([candidateId, approvedByCandidateAt])
}

// The 5x3 competency grid — Master Build Script §4. Five competencies
// (Leadership & Management, Skills & Execution, Communication &
// Collaboration, Adaptability & Change Readiness, Ownership & Reliability —
// same 5 keys as grade.ts's CategoryKey, minus targetFit) x three evidence
// sources (reference, assessment, activity), each scored independently and
// NEVER blended across sources — that's the entire point of the grid vs.
// the live six-category blended grade in dossier-competencies.ts, which
// this table is deliberately separate from and does not replace (both
// systems stay, per the Master Build Script's explicit resolution: "the
// live six-category grade and the new engine are different objects").
// Deliberately no "resume" source/column (§4: "a resume therefore fills 0
// of 15 cells — this is the intended state," since Your Experience/Your
// Resume already score everything the resume says).
model CompetencyScore {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  competency String // "leadership" | "skillsExecution" | "communication" | "adaptability" | "ownership" — CompetencyKey
  source     String // "reference" | "assessment" | "activity" — CompetencySource

  score    Int? // 0-100, null when unmeasured — never zero (§3.6/§5.2: unmeasured is a state, not a low score)
  measured Boolean @default(false)

  // Points at the source record this cell's score was computed from (a
  // Reference id, a PerformanceAssessmentResponse id, etc.) — so a
  // candidate-facing "what filled this in" link never has to re-derive it,
  // and so a legacy/backfilled row (measured=false, no real attribution
  // yet) is visibly distinct from a freshly-computed one.
  evidenceRef String?

  updatedAt DateTime @updatedAt

  @@unique([candidateId, competency, source])
  @@index([candidateId])
}

model WorkSample {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title            String
  description      String
  problemStatement String?
  candidateRole    String?
  outcome          String?
  sampleType       String // "case_study" | "writing" | "code" | "design" | "presentation" | "other"
  fileUrl          String?
  externalUrl      String?
  verified         Boolean  @default(false)
  verifiedByEmail  String?
  createdAt        DateTime @default(now())

  @@index([candidateId])
}

model InterviewResponse {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  questionId      String // References question bank
  questionText    String
  responseType    String // "text" | "audio" | "video"
  responseText    String?
  responseFileUrl String?
  aiSignalScore   Int? // Internal scoring 1-100
  aiSignalNotes   String? // Internal notes on response quality
  feedback        Json? // candidate-facing: {usesStarStructure, lengthNote, strengths, improvements}
  createdAt       DateTime @default(now())

  @@index([candidateId])
}

model PeerNomination {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  nominatorEmail      String
  nominatorName       String
  nominatorPlatformId String? // If nominator is also on NextChapter
  traitNominated      String // "cross-functional leadership" | "mentorship" | etc.
  context             String?
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([candidateId])
}

model LearningBadge {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  badgeType       String // "course_completed" | "certification" | "ai_project" | "conference_talk" | "published"
  title           String
  provider        String?
  description     String?  @db.Text // what was built/produced — only "ai_project" badges use this today
  judgmentCall    String?  @db.Text // "ai_project" only — the specific judgment call the candidate made while directing the AI (not just "completed a course"); the AI Fluency signal for Market Reality named reasons and the Dossier's AI Fluency section
  completedAt     DateTime
  verificationUrl String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([candidateId])
}

enum CourseActivityStatus {
  ENROLLED
  COMPLETED
}

// Per-course "Enrolled"/"Course Complete" status shown on the Learning
// page's recommendation cards — detected automatically from Gmail
// (COURSE_ENROLLMENT_PATTERNS/COURSE_COMPLETION_PATTERNS in
// ats-patterns.ts) rather than a manual "Mark done" click, which no longer
// exists. COMPLETED additionally creates a LearningBadge (see
// markCourseCompletedFromEmail in sync-gmail.ts) so it still counts toward
// the Certified Executive Dossier and Weekly Search Score — this table
// exists to drive the card's own status pill, including the ENROLLED state
// LearningBadge has no equivalent for.
model CandidateCourseActivity {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  courseTitle String
  provider    String?
  status      CourseActivityStatus
  detectedAt  DateTime             @default(now())

  @@unique([candidateId, courseTitle])
  @@index([candidateId])
}

// One row per tool a candidate has either marked "already familiar" (a
// curated tool from ai-tools-by-function.ts, isCustom: false, toolUrl
// null — the URL lives in the constants file) or added themselves
// (isCustom: true, toolUrl required so it renders as a real link). Same
// table for both since the Learning page's Tools section treats them as
// one merged list.
model CandidateAiToolFamiliarity {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  toolName String
  toolUrl  String?
  isCustom Boolean  @default(false)
  addedAt  DateTime @default(now())

  @@unique([candidateId, toolName])
  @@index([candidateId])
}

model AssessmentResult {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  assessmentType   String // "big_five" | "holland" | "high5" | "work_style"
  rawScores        Json // Raw instrument scores
  translatedOutput Json // Plain-English outputs for employer reports
  completedAt      DateTime @default(now())

  @@index([candidateId])
}

// ── WORK STYLE ASSESSMENT (quad-block / Likert / BARS) ─────────────────────
// First-pass, unvalidated instrument — see src/lib/scoring/assessment-vectors.ts
// for the scoring algorithm and its documented limitations.

model QuadBlock {
  id            String               @id @default(cuid())
  blockNumber   Int
  rotationGroup Int                  @default(1)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  statements    QuadBlockStatement[]
}

model QuadBlockStatement {
  id                      String    @id @default(cuid())
  blockId                 String
  block                   QuadBlock @relation(fields: [blockId], references: [id])
  dimension               String // "velocity" | "architecture" | "structure" | "communication" | "environment" | "leadership" | "oversight" | "commitment"
  pole                    String // "high" or "low" on that dimension
  statementText           String
  socialDesirabilityScore Float // Should be balanced 3.8-4.2 across all 4 in block
}

model LikertItem {
  id                  String  @id @default(cuid())
  dimension           String // Maps to same 8 dimensions
  pole                String // Which end of the dimension this probes
  itemText            String
  isReversed          Boolean @default(false) // If true, scoring is inverted
  targetedFriction    String // What specific anxiety or friction this surfaces
  pairedQuadDimension String // Which quad-block dimension this validates against
  rotationGroup       Int     @default(1)
  isActive            Boolean @default(true)
}

model CandidateAssessmentResponse {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())

  // Layer 1: Quad-block responses
  quadResponses Json // Array of {blockId, mostLikeMe: statementId, leastLikeMe: statementId}

  // Layer 2: Likert responses
  likertResponses Json // Array of {itemId, score: 1-5}

  // Computed vectors
  dimensionVectors Json // {velocity: -2..+2, architecture: -2..+2, ...}

  // Inconsistency Index
  inconsistencyScore   Float?
  inconsistencyPairs   Json? // Which specific pairs triggered variance
  manipulationRiskFlag Boolean @default(false)
  flagThreshold        Float? // The SD value that triggered flag, if any

  // Reference delta — populated by src/lib/scoring/reference-delta.ts once
  // both this response and at least one BARS-scored reference exist.
  referenceDelta   Json? // Candidate vector vs reference BARS aggregate
  frictionSurfaces String[] // Dimensions where delta > threshold — shown to employers

  @@index([candidateId])
}

// Assessment Layer spec Part 3 ("How I Perform") — a *performance* self-report,
// deliberately separate from CandidateAssessmentResponse above which is a
// *style* self-report (no right/wrong answer). This one has a right and wrong
// end per item; Reference.perf* fields (Part A of the Reference Check) rate
// the same 4 scored dimensions in parallel on the same referee. Integrity is
// 5th dimension, self-only — never surfaced as a score, never blended into
// the Market Reality Grade (spec §3.2), only read by Coaching Notes / Hiring
// Manager Notes.
model PerformanceAssessmentResponse {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())

  responses Json // Array of {itemId: 1-40, score: 1-4} — raw answers, reverse items not yet flipped

  // Computed 1-4 dimension means, reverse-scored items flipped. Never display
  // the raw float to a candidate or employer — round via meanToAnchorLabel-
  // style presentation at the read site, same rule as the Reference Check
  // anchored scale (src/lib/references/anchored-scale.ts).
  executionScore Float
  judgmentScore  Float
  composureScore Float
  influenceScore Float
  integrityScore Float

  @@index([candidateId])
}

// Track Record (spec §4.2) — 20 structured items, no free text except item
// 20. One row per candidate (a profile fact set, not a retaken behavioral
// instrument like How I Perform). Items 1 and 15 in the spec ("largest team
// directly managed" / "direct reports at peak") describe the same real
// fact, so they're deliberately collapsed into one field here rather than
// asked twice. Item 16 ("have you been a people manager?") reuses the
// existing CandidateProfile.isPeopleManager field it's migrating from — no
// separate column needed. Item 15's other migration source,
// CandidateProfile.teamSizeManaged, is NOT written from here (it stays a
// raw number, this is a band) — see the comment on that field.
model TrackRecordResponse {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  largestTeamManaged         TrackRecordSizeBand? // items 1 & 15
  largestOrgIndirect         TrackRecordSizeBand? // item 2
  budgetOwned                TrackRecordDollarBand? // item 3
  approvalAuthority          String[] // item 4 — ApprovalAuthority values
  situationRanking           String[] // item 5 — ordered OperatingSituation values, most to least
  mandateClarity             Int? // item 6 — 1-4
  functionsOwnedOutsideCore  String[] // item 7
  droveOutcomesThroughOthers Int? // item 8 — 1-4
  peopleHiredDirectly        TrackRecordSizeBand? // item 9
  ledThroughRestructuring    Boolean? // item 10
  sectorHistory              String[] // item 11a
  stageHistory               String[] // item 11b
  boardExposure              TrackRecordBoardExposure? // item 12
  largestInitiativeScope     TrackRecordDollarBand? // item 13
  longestTenure              TrackRecordTenureBand? // item 14
  pnlAccountability          TrackRecordPnlAccountability? // item 17
  geographicScope            TrackRecordGeographicScope? // item 18
  reportedToLevel            TrackRecordReportedToLevel? // item 19
  accomplishmentToConfirm    String?                       @db.Text // item 20 — routes into Reference Check verification

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// What I Need (spec §4.4) — 24 items rated Not important/Somewhat/
// Important/Essential, mapped to the 6 O*NET Work Values, plus a drag-rank
// of the 6 domains. One row per candidate.
model WhatINeedResponse {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // {itemId: 'achievement-1', rating: 1-4} for all 24 items — see
  // src/lib/constants/what-i-need.ts for the fixed item bank this indexes
  // into.
  itemRatings Json

  // Six WorkValueDomain keys, most to least important — the report
  // headline and tie-breaker per spec §4.4.
  domainRank String[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BARSAnchor {
  id         String  @id @default(cuid())
  dimension  String
  scalePoint Int // 1-5
  anchorText String // Specific observable behavior at this scale point
  isActive   Boolean @default(true)
}

model ApprovedEmployer {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    EmployerProfile  @relation(fields: [employerId], references: [id])
  approvedAt  DateTime         @default(now())

  @@unique([candidateId, employerId])
}

// ── EMPLOYER SIDE ────────────────────────────────────────────────────────────

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName                String
  companyWebsite             String?
  companySize                String? // "1-10" | "11-50" | "51-200" | "201-1000" | "1000+"
  companyStage               String? // "startup" | "growth" | "enterprise" | "non-profit" | "government"
  companyIndustry            String?
  // Set once the hiring manager has confirmed (or corrected) the
  // LLM-suggested companyIndustry guessed from companyWebsite/companyName at
  // signup — same shape as CandidateProfile's *ConfirmedAt fields.
  companyIndustryConfirmedAt DateTime?
  logoUrl                    String?
  contactName                String?
  isSampleData               Boolean   @default(false)

  // Personal profile picture for the hiring-manager user (distinct from the
  // company logoUrl above) — shown in messaging only. Never surfaced to
  // candidates elsewhere.
  profilePictureUrl String?

  // No-Ghosting Commitment — signup-time acknowledgment only (P0). The
  // response-rate/badge tracking system this later feeds is P1/P2, not built.
  noGhostingCommitmentAccepted   Boolean   @default(false)
  noGhostingCommitmentAcceptedAt DateTime?

  // Subscription
  subscriptionTier      EmployerTier               @default(CHARTER)
  subscriptionStatus    EmployerSubscriptionStatus @default(TRIALING)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  // Charter employer fields
  isCharterEmployer       Boolean @default(false)
  charterCommitmentSigned Boolean @default(false)
  charterFeedbackNotes    String?

  // Pro culture assessment (required for Pro tier matching)
  cultureAssessmentComplete Boolean   @default(false)
  culturePacePreference     Int?
  cultureFeedbackStyle      Int?
  cultureCollabStyle        Int?
  cultureStructureLevel     Int?
  cultureAmbiguityLevel     Int?
  cultureHoursExpectation   Int?
  cultureManagementStyle    Int?
  cultureAttritionRate      Float?
  cultureHonestyDeclaration Json? // What they offer more/less of vs market
  cultureVerifiedAt         DateTime?

  marketDigestOptedOut Boolean @default(false)

  // Relations
  savedSearches         SavedSearch[]
  roleProfiles          RoleProfile[]
  candidateInteractions CandidateInteraction[]
  approvedCandidates    ApprovedEmployer[]
  jobBoardSubmissions   ExclusiveJobPosting[]
  seats                 EmployerSeat[]
  messageThreads        MessageThread[]

  @@index([subscriptionTier, subscriptionStatus])
}

// Team seats, additive to the original single-owner EmployerProfile.userId
// (which stays the account owner and keeps working through its existing
// direct lookup, unaffected by whether any seats exist). userId is null
// until the invited person accepts and links their own Supabase account.
model EmployerSeat {
  id         String           @id @default(cuid())
  employerId String
  employer   EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  role       EmployerSeatRole @default(MEMBER)

  invitedEmail String
  inviteToken  String    @unique @default(cuid())
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  userId       String?   @unique

  @@unique([employerId, invitedEmail])
  @@index([userId])
}

enum EmployerSeatRole {
  OWNER
  MEMBER
}

model RoleProfile {
  id           String          @id @default(cuid())
  employerId   String
  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isActive     Boolean         @default(true)
  isSampleData Boolean         @default(false)

  roleTitle           String
  roleLevel           String?
  primaryFunction     String?
  // Extracted alongside roleTitle/roleLevel/primaryFunction by the same JD
  // extraction LLM call (extract-role-from-jd.ts) — no additional cost since
  // it rides the existing call. Editable/confirmable in RoleForm before the
  // role is created, same as the other extracted fields.
  requiredSkills      String[] @default([])
  locationRequirement String?
  remotePolicy        String?
  compMin             Int?
  compMax             Int?
  equityOffered       Boolean  @default(false)

  // Role-specific work style requirements
  requiredPaceLevel     Int?
  requiredFeedbackStyle Int?
  requiredCollabStyle   Int?
  requiredStructure     Int?
  requiredAmbiguity     Int?
  requiredHours         Int?

  // Success definition
  success30Days  String?
  success90Days  String?
  success180Days String?

  // Hiring manager profile for this role
  hmWorkStyle          Int?
  hmFeedbackStyle      Int?
  hmManagementApproach String?
  hmWhatGoodLooksLike  String?

  // Honest tradeoff declaration
  offersMoreThan String[] // e.g. ["learning", "mission", "flexibility"]
  offersLessThan String[] // e.g. ["base_comp", "title"]

  candidateInteractions CandidateInteraction[]

  @@index([employerId, isActive])
}

model SavedSearch {
  id         String          @id @default(cuid())
  employerId String
  employer   EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  searchName      String
  targetFunction  String?
  targetLevel     String?
  targetLocation  String?
  targetSituation EmploymentSituation[]
  minYearsExp     Int?
  maxYearsExp     Int?
  remoteOk        Boolean               @default(false)
  linkedRoleId    String?

  lastDigestSent DateTime?
  digestEnabled  Boolean   @default(true)

  @@index([employerId])
}

model CandidateInteraction {
  id          String           @id @default(cuid())
  employerId  String
  employer    EmployerProfile  @relation(fields: [employerId], references: [id])
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  roleId      String?
  role        RoleProfile?     @relation(fields: [roleId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  status        CandidateInterestStatus @default(VIEWED)
  employerNotes String?

  // Match data (computed at time of interaction)
  genericMatchScore  Int? // 0-100 overall
  workStyleAlignment Int? // 0-100
  situationRelevance Int? // 0-100
  tailoredFitScore   Int? // 0-100 (Pro only, requires role profile)
  matchReport        Json? // Full hiring manager report (Pro only)
  frictionPoints     String[] // Specific friction areas identified

  // Outcome tracking (for validity research)
  hiredAt         DateTime?
  thirtyDayRating Int?
  ninetyDayRating Int?
  sixMonthRating  Int?

  @@unique([employerId, candidateId])
  @@index([employerId, status])
  @@index([candidateId])
}

// ── PLATFORM ─────────────────────────────────────────────────────────────────

model InterviewQuestionBank {
  id            String   @id @default(cuid())
  questionText  String
  category      String // "grit" | "communication" | "collaboration" | "leadership" | "challenge" | "values"
  targetLevel   String[] // "entry" | "mid" | "senior" | "executive"
  isActive      Boolean  @default(true)
  rotationGroup Int      @default(1) // For quarterly rotation
  createdAt     DateTime @default(now())
}

model LayoffCohort {
  id            String   @id @default(cuid())
  companyName   String
  layoffDate    DateTime
  estimatedSize Int?
  newsUrl       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  candidates CandidateProfile[]
  community  Community?
}

// ── CANDIDATE MARKET REALITY REPORT ────────────────────────────────────────
// Resume, job-fit feedback, community board, and the report that ties them
// together with the assessment/reference/interview data collected elsewhere.
// See src/lib/reports/market-reality-report.ts — distinct from the
// employer-facing src/lib/reports/hiring-manager-report.ts, which hides raw
// scores; this one shows everything since it's about the candidate themselves.

// Append-only history — findFirst orderBy uploadedAt desc = current resume.
// Not user-deletable; older uploads are kept as an audit trail. Does not feed
// the Employability Score directly (only the Market Reality Report).
model Resume {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Storage path within the private 'resumes' bucket, NOT a public URL — the
  // bucket has no public read access since resumes carry real PII. Generate
  // a short-lived signed URL on demand (see src/app/dashboard/resume/actions.ts)
  // whenever the file needs to be displayed or re-read.
  filePath        String
  fileName        String
  fileType        String // "pdf" | "docx"
  extractedText   String?
  extractionError String?

  // Candidate-editable — defaults to fileName at upload time but can be
  // renamed (e.g. "Tailored for VP Product roles") to tell versions apart
  // once there are several. description is optional freeform context
  // ("what's different about this one").
  label       String?
  description String? @db.Text

  // Optional — chosen at upload time (see ResumeUploadForm's narrative
  // picker). When set, analyzeResume() grounds its Experience-evaluation
  // feedback in THIS narrative's coreStatement instead of always the
  // candidate's earliest/default one. SetNull (not Cascade) so deleting a
  // narrative never deletes the resume that was aligned to it.
  narrativeId String?
  narrative   CandidateNarrative? @relation(fields: [narrativeId], references: [id], onDelete: SetNull)

  atsScore           Int? // 0-100
  atsFeedback        Json[]    @default([]) // { issue: string, action: string } — issue framed as what a recruiter/hiring manager would notice
  resultsScore       Int? // 0-100 — quantified impact vs. vague duties
  resultsFeedback    Json[]    @default([]) // { issue: string, action: string }
  experienceScore    Int? // 0-100 — gaps, tenure, alignment with stated goals
  experienceFeedback Json[]    @default([]) // { issue: string, action: string }
  analysisError      String?
  analyzedAt         DateTime?

  uploadedAt DateTime @default(now())

  analyses ResumeAnalysis[]
  // Messages this version was attached to (see Message.attachedResumeId) —
  // required back-relation, not otherwise traversed today.
  messages Message[]

  @@index([candidateId, uploadedAt])
}

// ── MARKET REALITY GRADE 2.0 ───────────────────────────────────────────────
// One headline (Market Reality Grade), decomposed into four independently-
// scored components that never blend into each other: Record (this resume,
// on its own), Evidence (references + assessments), Market (role scarcity
// for the stated target), Channels (network + outreach activity). This is
// a different decomposition axis than the six legacy CategoryKey categories
// above (targetFit/leadership/etc, which blend evidence types together
// within each competency) — the two systems compute from an overlapping
// data set but never share a row. See docs/specs/NextChapter_Resume_Scoring_Spec.md
// and companions for the full design.

// One row per resume upload — versioned, append-only, like Resume itself.
// Supersedes Resume.atsScore/resultsScore/experienceScore for the Record
// component; those legacy fields are left in place (still read by older
// call sites) until every consumer migrates to this model.
model ResumeAnalysis {
  id          String           @id @default(cuid())
  resumeId    String
  resume      Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  seniorityBand  String // "EARLY" | "MID" | "SENIOR" | "EXECUTIVE" — spec §5
  functionFamily String // "REVENUE" | "MARKETING" | "ENGINEERING" | "PRODUCT" | "FINANCE" | "OPERATIONS" | "PEOPLE" | "LEGAL" | "CLINICAL" | "GENERAL_MANAGEMENT" — spec §6

  // Keyed by the 11 weighted dimensions (Master Build Script §3.1, spec
  // §3.4/§4): quantification, narrativePositioning, atsLegibility,
  // scopeLevel, trajectory, mechanicsPresentation, tenurePattern,
  // relevanceRecency, industryCoherence, skillCurrency, contactability.
  // Each 0-100. Findings carry the candidate-facing copy, fix, and
  // estimated point gain per dimension (spec §4 Finding shape). Split
  // across the two components below at read time via DIMENSION_COMPONENT
  // (resume-analysis/types.ts) — the raw scores stay in one blob since
  // every dimension is still computed the same way, just weighted into two
  // separate composites instead of one.
  dimensionScores   Json
  dimensionFindings Json

  // Additive/penalty-only modifiers, kept out of dimensionScores so the
  // subtotal-vs-modifier split (spec §3.4) stays auditable at a glance.
  // Prestige and reconciliation apply to Resume only; extracurricular
  // applies to Experience only (Master Build Script §3.1/§9).
  prestigeBonus         Int @default(0) // 0-6, Resume scale (spec §4.13) — never surfaced in any candidate-facing copy
  reconciliationPenalty Int @default(0) // -12-0, Resume (spec §4.11)
  extracurricularBonus  Int @default(0) // 0-3, Experience (spec §4.12)

  // Your Experience (Master Build Script §3.1) — the career itself: scope,
  // trajectory, tenure, relevance, industry coherence, plus the
  // extracurricular/governance bonus. "Mostly fixed."
  experienceScore Int // 0-100, subtotal + extracurricular bonus, clamped
  experienceBand  String // "A" | "A-" | "B+" | "B" | "B-" | "C+" | "C" | "D" | "F"

  // Your Resume (Master Build Script §3.1) — the document describing that
  // career: ATS legibility, quantification, positioning, mechanics,
  // contactability, skill currency, plus prestige bonus and reconciliation
  // penalty. "Days" to fix — this was the sole "composite"/"band" before
  // the Experience/Resume split; renamed rather than reused so a caller
  // reading the schema can't miss that there are now two components.
  resumeScore Int // 0-100, subtotal + prestige + reconciliation, clamped
  resumeBand  String // "A" | "A-" | "B+" | "B" | "B-" | "C+" | "C" | "D" | "F"

  // First Glance (spec §2.2) — an internal diagnostic only, never rendered
  // as its own headline grade (there is exactly one headline: the Market
  // Reality Grade). Feeds which fixes surface first in "What to fix on
  // your resume" and the opening line of "Where you stand" — e.g. a
  // resume that reads well on careful read but buries its best number can
  // still show up as a weak First Glance, and that divergence is worth
  // surfacing in prose even though it never becomes a displayed number.
  firstGlanceScore  Int? // 0-100, spec §3.5 weights — different inputs from the Resume composite above
  firstGlanceResult String? // "PASS" | "BORDERLINE" | "LIKELY_SKIP"
  firstGlanceTopFix String? @db.Text

  atsParseResults   AtsParseResult[]
  reviewerQuestions ReviewerQuestion[]
  prestigeAudit     PrestigeAudit?
  resumeIssues      ResumeIssue[]

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt])
}

// Audit trail for the prestige bonus applied to a ResumeAnalysis — spec
// §4.13: logged separately so disparate impact can be audited later, but
// never joined into any candidate-facing query. This table is service-role
// read only by convention — no application code may select it from a
// request that renders to the candidate, even though Prisma doesn't enforce
// that automatically. Reuses the same EliteInstitution/PrestigeEmployer/
// HighDemandSignal admin-curated tables as the legacy six-category system's
// pedigree-bonus.ts, via new matching logic in resume-analysis/prestige.ts
// that rescales to this spec's 0-6/0-10 caps and applies recency decay
// (which the legacy bonus does not).
model PrestigeAudit {
  id               String         @id @default(cuid())
  resumeAnalysisId String         @unique
  resumeAnalysis   ResumeAnalysis @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)

  employerTierPoints    Int // pre-decay, pre-cap points from the matched PrestigeEmployer/scale-proxy
  institutionTierPoints Int // pre-decay, pre-cap points from the matched EliteInstitution
  recencyDecayApplied   Boolean
  totalAwarded          Int // post-decay, post-cap — matches ResumeAnalysis.prestigeBonus at write time

  createdAt DateTime @default(now())
}

// Per-parser-engine round-trip result for one ResumeAnalysis — a matrix,
// not a single score (Report Structure Spec §4.3/§4.5). parserKey values
// mirror the engine/platform list already known to the ncrawl ATS adapters
// (src/lib/market/ats-*.ts) — Textkernel, Daxtra, HireAbility, Affinda,
// RChilli, plus Workday/Taleo/BrassRing/iCIMS/SuccessFactors/Greenhouse/
// Lever/Ashby/Workable, which parse in-house and behave distinctly.
model AtsParseResult {
  id               String         @id @default(cuid())
  resumeAnalysisId String
  resumeAnalysis   ResumeAnalysis @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)

  parserKey       String
  parserLabel     String
  fieldsExpected  Int
  fieldsRecovered Int
  failures        Json // string[] — which fields/sections were lost, in plain language
  severity        String // "CLEAN" | "PARTIAL" | "FAILING"

  @@index([resumeAnalysisId])
}

// "What a reviewer will ask about" (spec §7) — same detections as a red-flag
// scan, opposite register: framed as interview prep, not a defect list.
// Recording candidateExplanation neutralizes the item — it stops affecting
// First Glance and drops off the report's detection list, but never
// retroactively changes a permanent penalty (reconciliationPenalty above is
// the only true penalty in this system, and explanations don't touch it).
model ReviewerQuestion {
  id               String           @id @default(cuid())
  candidateId      String
  candidate        CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resumeAnalysisId String?
  resumeAnalysis   ResumeAnalysis?  @relation(fields: [resumeAnalysisId], references: [id], onDelete: SetNull)

  // "UNEXPLAINED_RECENT_GAP" | "UNEXPLAINED_CURRENT_GAP" | "SHORT_TENURE_RECENT" |
  // "SHORT_TENURE_CLUSTER" | "SCOPE_DECREASE" | "THIN_RECENT_ENTRY" |
  // "EXTENDED_TENURE_NO_CHANGE" | "TITLE_INFLATION" | "OVERLAPPING_ROLES" |
  // "CREDENTIAL_NO_INSTITUTION" | "PORTFOLIO_CAREER" | "COMP_FIT_RISK" — spec §7 table
  detectionType   String
  detectedContext Json // e.g. { role, company, dateRange } — whatever the detection needs to render its copy

  candidateExplanation String?   @db.Text
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())

  // Guided Resume Walkthrough (Master Build Script §13.1) 3-way resolution —
  // "CORRECTED" | "NOT_APPLICABLE" | "LEAVE_AS_IS". Distinct from the older
  // free-text-only candidateExplanation path above (still used outside the
  // walkthrough): CORRECTED means the candidate told us the detection itself
  // was wrong and we wrote back a correction to the source WorkHistoryEntry/
  // EducationEntry (see src/lib/walkthrough/reviewer-correction.ts) — the
  // detection is gone for good. NOT_APPLICABLE is a permanent dismissal with
  // no data change. LEAVE_AS_IS means the detection is real and the
  // candidate chose not to act on it now; resolvedAt is still set (so this
  // exact row isn't re-asked), but the walkthrough's review-summary screen
  // lists LEAVE_AS_IS rows under "still open" rather than "fixed" or
  // "dismissed" so the candidate isn't told something is settled when it
  // isn't. Null for every row resolved via the older resolveReviewerDetection
  // path, which predates this distinction.
  resolutionType String?

  @@index([candidateId, resolvedAt])
}

// Autosave-and-resume state for the guided Resume Walkthrough (Master Build
// Script §13.1) — one row per candidate, same one-JSON-blob-plus-pointer
// idiom as Reference.draftAnswers/draftPage (src/app/ref/[token]/actions.ts
// saveReferenceDraft), not a new mechanism. A dedicated model rather than
// fields on the already-very-large CandidateProfile, since this state is
// genuinely session-scoped (start over, resume, eventually re-run against a
// new resume) rather than a durable profile fact.
//
// currentStep indexes into stepAnswers.screenPlan, a candidate-specific
// ordered list of screens computed once (on first session creation) and
// never recomputed in place — see src/lib/walkthrough/screen-plan.ts — so
// the step pointer stays valid even as findings/detections get resolved
// mid-walkthrough. stepAnswers also holds per-step progress (which
// mechanical findings were marked fixed/skipped, in-progress guided-bullet
// answers, which reviewer questions were resolved and how) — see
// src/lib/walkthrough/types.ts for the exact shape. completedAt is set once,
// the first time the candidate reaches the review-summary screen, and
// cleared (along with currentStep/stepAnswers) only by an explicit
// "start over" action, not by re-visiting the page.
model ResumeWalkthroughSession {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  currentStep Int  @default(0)
  stepAnswers Json @default("{}")

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

// One row per candidate — the current, live Market Reality Grade and its
// five components (Master Build Script §3.1 — the former four-component
// "Record/Evidence/Market/Channels" model split into five: Your Experience/
// Your Resume/Your Evidence/Your Effort/Your Market). Upserted on every
// recompute of any one component (recompute cadence is per-component, not
// synchronized — see Voice/Intake Spec §3.1): Experience/Resume only on
// resume upload; Evidence when a reference or assessment lands; Market
// weekly (smoothed against MarketDifficultySnapshot history below); Effort
// on outreach/application/interim-work/Sprint activity. The composite and
// band are recomputed and re-stored whenever any one component changes, so
// this row is always the single source of truth the report and dashboard
// render from — never recomputed ad hoc in more than one place. A null
// score means "not yet measured" (§3.6) — never zero, and never rendered
// as a low grade; computeMarketRealityCompositeGrade reweights over
// whichever scores are non-null.
model MarketRealityComponentScore {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  experienceScore Int? // 0-100 — from the latest ResumeAnalysis.experienceScore
  resumeScore     Int? // 0-100 — from the latest ResumeAnalysis.resumeScore
  evidenceScore   Int? // 0-100 — references + assessments (Dossier completeness)
  effortScore     Int? // 0-100 — outreach, applications, interim work, Sprint consistency
  marketScore     Int? // 0-100 — role scarcity for the stated target, smoothed weekly. Never weighted into the composite directly — applied as a one-band cap (§3.5)

  // 1-3 short, factual driver sentences per component (ComponentComputation.
  // drivers from src/lib/scoring/market-reality/{evidence,market,effort}.ts),
  // persisted in the same pass as the score they explain — Report Structure
  // Spec §6 rule 1: "Grade and prose render from one object in one pass.
  // They cannot drift." Experience/Resume have no stored driver text; their
  // headline sentences are derived on read from the latest ResumeAnalysis
  // row, which is itself already a fully-persisted single source of truth.
  evidenceDrivers Json?
  marketDrivers   Json?
  effortDrivers   Json?

  compositeScore Int?
  grade          String? // "A" | "B" | "C" | "D" | "F" — reuses the existing Grade scale (grade.ts)

  // Which component the headline names as the primary constraint, and
  // which it names as the strength — e.g. "Market Reality: C — moderate
  // difficulty. Your experience is an A; the constraint is that roles at
  // your level are scarce and your network is unused." Both recomputed
  // with the composite so the headline template never has to re-derive
  // them at render time. Market is never "strongest" (it's a cap, not a
  // competitor among the weighted four) but CAN be "driving" — when it's
  // the thing capping the grade, the headline must name it (§3.5/§3.7)
  // rather than blaming whichever weighted component happens to score
  // lowest.
  drivingComponent   String? // "EXPERIENCE" | "RESUME" | "EVIDENCE" | "EFFORT" | "MARKET"
  strongestComponent String?

  experienceComputedAt DateTime?
  resumeComputedAt     DateTime?
  evidenceComputedAt   DateTime?
  marketComputedAt     DateTime?
  effortComputedAt     DateTime?

  updatedAt DateTime @updatedAt
}

// Weekly time series of posting volume for a candidate's stated target
// (function + level + geography), the input to the Market component's
// trailing-baseline comparison (Voice/Intake Spec §3.2-3.3). Sourced from
// already-imported postings (JobPosting/ExclusiveJobPosting — fed by
// ncrawl, JSearch, Adzuna, and direct ATS feeds), not a new crawler.
// Deliberately separate from MarketConditionsSnapshot above, which upserts
// one row per query+location and overwrites on every fetch (a live cache,
// not a history) — this table is append-only so a trailing baseline
// actually exists to compare against.
model MarketDifficultySnapshot {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  targetRoleQuery String // normalized, same convention as MarketConditionsSnapshot.roleQuery
  location        String
  postingCount    Int
  weekOf          DateTime // Monday of the week this snapshot represents

  createdAt DateTime @default(now())

  @@unique([candidateId, weekOf])
  @@index([targetRoleQuery, location, weekOf])
}

// The 7 milestone badges from the Payoff Map spec (§7) — Cleaned Up,
// Connected, Asked, Backed, Known, Consistent, Documented. One-time,
// permanent, never re-earned — distinct from WeeklyBadgeEarned above
// (which is keyed per-week for streak-style badges) and LearningBadge
// (course/certification completions). Community unlocks on the first row
// any candidate earns here, regardless of which badge it is.
model MilestoneBadge {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  badgeKey String // "CLEANED_UP" | "CONNECTED" | "ASKED" | "BACKED" | "KNOWN" | "CONSISTENT" | "DOCUMENTED"
  earnedAt DateTime @default(now())

  @@unique([candidateId, badgeKey])
  @@index([candidateId])
}

// Job-fit feedback. Max 5 per candidate enforced in the server action, not
// here (MANUAL rows only — see source below). User-deletable (needed to
// swap one out once at the cap).
enum JobPostingSource {
  MANUAL // candidate pasted a URL/text — the only source that gets fit-checked
  EMAIL_DETECTED // auto-created from a Gmail APPLICATION_CONFIRMATION — no URL, no fit score
}

model JobPosting {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source JobPostingSource @default(MANUAL)

  url           String? // null for EMAIL_DETECTED rows — nothing to fetch/analyze
  fetchStatus   String // "pending" | "success" | "fetch_failed" | "parse_failed" | "no_url"
  fetchError    String?
  extractedText String?

  // Pulled from the same analyzeJobFit LLM pass that produces fitScore below
  // — no separate extraction call. Used to mirror this posting into the
  // shared ExclusiveJobPosting table (source: 'candidate_check') so it
  // counts toward the admin-side job database without ever being shown to
  // any other candidate.
  title       String?
  companyName String?
  location    String? // extracted by analyzeJobFit alongside title/companyName; null for EMAIL_DETECTED rows or postings never analyzed

  fitScore        Int? // 0-100
  fitFeedback     String[]  @default([]) // short, scannable bullets — no more than 5
  keywords        String[]  @default([]) // extracted from the posting, ATS/recruiter scan terms
  tailoredBullets Json? // [{ original: string, tailored: string }] — real work-history bullets reframed to the posting
  analyzedAt      DateTime?

  interviewLandedAt       DateTime?
  interviewPrep           Json? // { likelyQuestions: string[], talkingPoints: string[], questionsToAsk: string[] }
  interviewPrepError      String?
  interviewPrepAnalyzedAt DateTime?

  offerReceivedAt             DateTime?
  negotiationAdvice           Json? // { talkingPoints: string[], scriptOpening: string, considerations: string[] }
  negotiationAdviceError      String?
  negotiationAdviceAnalyzedAt DateTime?

  appliedAt              DateTime? // gates "I got an interview" — applying is a prerequisite, not just landing one
  channel                ApplicationChannel? // captured at the moment of marking applied; null on rows logged before this field existed
  declinedAt             DateTime? // rejection — set manually or auto via a detected REJECTION email for the same company
  declinedBy             DeclineParty? // who ended it — COMPANY ("they passed") or CANDIDATE ("I passed"); null on rows logged before this field existed
  backchannelEmailSentAt DateTime? // dedupes the one-off "you might know someone at this company" email to once per application
  coverLetter            String?             @db.Text
  coverLetterError       String?
  coverLetterGeneratedAt DateTime?

  interviewCompleteAt DateTime? // candidate marks the interview as done — gates the thank-you note generator
  thankYouNote        String?   @db.Text
  thankYouError       String?
  thankYouSentAt      DateTime?

  createdAt DateTime @default(now())

  // Contacts the candidate has manually flagged as able to help with this
  // specific application — e.g. someone to backchannel to, distinct from
  // the automatic company-name match in src/lib/network/backchannel.ts.
  helpfulContacts SupportNetworkContact[] @relation("JobPostingHelpfulContacts")

  @@index([candidateId, createdAt])
}

enum CommunityPostType {
  JOB
  PROJECT
  INTRO_OFFER
  SELF_INTRO // "introduce yourself" gate post — presence of one (not a boolean flag) unlocks the board
  UPDATE // default type for the message-only composer, post Community+Circle merge
  MILESTONE // system-generated on a real milestone badge (e.g. WEEKLY_SPRINT_TARGET_HIT) — see maybeCreateMilestonePost
  LIKED_CONTENT // system-generated on a candidate's first Like of a Videos and Webinars carousel item — see maybeCreateContentLikePost
  ADMIN_STORY // admin-authored, posted by the system CandidateProfile — see src/lib/community/admin-story.ts
}

// Master Build Script §14 — every post is classified into one of these
// categories (or none) before it's visible to anyone but its author. See
// src/lib/community/moderation.ts for the classifier and the category →
// status mapping.
enum CommunityModerationCategory {
  RECRUITMENT_FRAUD // advance-fee scams, fake recruiters, resume-fee schemes, MLM
  CRISIS_SELF_HARM // never removed — routed to human review, Support During Transition surfaced to the poster
  HARASSMENT_ABUSE // harassment, abuse, discriminatory language
  DOXXING_PII // auto-removed, poster notified
  DEFAMATION // unverified accusations against named individuals (employer criticism is not this)
  SPAM_PROMOTION // spam, off-topic promotion — auto-removed
  BAD_LEGAL_FINANCIAL_ADVICE // published with a standing note pointing to qualified professionals
}

// PENDING only exists transiently (or if classification itself fails — see
// moderation.ts's fail-closed comment); every post resolves to one of the
// other three before this transaction returns.
enum CommunityModerationStatus {
  PENDING
  PUBLISHED // visible in the feed to everyone
  HELD // classified, needs human review, invisible to everyone but the poster until a moderator acts
  REMOVED // auto-removed (doxxing/spam) or removed by a moderator — never visible in the feed
}

model CommunityPost {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  postType    CommunityPostType
  title       String?
  description String
  externalUrl String?

  // Snapshot of the poster's location/function/industry at post time, so
  // editing a profile later doesn't rewrite history. Reuses CandidateProfile's
  // existing free-text fields — no new taxonomy is introduced.
  postCity     String?
  postState    String?
  postFunction String?
  postIndustry String?

  // Same snapshot-at-post-time convention as the four fields above, for the
  // Community "peers like you" groups (src/lib/community/groups.ts) — arrays
  // for schools/companies since those are genuinely multi-valued per candidate.
  postIndustryBucket String?
  postMetroArea      String?
  postSchools        String[] @default([])
  postCompanies      String[] @default([])

  // Same snapshot-at-post-time convention — the poster's most recent
  // ResumeAnalysis.seniorityBand at post time (§14: "segment by seniority
  // band, function second" — see src/lib/community/groups.ts).
  postSeniorityBand String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  interests CommunityPostInterest[]
  reactions CommunityPostReaction[]

  // Candidate-controlled safety state, generalized from MessageThread's
  // identical PEER-thread report fields (Prompt 85) to cover feed posts too.
  // A report flags the post for the shared admin review surface below; it
  // does not itself hide the post.
  reportedAt            DateTime?
  reportedByCandidateId String?
  reportReason          String?

  // AI moderation pipeline (§14) — see src/lib/community/moderation.ts.
  // Classification runs synchronously before the post is ever visible to
  // anyone but its author, so a status of PUBLISHED here always means "the
  // classifier already ran and cleared it" (or crisis-flagged it for
  // priority human review without hiding it — see the enum comment).
  moderationStatus          CommunityModerationStatus    @default(PENDING)
  moderationCategory        CommunityModerationCategory?
  moderationConfidence      Float?
  moderationReasoning       String?
  moderatedAt               DateTime?
  moderationReviewedAt      DateTime?
  moderationReviewedByEmail String?

  @@index([postType, isActive, createdAt])
  @@index([postCity, postFunction, postIndustry])
  @@index([postMetroArea, postFunction, postIndustryBucket])
  @@index([postSeniorityBand, postFunction])
  @@index([moderationStatus, moderationCategory, createdAt])
}

// Anonymous (by default) support note sent from one candidate to another
// having a hard week, per The Circle's "small, human, real" support
// mechanism. fromCandidateId is kept for abuse moderation but never shown
// in the UI unless revealSender is true.
model EncouragementNote {
  id              String           @id @default(cuid())
  fromCandidateId String
  fromCandidate   CandidateProfile @relation("EncouragementSent", fields: [fromCandidateId], references: [id], onDelete: Cascade)
  toCandidateId   String
  toCandidate     CandidateProfile @relation("EncouragementReceived", fields: [toCandidateId], references: [id], onDelete: Cascade)

  message      String
  revealSender Boolean   @default(false)
  sentAt       DateTime  @default(now())
  readAt       DateTime?

  @@index([toCandidateId, readAt])
}

// Expressing interest never exposes the poster's email on the board —
// instead it notifies the poster with the interested candidate's contact
// info so they can follow up. Unique constraint prevents duplicate
// notifications from repeat clicks.
model CommunityPostInterest {
  id                    String           @id @default(cuid())
  postId                String
  post                  CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  interestedCandidateId String
  interestedCandidate   CandidateProfile @relation(fields: [interestedCandidateId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())

  @@unique([postId, interestedCandidateId])
}

// A single lightweight "cheer" reaction (toggle, not a picker — a 5+-option
// reaction bar would force a dropdown per design-principles.md). Per-post
// count is fine to show (not a cross-candidate site-wide aggregate); the
// unique constraint gives the same idempotent toggle behavior as
// CommunityPostInterest above.
model CommunityPostReaction {
  id          String           @id @default(cuid())
  postId      String
  post        CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([postId, candidateId])
}

enum CommunityType {
  CITY
  FUNCTION
  INDUSTRY
  EX_COMPANY
}

enum CommunityJoinSource {
  AUTO
  MANUAL
}

// City/Function/Industry communities mirror CandidateProfile's existing
// free-text fields (currentCity/primaryFunction/industryContext) — same
// snapshot-free-text convention CommunityPost already uses, no new
// taxonomy. EX_COMPANY communities are 1:1 with a LayoffCohort.
model Community {
  id             String        @id @default(cuid())
  type           CommunityType
  value          String
  label          String
  layoffCohortId String?       @unique
  layoffCohort   LayoffCohort? @relation(fields: [layoffCohortId], references: [id])
  createdAt      DateTime      @default(now())

  memberships CommunityMembership[]

  @@unique([type, value])
}

// notifiedAt null = a pending, not-yet-acknowledged auto-join to surface in
// the explicit "You've been added to: X, Y" banner (see
// getPendingAutoJoinNotices/acknowledgeAutoJoinNotice). leftAt set = the
// candidate left; syncAutoJoinedCommunities never re-creates a row for a
// dimension the candidate already has a row for, matched or left, so
// leaving is permanent even if the underlying profile field still matches.
model CommunityMembership {
  id          String              @id @default(cuid())
  communityId String
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  joinedVia   CommunityJoinSource
  joinedAt    DateTime            @default(now())
  notifiedAt  DateTime?
  leftAt      DateTime?

  @@unique([communityId, candidateId])
  @@index([candidateId, leftAt])
  @@index([candidateId, notifiedAt])
}

// Append-only — "regenerate" creates a new row rather than updating,
// matching the CandidateAssessmentResponse/Resume history pattern.
//
// Model/field names below are the "hireability" purge (Master Build Script
// §2.1/§18) applied via @@map/@map rather than a live DDL rename — the
// physical Postgres table (20 real candidate rows) keeps its original name
// and columns untouched, decision confirmed with the user rather than
// running a live ALTER TABLE. TypeScript code, the generated Prisma Client,
// and everything any human reads only ever sees the new names.
model MarketRealityReport {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  strengths        Json // [{title, detail}]
  weaknesses       Json // [{title, detail}]
  actionPlan       Json // [{day: 1-7, items: string[]}], length 7
  gapAnalysis      Json // {targetRole, gaps: [{area, why, remediation, remediationType}]}
  marketConditions Json? // {narrative: string[], adzunaCount, blsYoyChangePct, ...} | null when unavailable
  hillToClimb      Json? // {tone: 'very_positive'|'positive_with_work'|'significant_climb', narrative: string[]}
  // {summary: string|null, signalCount, minRequired} — What's My Pattern,
  // generated from SurfacedJob reactions + applied/reviewed JobPostings.
  // summary is null (locked state) when signalCount < minRequired.
  jobSearchPattern Json?

  // Snapshot of the dossier-competencies.ts breakdown at generation time,
  // same reasoning as the score snapshot above. Null on reports generated
  // before this field existed.
  dossierGradeAtGeneration Json? @map("hireabilityGradeAtGeneration")

  // {improvementNarrative: string[], whatToDoMore: string[]} — generated in
  // the same LLM call as everything else above (no added cost), grounded in
  // real report-over-report grade movement (MarketRealitySnapshot history)
  // and real data added since the prior report (new completed references,
  // resume update, assessment completion, applications, outreach). Null on
  // reports generated before this field existed, and on a candidate's
  // first-ever report there's nothing to compare against — the prompt frames
  // that case as a baseline rather than fabricating improvement.
  executiveSummary Json?

  // Report Structure Spec §3.3: "Show the rewrite, not just the
  // instruction." Up to 3 {before, after} bullet rewrites, generated in the
  // same LLM call as everything else above (no added cost line — an
  // extension of the existing call, not a new one) for the highest-point-
  // value ResumeAnalysis.dimensionFindings that quote a real weak bullet
  // verbatim. `before` is self-checked against the real quoted text at
  // render time (market-reality/resume-fixes.ts) — a rewrite whose
  // `before` doesn't match a real finding's quote is dropped rather than
  // shown, per the "every generated number/claim is self-checked" rule
  // (spec §6 rule 7). Null on reports generated before this field existed,
  // and whenever no ResumeAnalysis row exists yet for this candidate.
  resumeRewrites Json?

  emailSentAt DateTime?
  generatedAt DateTime  @default(now())

  @@index([candidateId, generatedAt])
  @@map("HireabilityReport")
}

// One row per candidate per week — the actions they committed to for that
// week, each with a self-rated 1-3 difficulty and completion tracking.
// completedAt (not just a boolean) lets the Sunday Night Report reason
// about front-loading/back-loading patterns across the week.
model WeeklySprint {
  id                String                   @id @default(cuid())
  candidateId       String
  candidate         CandidateProfile         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStartDate     DateTime // Monday 00:00 UTC of the committed week
  committedActions  Json // [{text, actionType?, difficulty: 1-3, completed, completedAt?}]
  autoAssigned      Boolean                  @default(false) // true if the Monday-midnight-PT cron committed this, not the candidate
  createdAt         DateTime                 @default(now())
  // How comfortable the candidate feels being publicly visible in their
  // search THIS week — reuses the onboarding enum rather than a new one.
  // Coaching/sentiment signal only (see getVisibilityComfortTrend) — never
  // a direct input to computeDossierCompetencies. The actual privacyTier state
  // is the grade input; this is how the candidate says they feel about it.
  visibilityComfort PublicDisclosureComfort?

  @@unique([candidateId, weekStartDate])
  @@index([candidateId, weekStartDate])
}

// Append-only weekly report, sent Sunday night — mirrors MarketRealityReport's
// snapshot-on-generation pattern (grade + A-list are both point-in-time and
// must not silently change if read later).
model SundayNightReport {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStartDate DateTime // the week this report is summarizing

  gradeSnapshot         Json // DossierCompetencies at generation time
  previousGradeSnapshot Json? // last week's snapshot, for the change indicator — null on Week 1

  lastWeekCommittedCount Int      @default(0)
  lastWeekCompletedCount Int      @default(0)
  lastWeekCompletedTexts String[] @default([])
  lastWeekSkippedTexts   String[] @default([])

  strengths    Json // [{title, detail}]
  weaknesses   Json // [{title, detail}]
  observations Json // {motivationReading, progressPatterns, dataInconsistency: string|null}
  straightTalk String

  suggestedActionPlan Json // [{text, actionType?, isAStandard, isStretch?}]

  onAList          Boolean  @default(false)
  aListMemberNames String[] @default([]) // "First L." for the whole cohort, shown to everyone
  aListCount       Int      @default(0)

  // Market Response Funnel — tracked separately from Search Action Grade, since
  // doing the work (execution) and the market actually responding (this) are
  // different things. See MarketResponseLog for the self-reported signals
  // aggregated into this snapshot, plus real JobPosting interview/offer data.
  marketResponse   Json? // { outreachSent, repliesReceived, conversations, referrals, interviews, offers, paidProjectLeads }
  strategicFlag    String? // null | "week4_review" | "week8_review" | "week13_full" | "triggered"
  straightTalkMode String  @default("tactical") // "tactical" | "strategic"

  emailSentAt DateTime?
  generatedAt DateTime  @default(now())

  @@index([candidateId, generatedAt])
}

// Append-only historical record of weekly badge earnings (see
// src/lib/badges/weekly-badges.ts for the WeeklyBadgeKey union, computed
// live and NOT otherwise persisted). Upserted from computeWeeklyBadges
// whenever it runs for the current week, so this fills in as candidates use
// the app rather than needing a dedicated cron. WEEKLY_SPRINT_TARGET_HIT
// rows here ARE the weekly Sprint Target record — this is the real,
// currently-written source of truth for "who hit the Sprint Target each
// week" admin needs, unlike the legacy SundayNightReport.onAList field
// above, which nothing in the codebase writes to anymore.
model WeeklyBadgeEarned {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  badgeKey      String // WeeklyBadgeKey, kept as String so this table doesn't churn on badge additions
  earnedAt      DateTime         @default(now())

  @@unique([candidateId, weekStartDate, badgeKey])
  @@index([weekStartDate])
}

// PART FOUR §18/§20 — "personal best" storage. One row per candidate per
// weekly-reset board (LIFETIME_ACTION_SCORE deliberately never gets a row
// here — it only ever grows, so its own current total already IS the best
// it's ever been; a separate "personal best" record for a monotonically
// increasing number would be redundant). bestValue is generically named
// (not bestPoints) since it holds points for ACTION_SCORE but plain counts
// for the other four (distinct recipients, applications, posts, reactions).
// Written by src/lib/leaderboard/personal-bests.ts as MAX(stored, this
// week's live total) every time that board is computed for this candidate —
// a write-through cache of the running max, not an append-only log of every
// week (those already exist as real source rows elsewhere). Safe under the
// anti-gaming "retroactive decrement" rule: every value compared in is
// already the output of a live, guard-applying query (see queries.ts), so a
// gamed number was never eligible to become the stored best in the first
// place.
model LeaderboardPersonalBest {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  board         LeaderboardBoard
  bestValue     Int
  weekStartDate DateTime // which week achieved this best, for "week of Aug 10" copy
  achievedAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([candidateId, board])
}

// Weekly, append-only Market Reality Grade + named-reasons snapshot.
// Regenerated once per week right after that week's Weekly Search Sprint
// locks (Monday 12:01pm PT, see auto-assign-sprint cron) so each snapshot
// reflects that week's actually-completed work rather than work still in
// progress. Never overwritten — permanent, growing archive per candidate,
// surfaced on the Stats page (trend graph + openable archive).
// Deliberately distinct from SundayNightReport — that's a pre-existing
// weekly email digest keyed to Sunday night with its own gradeSnapshot;
// this model exists specifically so named reasons have a stable home with
// lock-triggered timing, not to duplicate that report.
model MarketRealitySnapshot {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStartDate DateTime // Monday 00:00 UTC of the week this snapshot closes out

  grade        String // 'A'..'F', see scoreToGrade
  dimensions   Json // MarketRealityDimension[] as computed that week
  namedReasons Json // NamedReason[] — structured, individually-referenceable (see named-reasons.ts)

  generatedAt DateTime @default(now())

  @@unique([candidateId, weekStartDate])
  @@index([candidateId, generatedAt])
}

enum MarketResponseType {
  REPLY
  CONVERSATION
  REFERRAL
  PAID_PROJECT_LEAD
}

// Self-reported external market signals, logged as they happen through the
// week — aggregated into that week's SundayNightReport.marketResponse
// snapshot when the report generates. Interviews/offers aren't logged here;
// they're already tracked as real timestamps on JobPosting.
model MarketResponseLog {
  id          String             @id @default(cuid())
  candidateId String
  candidate   CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        MarketResponseType
  notes       String?
  loggedAt    DateTime           @default(now())

  @@index([candidateId, loggedAt])
}

// Shared cache across all candidates for the same (role, metro) pair —
// Adzuna's free tier is 1,000 calls/month for the whole app, so this is a
// hard requirement, not an optimization. 48h TTL enforced in application code.
model MarketConditionsSnapshot {
  id               String   @id @default(cuid())
  roleQuery        String // normalized lowercase query, e.g. "senior product manager"
  location         String // normalized "city, state" | state | "us"
  // Normalized lowercase target-industry term this row's ideal-count query
  // was scoped to; "" (default) means no industry known — a generic,
  // industry-unscoped row, same as every row before this field existed.
  // Part of the cache key because adzunaIdealCount is industry-specific:
  // two candidates with the same role/location but different target
  // industries need separate ideal counts, not a shared one.
  industry         String   @default("")
  adzunaCount      Int? // "broader" — title-only match count
  adzunaError      String?
  adzunaIdealCount Int? // "ideal" — title AND industry AND geo match count; null when industry or geo is unknown, not zero
  adzunaIdealError String?
  blsSocCode       String?
  blsAreaCode      String?
  blsYoyChangePct  Float?
  blsError         String?
  fetchedAt        DateTime @default(now())

  @@unique([roleQuery, location, industry])
  @@index([fetchedAt])
}

// One row per self-reported "I posted on LinkedIn today" click. One-per-
// calendar-day is enforced in the server action (findFirst on today's
// range), not a DB constraint — same trust level already extended to
// counting Community Board posts.
// Distinguishes a verified direct-API post from a self-reported "I posted
// this" click — both award the identical LINKEDIN_POST_IDEA point value (see
// action-effort.ts), this is provenance only, same shape as ContactSource.
enum LinkedInPostSource {
  SELF_REPORT
  DIRECT_POST
}

model LinkedInActivityLog {
  id          String             @id @default(cuid())
  candidateId String
  candidate   CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  loggedAt    DateTime           @default(now())
  source      LinkedInPostSource @default(SELF_REPORT)
  // PART FOUR §16 — Visibility board's "minimum post length" anti-gaming
  // guard. Only ever populated for DIRECT_POST rows (postToLinkedInAction in
  // marketing-plan/actions.ts has the real published text in hand at write
  // time); SELF_REPORT rows (markLinkedInActivity — "I posted today," no
  // compose UI, no text ever captured anywhere in this codebase) stay null
  // forever and are exempted from the length check at the query layer, same
  // trust-based treatment that self-report path already has everywhere
  // else. See src/lib/leaderboard/queries.ts's computeVisibilityBoard.
  textLength  Int?

  @@index([candidateId, loggedAt])
}

// Per-candidate LinkedIn OAuth connection for the direct "Post to LinkedIn"
// button (My Marketing Plan redesign) — mirrors CalendarConnection's shape.
// Gated entirely on LINKEDIN_CLIENT_ID/LINKEDIN_CLIENT_SECRET being set (see
// isLinkedInPostingConfigured in src/lib/linkedin/oauth.ts); neither exists
// in this environment yet, so this table has no real rows today. No
// refreshToken column — LinkedIn's standard "Share on LinkedIn" product
// issues a long-lived (~60 day) access token and does not grant refresh
// tokens without a separate approved product; a lapsed connection is simply
// reconnected via the OAuth flow again.
model LinkedInConnection {
  id             String           @id @default(cuid())
  candidateId    String           @unique
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  accessToken    String           @db.Text
  personUrn      String // LinkedIn member URN (urn:li:person:{sub} from /v2/userinfo), required to post as this member
  expiresAt      DateTime
  connectedAt    DateTime         @default(now())
  disconnectedAt DateTime?
}

// Append-only daily mood check-in log — one row per day per candidate
// (see recordMoodCheckIn in src/lib/daily/mood.ts, which upserts today's
// row rather than allowing duplicates).
model DailyCheckIn {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  mood        Mood
  checkedInAt DateTime         @default(now())

  @@index([candidateId, checkedInAt])
}

// One long-lived conversation per candidate with the NextChapter Coach.
model CoachConversation {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  messages    CoachMessage[]
}

model CoachMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// Homepage "Audiences" waitlist forms (Employers, Recruiters, Outplacement,
// Government & Workforce, Nonprofits & Academia). Payload shape varies per
// audience (different fields per tab), so it's stored as-is rather than
// spread across many nullable columns.
model WaitlistSignup {
  id        String   @id @default(cuid())
  audience  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([audience])
}

// Executive Coach (human coaching, $500/month) premium waitlist — kept
// separate from WaitlistSignup because entries can be tied back to a real
// candidateId (when signed in) and have their own typed fields for triage.
model CoachingWaitlist {
  id          String            @id @default(cuid())
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  email       String
  firstName   String?
  lastName    String?
  challenge   String? // what they want help with, free text
  source      String // where the CTA was clicked from, e.g. "dashboard_card", "market_reality_report", "coaching_page"
  createdAt   DateTime          @default(now())
}

// Candidate membership-plan (dtc_* PlanCatalogEntry tiers, see plan-catalog.ts)
// waitlist — same "kept separate from WaitlistSignup" reasoning as
// CoachingWaitlist: needs a real candidateId relation and a typed tier column
// for admin triage. No payment or access-control logic reads this model —
// it is purely an interest signal until real billing exists (see IDEAS.md).
model MembershipTierWaitlist {
  id          String            @id @default(cuid())
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  email       String
  firstName   String?
  lastName    String?
  tier        String // PlanCatalogEntry.planKey, e.g. "dtc_coaching_premium"
  source      String // where the CTA was clicked from, e.g. "membership_plans_page"
  createdAt   DateTime          @default(now())

  @@index([tier])
}

// Public /resources/* guide-download leads — kept separate from WaitlistSignup
// for the same reason CoachingWaitlist is: needs a real filterable column
// (guideSlug) and a synchronous transactional email on submit, which the
// generic waitlist route never does for anyone.
model ResumeSubmissionLead {
  id          String            @id @default(cuid())
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  fullName    String
  email       String
  targetRole  String?
  filePath    String?
  fileName    String?
  source      String // e.g. "homepage"
  createdAt   DateTime          @default(now())

  @@index([email])
}

model GuideLead {
  id          String            @id @default(cuid())
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  email       String
  firstName   String?
  guideSlug   String // matches Guide.slug in src/lib/constants/guides.ts
  source      String // e.g. "situational_layoff", "resources_index", "organic"
  createdAt   DateTime          @default(now())

  @@index([guideSlug])
  @@index([email])
}

enum BountyClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BountyPaymentMethod {
  VENMO
  PAYPAL
  ZELLE
}

// The $500 "got hired" bounty — a candidate self-reports landing a job and
// uploads offer-letter proof; an admin manually verifies and approves before
// any money is sent. No payment is issued by the app itself — "paidAt" only
// records that an admin sent it manually outside the system.
model BountyClaim {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyName    String
  roleTitle      String
  startDate      DateTime
  offerLetterUrl String // storage path in the private 'offer-letters' bucket, not a public URL
  paymentMethod  BountyPaymentMethod?
  paymentHandle  String?
  // Prompt 76 — mandatory, not skippable. This is a submission for admin
  // review, never an automatic payout, and the testimonial is part of what
  // gets reviewed — see submitBountyClaim's validation, not just this schema.
  testimonial    String               @db.Text

  status          BountyClaimStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  paidAt          DateTime?

  // Search Action Grade at the moment of submission — snapshotted for audit
  // purposes since the requirement (must be A to submit) is enforced at
  // submission time, and the candidate's grade can move afterward. Null on
  // claims submitted before this gate existed (grandfathered, not re-checked).
  gradeAtSubmission String?

  createdAt DateTime @default(now())

  @@index([status])
}

enum ScholarshipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A candidate facing real financial hardship can apply for reduced or free
// access to a membership tier by describing their circumstances in an open
// application. Always human-reviewed — mirrors BountyClaim exactly (same
// PENDING/APPROVED/REJECTED shape, same reviewedBy/reviewedAt fields). No
// code path anywhere sets status to APPROVED except an admin-invoked action;
// there is no keyword-matching or self-reported-severity auto-approval.
model ScholarshipApplication {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  tier  String // PlanCatalogEntry.planKey being requested, e.g. "dtc_coaching_premium"
  story String @db.Text // open-text description of circumstances — no structured "prove it" fields

  status       ScholarshipApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  decisionNote String? // shown to the candidate on rejection; optional on approval

  createdAt DateTime @default(now())

  @@index([status])
}

enum CandidateIdentityMatchSource {
  REFERENCE // Reference.refereeEmail matched this candidate's confirmed email
  COACH_INVITE // CoachClientInvite.invitedEmail matched — signed up organically, not via the invite link
  RECRUITER_LEAD // SourcedCandidate.email matched — same, organic signup rather than the invite link
  CONTACT // SupportNetworkContact.email/emails[] (someone else's outreach/LinkedIn import) matched
}

enum CandidateIdentityMatchStrength {
  EMAIL_EXACT
  PHONE_EXACT
  FUZZY_NAME_WORK_LOCATION // CONTACT only — name + company overlap with this candidate's own WorkHistoryEntry, no email/phone on file
}

enum CandidateIdentityMatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// A newly-registered candidate may already exist elsewhere in the system as
// a reference, a coach/recruiter invite lead, or someone else's outreach/
// LinkedIn contact — all of which are free-text records with no real link to
// a CandidateProfile until a human confirms it's the same person. Always
// admin-reviewed, exactly like BountyClaim/ScholarshipApplication — no code
// path here ever auto-confirms, regardless of match strength (explicit
// product decision: even an exact email match still requires a click,
// because the actual link operation touches another person's data, not just
// this candidate's own).
model CandidateIdentityMatch {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source         CandidateIdentityMatchSource
  sourceRecordId String // id of the Reference/CoachClientInvite/SourcedCandidate/SupportNetworkContact row
  strength       CandidateIdentityMatchStrength

  // Denormalized snapshot for admin display — the source record can change
  // (or even be deleted) after this flag is created; the review UI should
  // still show what matched at detection time.
  matchedName    String?
  matchedEmail   String?
  matchedCompany String?

  status     CandidateIdentityMatchStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([candidateId, source, sourceRecordId])
  @@index([status])
}

// Prompt 76 — one Gmail connection per candidate. GMAIL only for now (Outlook
// dropped from this pass). Testing-mode only: no candidate outside the
// internal testing allow-list can complete this connection until a real CASA
// security assessment is paid for — enforced in code (see gmail-oauth.ts),
// not just by Google's own OAuth test-user gate, as defense in depth.
// Tokens stored plaintext, matching this codebase's one existing precedent
// (GoogleInboxConnection) — flagged there as a gap, not fixed here either;
// revisit if this ever needs to hold up to a real security review.
enum EmailProvider {
  GMAIL
}

// The 9 admin-triggered "nudge" email choices on the candidate detail page —
// each maps to a status snapshot + rationale computed from real candidate
// data in src/lib/admin/nudge-content.ts, then rendered fully editable
// before send.
enum AdminNudgeType {
  WEEKLY_TARGET
  NETWORKING
  LEARNING
  INTERIM_JOB
  CONNECT_GMAIL
  UPDATE_PROFILE
  COMMUNITY
  RECRUITER_HELP
  UPDATE_PRIVACY
  DID_YOU_GET_AN_OFFER
}

// One row per admin-sent nudge email — the "email trail" shown on the
// candidate detail page. Distinct from TrackedEmailActivity (which mirrors
// the candidate's own Gmail activity) and DigestSend (an aggregate,
// no-recipient-identity log for the batch Weekly Market Digest).
model AdminEmailLog {
  id             String           @id @default(cuid())
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  nudgeType      AdminNudgeType
  subject        String
  body           String // final text actually sent, post-edit — kept for audit even if the underlying candidate data changes later
  recipientEmail String
  sentByEmail    String
  status         String // 'sent' | 'failed'
  errorMessage   String?
  sentAt         DateTime         @default(now())

  @@index([candidateId, sentAt])
}

model EmailConnection {
  id               String           @id @default(cuid())
  candidateId      String           @unique
  candidate        CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  provider         EmailProvider    @default(GMAIL)
  accessToken      String           @db.Text
  refreshToken     String           @db.Text
  expiresAt        DateTime
  connectedAt      DateTime         @default(now())
  lastSyncAt       DateTime?
  // Set when a token refresh fails (expected every ~7 days in Google's
  // testing-mode token lifetime) — surfaced as an explicit "reconnect your
  // Gmail" prompt, never a silent failure.
  needsReconnectAt DateTime?
  disconnectedAt   DateTime?
  // §4.6 — the connected Google account's own email address, fetched from
  // Google's userinfo endpoint during the OAuth callback (see
  // fetchGoogleAccountEmail in src/lib/email-tracking/gmail-oauth.ts). Never
  // captured before this: the scope previously requested carried no
  // identity claim at all. Used to hard-block a corporate-looking domain
  // while Confidential Search Mode is on (checked BEFORE this row is ever
  // created/updated — a blocked attempt writes nothing here).
  connectedEmail   String?

  activities TrackedEmailActivity[]
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

// Inbox: APPLICATION_CONFIRMATION, RECRUITER_OUTREACH, INTERVIEW_INVITE,
// REJECTION, OFFER. Sent: THANK_YOU, FOLLOW_UP, CHECK_IN, INTRO_REQUEST —
// four separate categories, never merged into one "outreach" bucket, each
// with its own point value (action-effort.ts). NEEDS_REVIEW is the deliberate
// "don't guess" bucket for low-confidence classifications.
enum EmailActivityType {
  APPLICATION_CONFIRMATION
  RECRUITER_OUTREACH
  INTERVIEW_INVITE
  REJECTION
  OFFER
  THANK_YOU
  FOLLOW_UP
  CHECK_IN
  INTRO_REQUEST
  NETWORKING_OUTREACH
  NEEDS_REVIEW
}

model TrackedEmailActivity {
  id                  String            @id @default(cuid())
  candidateId         String
  candidate           CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  connectionId        String
  connection          EmailConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalMessageId   String // Gmail message id — dedupe key alongside connectionId
  direction           EmailDirection
  activityType        EmailActivityType
  confidence          String // 'high' | 'low' — low lands in NEEDS_REVIEW regardless of a guessed type
  companyName         String?
  roleTitle           String?
  subject             String? // candidate's own review UI only — never exposed to anyone else
  fromAddress         String?
  hasResumeAttachment Boolean           @default(false) // matchResumeShared() — keyword + real attachment present
  isRecruiterContact  Boolean           @default(false) // matchRecruiterRoleMention() — subject/body role-title keywords, either direction
  detectedAt          DateTime          @default(now())
  reviewedAt          DateTime? // candidate confirmed/corrected a needs-review item
  dismissedAt         DateTime? // candidate marked this classification wrong — excluded from all stats/lists

  @@unique([connectionId, externalMessageId])
  @@index([candidateId, activityType])
}

// Prompt 79 — Calendar Connect. Same testing-mode posture as EmailConnection
// above (reuses the same tester allow-list, isGmailTrackingTester — one
// internal-testing cohort, not a separately configured list), and the same
// CANDIDATE_GOOGLE_OAUTH_CLIENT_ID/SECRET OAuth client as Gmail, just a
// different scope/redirect URI. Unlike gmail.metadata, calendar.readonly and
// calendar.events.readonly are Sensitive, not Restricted (confirmed against
// Google's own restricted-scopes list) — no CASA review needed here, only
// standard OAuth verification, so this is testing-mode only because the app
// itself isn't verified yet, not because of an ongoing paid security review.
model CalendarConnection {
  id               String           @id @default(cuid())
  candidateId      String           @unique
  candidate        CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  accessToken      String           @db.Text
  refreshToken     String           @db.Text
  expiresAt        DateTime
  connectedAt      DateTime         @default(now())
  lastSyncAt       DateTime?
  needsReconnectAt DateTime?
  disconnectedAt   DateTime?

  events TrackedCalendarEvent[]
}

// INTERVIEW: title matches interview/screen/onsite-shaped patterns.
// NETWORKING_CALL: title matches a 1:1-shaped catch-up/coffee-chat/intro-call
// pattern. NEEDS_REVIEW is the deliberate "don't guess" bucket, same
// convention as EmailActivityType — most calendar events (internal meetings,
// personal appointments) land here and are never shown as detected activity.
enum CalendarEventType {
  INTERVIEW
  NETWORKING_CALL
  LEARNING
  NOT_JOB_SEARCH
  NEEDS_REVIEW
}

model TrackedCalendarEvent {
  id                 String             @id @default(cuid())
  candidateId        String
  candidate          CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  connectionId       String
  connection         CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalEventId    String // Google Calendar event id — dedupe key alongside connectionId
  eventType          CalendarEventType
  confidence         String // 'high' | 'low' — low lands in NEEDS_REVIEW regardless of a guessed type
  title              String? // candidate's own review UI only — never exposed to anyone else
  durationMinutes    Int? // used for the Learning page's total-time stat
  isRecruiterContact Boolean            @default(false) // matchRecruiterRoleMention() — title/description role-title keywords
  startTime          DateTime
  detectedAt         DateTime           @default(now())
  reviewedAt         DateTime? // candidate confirmed/corrected a needs-review item
  dismissedAt        DateTime? // candidate marked this classification wrong — excluded from all stats/lists
  // The first non-self attendee with an email, from the raw Google Calendar
  // attendee list — lets "who did you meet with" surfaces (needs-follow-up
  // list) resolve an identity without a new join table. Null for events
  // with no attendee data (e.g. a solo blocked-off slot) or events synced
  // before this field existed.
  counterpartEmail   String?
  counterpartName    String?

  @@unique([connectionId, externalEventId])
  @@index([candidateId, eventType])
}

enum ContactEmploymentStatus {
  CURRENT
  FORMER
}

// One row per person in the candidate's 5x5 Support Network. category is
// nullable because CSV-imported contacts land unsorted — the candidate
// slots them into the 5 categories afterward.
model SupportNetworkContact {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name                      String
  company                   String?
  title                     String?
  // Primary email — always the first entry of `emails` below (or null if
  // that list is empty). Kept as its own column, unmodified in shape, so
  // every existing consumer (Message buttons, gmailComposeHref call sites,
  // admin outreach pages, CSV export, ...) keeps working untouched; `emails`
  // is purely additive on top of it.
  email                     String?
  // Up to 3 emails for this contact (soft cap enforced in application code,
  // not the DB). Lets a re-imported/re-added contact with a different email
  // than the one on file get merged into the existing row instead of
  // creating a duplicate (see doImportConnectionsCsv in
  // src/app/dashboard/network/actions.ts) — the new address is appended
  // here rather than silently dropped or overwriting `email`.
  emails                    String[]                   @default([])
  phone                     String?
  linkedinUrl               String?
  // Candidate-flagged "this person matters most" — independent of
  // relationshipTags, which capture *what* they are (recruiter, hiring
  // manager, ...), not whether the candidate has decided to prioritize them.
  isPriority                Boolean                    @default(false)
  // Set the first time this contact earns CONTACT_PRIORITIZED points (see
  // toggleContactPriority) — a durable per-contact "already paid" flag so
  // star/unstar/restar can't farm points, independent of isPriority's
  // current on/off state. Candidate-wide count of non-null rows here (capped
  // at 5) is the lifetime progress shown in the Action Plan box.
  priorityPointsAwardedAt   DateTime?
  category                  ContactCategory?
  warmth                    ContactWarmth              @default(WARM)
  source                    ContactSource              @default(MANUAL)
  createdAt                 DateTime                   @default(now())
  // Whether this contact still works at `company` — no reliable signal
  // exists to infer this (a LinkedIn export only ever captures a contact's
  // company as of export time, with no way to tell if it's since gone
  // stale), so this is candidate-confirmed only, set from the Company
  // page's "Still there?" / "They left" buttons. Null = unconfirmed.
  employmentStatusAtCompany ContactEmploymentStatus?
  // Set only via admin-confirmed CandidateIdentityMatch — this contact IS a
  // real NextChapter member in their own right. Nullable/fan-in: the same
  // real person can be a contact in many different candidates' lists, each
  // with its own row here, all pointing at the one real CandidateProfile.
  linkedCandidateId         String?
  linkedCandidate           CandidateProfile?          @relation("SupportNetworkContactLinkedCandidate", fields: [linkedCandidateId], references: [id], onDelete: SetNull)
  // Multi-select "who is this person" tags — see RelationshipTag's comment.
  relationshipTags          RelationshipTag[]          @default([])
  // Set when the candidate marks SAME_SCHOOL and names the school.
  schoolName                String?
  // Best-effort guesses from a non-consumer email domain (see
  // matchRecruiterRoleMention-adjacent logic in sync-google-calendar.ts) —
  // shown as a hint, never overwrites the candidate-confirmed `company`.
  inferredCompany           String?
  inferredSchool            String?
  // Lower-trimmed "name|company" dedup key, computed at write time by
  // normalizeContactKey() in src/lib/network/csv-import.ts. Stops
  // re-uploading the same LinkedIn export from creating duplicate rows
  // (via createMany's skipDuplicates against the unique index below) and
  // identifies genuinely-new contacts for the weekly NETWORKING_LIST Sprint
  // credit. Nullable so pre-migration rows are unaffected — Postgres treats
  // each NULL as distinct in a unique index, so legacy rows never collide.
  normalizedKey             String?
  // Soft-delete — set instead of a real delete so a later CSV re-import can
  // tell "this person was never imported" apart from "the candidate removed
  // this person on purpose" and skip resurrecting them. Filtered out of the
  // main directory list; surfaced on its own Removed Contacts page with a
  // restore action that just clears this field.
  removedAt                 DateTime?
  // The actual LinkedIn connection date ("Connected On" in their export) —
  // distinct from createdAt, which is when this row was imported into
  // NextChapter and could be months/years after the real connection date.
  // Only ever populated from a LinkedIn CSV upload; left null for
  // manually-added contacts rather than guessed at.
  connectedAt               DateTime?
  // NextChapter admin's own outreach tracking for recruiters/coaches/hiring
  // managers surfaced through candidates' networks — a business-development
  // lead list, entirely separate from the candidate's own relationship to
  // this person. Defaults NOT_REVIEWED for every contact, not just tagged
  // ones, so the admin list's "reviewed" count means something.
  adminOutreachStatus       ContactAdminOutreachStatus @default(NOT_REVIEWED)
  adminNotes                String?
  // The candidate's own free-text notes about this person — distinct from
  // adminNotes above, which is NextChapter's internal business-development
  // tracking and never candidate-visible.
  notes                     String?
  // Free-text tags a candidate adds themselves, alongside the closed
  // RelationshipTag set above (e.g. "mentor," "old boss," "met at a
  // conference") — RelationshipTag stays a fixed enum so admin tooling and
  // scoring logic keep a stable set of values to key off of; this is purely
  // for the candidate's own organization.
  customTags                String[]                   @default([])

  outreachLogs   OutreachLog[]
  // Jobs this contact has been manually flagged as able to help with
  // ("who can help me get this job") — separate from the automatic
  // company-name backchannel match, which is computed on the fly rather
  // than stored.
  helpfulForJobs JobPosting[]  @relation("JobPostingHelpfulContacts")

  @@unique([candidateId, normalizedKey])
  @@index([candidateId])
}

// Self-reported outreach — no automatic email-BCC-forwarding tracking yet
// (that needs inbound-email infrastructure that doesn't exist). The act of
// logging is itself the rewarded behavior, per the product spec.
model OutreachLog {
  id          String                 @id @default(cuid())
  candidateId String
  candidate   CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     SupportNetworkContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel     OutreachChannel
  loggedAt    DateTime               @default(now())

  @@index([candidateId, loggedAt])
}

// Append-only audit trail for CandidateProfile.confidentialSearchMode
// changes — spec Build Notes: "Log mode changes with timestamps. If
// something leaks, we need the state at the time." A single `updatedAt`
// column on CandidateProfile can't answer "was this candidate confidential
// on March 3rd," so this mirrors OutreachLog/MarketResponseLog's minimal
// candidate-scoped log-row convention instead of overloading a timestamp
// field. `enabled` is the mode's state *after* this change.
model ConfidentialModeChangeLog {
  id          String                       @id @default(cuid())
  candidateId String
  candidate   CandidateProfile             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  enabled     Boolean
  source      ConfidentialModeChangeSource
  changedAt   DateTime                     @default(now())

  @@index([candidateId, changedAt])
}

// A job pulled from Adzuna and shown to the candidate for a lightweight
// reaction — not an application queue. unique on (candidateId, url) so
// re-surfacing the same listing doesn't duplicate rows.
// "What They See" — candidate-generated, revocable links that show a
// sanitized slice of their profile to a specific recipient type. Distinct
// from PrivacyTier (which controls passive marketplace search visibility):
// this is a proactive, one-off share the candidate hands to one person.
model ProfileShare {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  token         String             @unique @default(cuid())
  recipientType ShareRecipientType
  label         String? // candidate's own note, e.g. "For Sarah at Acme"

  // Hiring Manager only — early-stage (false) shows a lighter view;
  // active-process (true) adds the resume + reference summaries.
  activeProcess Boolean  @default(false)
  // Recruiter only — opt-in extras: "RESUME" | "SALARY" | "REFERENCES"
  includeExtras String[] @default([])

  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  @@index([candidateId])
  @@index([token])
}

model SurfacedJob {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title       String
  companyName String?
  location    String?
  url         String
  description String?
  surfacedAt  DateTime @default(now())

  reaction       JobReactionType?
  reactionReason NotInterestedReason?
  reactedAt      DateTime?

  @@unique([candidateId, url])
  @@index([candidateId, surfacedAt])
}

// Admin-curated real job postings, visible only to candidates currently
// holding an A Search Action Grade (and opted into the recruiter database —
// same consent gate as Talent visibility, since this is another
// employer-facing surface). Distinct from JobPosting (a candidate's own
// private, capped-at-5 job-fit tracker) and SurfacedJob (algorithmic,
// per-candidate matches) — this is a single shared, admin-authored list.
// NC Job Board (Prompt 61) — started as a purely admin-curated "Exclusive
// Next Chapter Jobs" list (model name kept for continuity), now extended
// to accept employer/recruiter self-submissions and direct ATS feed rows.
// No employer/recruiter domain verification exists elsewhere in this
// codebase, so `status` is the trust gate: every non-admin row starts
// 'pending' and only becomes candidate-visible once a human admin
// approves it — see src/app/support/admin/exclusive-jobs/actions.ts.
model ExclusiveJobPosting {
  id          String    @id @default(cuid())
  title       String
  companyName String
  location    String?
  url         String    @unique // upsert key for the ncrawl bulk importer (see /api/admin/jobs/import) — every other write path (admin form, ATS feed cron) also produces one row per url, so this holds for all sources, not just imports
  description String?
  addedBy     String // admin email from requireAdmin(), or a pipeline name like 'ncrawl' for bulk-imported rows
  createdAt   DateTime  @default(now())
  archivedAt  DateTime? // soft-hide instead of delete, keeps admin history

  // Populated only by the ncrawl bulk importer (see /api/admin/jobs/import) —
  // every other write path leaves these null. Deliberately free-text rather
  // than Prisma enums since ncrawl's own taxonomy evolves independently of
  // this schema.
  level          String? // e.g. C_SUITE, EVP_SVP, VP, DIRECTOR — ncrawl's seniority classification
  sourceCategory String? // e.g. employer, search_firm, venture, pe, association — who runs the board this came from
  badges         String[] @default([]) // e.g. "PE-backed", "VC-backed", "Recruiter-led search" — the signals that differentiate this feed from a generic job board, surfaced on the listing

  // 'direct' | 'recruiter_search' — shown prominently on the listing itself,
  // per Prompt 61: this is a real trust differentiator, never buried.
  postingType String?

  // Required for every new submission (enforced in the action layer, not
  // the DB, since these fields are additive to existing rows). No ATS
  // public feed exposes a named contact, so ats_feed rows always have
  // contactName: null and are flagged for manual admin review.
  contactName  String?
  contactEmail String?

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String? @default("USD")

  // 'pending' | 'approved' | 'rejected'. Existing admin-added rows default
  // to 'approved' — they were already trusted before this field existed.
  status String @default("approved")

  // 'admin' | 'employer' | 'recruiter' | 'ats_feed' | 'candidate_check' |
  // 'candidate_referral'
  source String @default("admin")

  submittedByEmployerId  String?
  submittedByEmployer    EmployerProfile?  @relation(fields: [submittedByEmployerId], references: [id], onDelete: SetNull)
  submittedByRecruiterId String?
  submittedByRecruiter   Recruiter?        @relation(fields: [submittedByRecruiterId], references: [id], onDelete: SetNull)
  // Set for the two candidate-originated sources below — 'candidate_check'
  // (a private job-fit check, mirrored here only for admin-side market
  // visibility — see distribution note) or 'candidate_referral' (a lead a
  // candidate heard about through their own network, submitted for the
  // normal admin review queue like any other non-admin source).
  submittedByCandidateId String?
  submittedByCandidate   CandidateProfile? @relation(fields: [submittedByCandidateId], references: [id], onDelete: SetNull)

  rejectionReason String?

  // Freshness enforcement — the only way expiresAt moves forward is the
  // explicit reconfirmJobPosting action (genuine re-confirmation), never a
  // bare "bump" that resets the clock without it. A daily cron
  // (src/app/api/cron/expire-job-postings) archives anything past this.
  expiresAt       DateTime?
  lastConfirmedAt DateTime?

  // NC Job Board 2.0 — visibility model. Existing rows are backfilled to
  // audienceTier: 'A_LIST_ONLY' (see the db-push follow-up script) so
  // nothing already live becomes more exposed than it was; admin can
  // reclassify individual rows to 'ALL_CANDIDATES' afterward.
  //
  // 'ALL_CANDIDATES' | 'A_LIST_ONLY' — is a candidate even eligible to see
  // this at all, before Distribution is considered.
  audienceTier String @default("A_LIST_ONLY")
  // 'OPEN' | 'TARGETED' | 'EXCLUDED' — within the eligible audience, is
  // this shown to everyone or only fit-matched candidates, or never shown
  // in the browse feed at all (recruiter private-pipeline use).
  distribution String @default("OPEN")
  // 'OPEN' | 'CONFIDENTIAL' — is companyName shown to candidates. Only
  // ever set to 'CONFIDENTIAL' via the recruiter submission form; enforced
  // in the action layer, not the DB.
  disclosure   String @default("OPEN")

  // Targeting criteria, populated only when distribution = 'TARGETED'.
  // Denormalized rather than a RoleProfile FK — Recruiters and NC don't
  // own an EmployerProfile, so they can't share RoleProfile rows the way
  // the Match Inbox feature does.
  targetFunction     String?
  targetLevel        String?
  targetLocation     String?
  targetRemotePolicy String?

  introRequests JobBoardIntroRequest[]

  @@index([archivedAt, createdAt])
  @@index([status, archivedAt])
  @@index([audienceTier, distribution])
}

// The "Request intro" action on a confidential recruiter listing (Discover
// feed) used to only fire a PostHog event — nothing was persisted, so the
// recruiter never actually heard about it. This is that fix: a real,
// admin-visible row so the request lands in the Requests inbox instead of
// going nowhere.
model JobBoardIntroRequest {
  id           String              @id @default(cuid())
  candidateId  String
  candidate    CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postingId    String
  posting      ExclusiveJobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  contactEmail String?
  status       String              @default("pending") // 'pending' | 'contacted' | 'closed'
  createdAt    DateTime            @default(now())

  @@index([candidateId, createdAt])
  @@index([status])
}

// Click-through log for candidate-facing job links (SurfacedJob and
// ExclusiveJobPosting — the two algorithmic/curated discovery surfaces; the
// candidate's own JobPosting tracker is excluded since those URLs are
// candidate-pasted, not "clicked into" from a NextChapter listing). Rows are
// denormalized copies of title/company/location/fit at click time rather
// than FKs into three differently-shaped job models — this is what lets
// admin group by company/title with a plain Prisma groupBy instead of
// reconciling three tables. Written by recordJobClick() alongside the
// job_link_clicked PostHog event.
model JobClickEvent {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  source      String // 'surfaced' | 'job_board' — which discovery surface this click came from
  sourceId    String // SurfacedJob.id or ExclusiveJobPosting.id
  jobTitle    String
  companyName String?
  location    String?
  url         String
  fitBucket   String? // 'strong' | 'good' | 'stretch' at click time, see job-fit-bucket.ts

  @@index([candidateId, createdAt])
  @@index([companyName])
  @@index([jobTitle])
}

// Postgres mirror of every captureServerEvent() call, written from inside
// that single choke point (src/lib/posthog/server.ts) — lets admin query
// and segment server-side events without hitting PostHog's API. Client-side
// posthog.capture() call sites are not mirrored here (no single choke point
// for those yet); the admin action-counts view is labeled accordingly.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  distinctId String
  event      String
  properties Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([distinctId, createdAt])
}

model PivotIdea {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title               String
  description         String
  rationale           String
  salaryConsideration String?
  generatedAt         DateTime @default(now())

  rating       Int? // 1-4, 4 = "I really love it"
  ratingReason String?
  ratedAt      DateTime?

  @@index([candidateId, generatedAt])
}

// Coach P0-lite — intentionally thin: signup + a personal invite link + a
// simple client list. No session notes, directives, or full Client Full
// View here; those stay on the full Coach P0/P1 build's original schedule.
// Coaches aren't Supabase-authenticated users — accessToken-gated pages
// (same pattern as Reference.token) are enough for this MVP.
model Coach {
  id           String        @id @default(cuid())
  fullName     String
  workEmail    String        @unique
  firmName     String?
  focus        CoachingFocus
  accessToken  String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  isSampleData Boolean       @default(false)

  // Real Supabase-auth login, added on top of the original P0-lite
  // accessToken model — nullable because legacy/invite-only coach rows can
  // still exist token-only. Once set, /auth/login + /auth/forgot-password
  // work for this coach exactly like any other account (see
  // completeCoachSignupFromSession).
  userId String? @unique

  // Personal profile picture (distinct from the branding logoUrl below) —
  // shown in messaging and candidate-facing recognition surfaces.
  profilePictureUrl String?

  // Branding-only white-label (Batch 13) — same domain, no custom domains.
  // Applied to the coach's own settings/tools chrome and, when set, to a
  // client-facing surface later; Calendar/Meet booking and billing are
  // explicitly deferred, tracked as separate follow-ups.
  logoUrl     String?
  accentColor String? // hex, chosen from a small curated palette — not a free-form picker

  // Prompt 60 — this coach's standing question set for the candidate-
  // completed Coaching Onboarding Form, applied automatically to every new
  // client. Null = the NextChapter-provided baseline template applies as-is
  // (see BASELINE_ONBOARDING_QUESTIONS); once the coach saves any edit, this
  // holds their full resolved template (baseline toggles/order + customs).
  onboardingTemplate Json?

  // Weekly Market Digest opt-out — same convention as CandidateProfile's
  // marketDigestOptedOut, no other digest exists for coaches yet.
  marketDigestOptedOut Boolean @default(false)

  // Coach-Candidate Matching System, Phase 1 — structured self-description
  // used only for shortlist ranking (src/lib/coach/matching.ts), framed as
  // positive descriptors, never as a screening/exclusion tool.
  industries         String[] // industries this coach has actually coached in
  seniorityFit       String[] // levels this coach has worked with, e.g. "IC", "Director", "C-Suite"
  certifications     String[] // e.g. "ICF" — the standard credential across this industry
  specializationTags String[] // includes "comfort_with_high_need_candidates" as one option among several, never a lesser category
  // Hard-constraint fields for matching — gender is self-described, never
  // used to exclude unless a candidate expresses a preference (default: no
  // preference, never forced either direction).
  gender             String?
  languages          String[]
  timezone           String?

  // Surge-capacity bench, Master Build Script §A5.4 — admin flags a coach as
  // on-call/retainer for a sudden volume spike (e.g. a 200-person RIF).
  // Purely a flag the admin sets by hand; being on the bench doesn't change
  // this coach's normal matching/caseload behavior, it only makes them a
  // notification target when admin manually triggers surge outreach (see
  // src/lib/coach/surge.ts).
  isOnCallBench Boolean @default(false)

  clients                         CandidateProfile[]
  sessions                        CoachSession[]
  coachingOnboardingResponses     CoachingOnboardingResponse[]
  coachingConfidentialDisclosures CoachingConfidentialDisclosure[]
  clientInvites                   CoachClientInvite[]
  messageThreads                  MessageThread[]
  rateCardOverrides               CoachRateCard[]
  reassignmentRequestsFrom        CoachReassignmentRequest[]       @relation("ReassignmentFromCoach")
  reassignmentRequestsTo          CoachReassignmentRequest[]       @relation("ReassignmentToCoach")
}

// A coach inviting a SPECIFIC candidate by email, distinct from the generic
// shareable link (/support/coach/invite/[accessToken]) — the coach already
// knows and vouches for this email, so the account created from it skips
// the normal click-to-confirm step. coachId on the resulting CandidateProfile
// is set once, at profile-create time, same never-reassign invariant as the
// cookie-link path.
model CoachClientInvite {
  id           String    @id @default(cuid())
  coachId      String
  coach        Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  invitedEmail String
  invitedName  String?
  inviteToken  String    @unique @default(cuid())
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  candidateId  String?   @unique

  @@unique([coachId, invitedEmail])
  @@index([invitedEmail])
}

// A 1:1 coaching session. Batch 13 adds real notes (coach-private) and
// directives (client-facing action items) on top of the original P0-lite
// timestamp-only record — the Session Impact Report's before/after boundary
// math is unchanged, this just gives the session actual content.
model CoachSession {
  id                  String           @id @default(cuid())
  candidateId         String
  candidate           CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  coachId             String
  coach               Coach            @relation(fields: [coachId], references: [id])
  occurredAt          DateTime         @default(now())
  viewedByCandidateAt DateTime?
  durationMinutes     Int?
  notes               String?          @db.Text // coach-private, never shown to the candidate
  directives          String?          @db.Text // client-facing action items from this session
  // Coach-editable "focus for next session" — closes the loop between
  // sessions without needing calendar integration: surfaced at the top of
  // this candidate's *next* Pre-Session Brief, regardless of which coach
  // logs it (see getPreSessionBrief).
  focusNote           String?          @db.Text

  // Set when a coach marks this session's directives as followed through on
  // by the candidate — a real, discrete event, not a self-report, so it
  // feeds a rewrite-action baseline bump (see applyDirectiveResolvedRewrite).
  directivesResolvedAt       DateTime?
  directivesResolvedCategory String?

  // Phase 3, Partners Master Build Script section A2.5. sessionType picks
  // which CoachRateCard row applies; rateSnapshotCents is that rate LOCKED
  // IN at creation time (see logCoachSession), never a live join to
  // CoachRateCard, so a later rate-card change can never retroactively
  // change what a past session paid. Null rateSnapshotCents only occurs on
  // sessions logged before this field existed.
  sessionType       CoachSessionType @default(STANDARD)
  rateSnapshotCents Int?

  // Phase 4, Master Build Script §A5.1 — structured session tracking across
  // the seven fixed dimensions (Targeting, Motivation, Networking,
  // Application volume, Skills, Narrative, Interview practice). Modeled as
  // named typed columns directly on this row, one status/trend/note triad
  // per dimension — deliberately mirroring how Reference stores its BARS
  // dimensions (barsVelocity, barsArchitecture, etc: flat named columns per
  // fixed dimension, not a related child table), since the dimension set
  // here is equally fixed and small. This also makes "render a trend line"
  // a simple query across a candidate's recent CoachSession rows selecting
  // the same column, with no JSON parsing. See src/lib/coach/session-
  // dimensions.ts for the canonical dimension list/labels consumed by both
  // the logging form and every reader (pre-session brief, trend line,
  // intervention suggestions).
  dimTargetingStatus  SessionDimensionStatus?
  dimTargetingTrend   SessionDimensionTrend?
  dimTargetingNote    String?                 @db.Text
  dimMotivationStatus SessionDimensionStatus?
  dimMotivationTrend  SessionDimensionTrend?
  dimMotivationNote   String?                 @db.Text
  dimNetworkingStatus SessionDimensionStatus?
  dimNetworkingTrend  SessionDimensionTrend?
  dimNetworkingNote   String?                 @db.Text

  dimApplicationVolumeStatus SessionDimensionStatus?
  dimApplicationVolumeTrend  SessionDimensionTrend?
  dimApplicationVolumeNote   String?                 @db.Text
  dimSkillsStatus            SessionDimensionStatus?
  dimSkillsTrend             SessionDimensionTrend?
  dimSkillsNote              String?                 @db.Text
  dimNarrativeStatus         SessionDimensionStatus?
  dimNarrativeTrend          SessionDimensionTrend?
  dimNarrativeNote           String?                 @db.Text

  dimInterviewPracticeStatus SessionDimensionStatus?
  dimInterviewPracticeTrend  SessionDimensionTrend?
  dimInterviewPracticeNote   String?                 @db.Text

  // Post-session rating, §A5.4 quality control — candidate rates a logged
  // session once, 1-5, matching the same plain 1-5 scale Reference already
  // uses for overallRating (no separate star-rating table). Prompted from
  // SessionImpactCard the next time the candidate loads the dashboard after
  // this session; sessionRatingPromptEnabled (CoachingSettings) can turn the
  // prompt off product-wide without touching this column.
  candidateRating  Int?
  candidateRatedAt DateTime?

  @@index([candidateId, occurredAt])
}

enum CoachSessionType {
  STANDARD
  EXECUTIVE_BAND
  MOCK_INTERVIEW_90
  RESUME_REVIEW
  INTAKE
}

// §A5.1 status scale for a tracked session dimension — the same three-value
// on-track/at-risk/stalled shape used informally elsewhere in coaching
// copy (e.g. CoachCaseloadPage's "avoidance pattern flagged"), now a real
// enum so it can drive intervention-suggestion logic consistently.
enum SessionDimensionStatus {
  ON_TRACK
  AT_RISK
  STALLED
}

enum SessionDimensionTrend {
  IMPROVING
  STEADY
  DECLINING
}

// Coaching rate card, Partners Master Build Script section A2.5 / A5.3.
// "Coach pay rates are configuration, not code." Rows are versioned by
// effectiveDate and NEVER mutated once written -- a rate change inserts a
// new row with a later effectiveDate under the same sessionType, so this
// table is its own audit log (createdBy/createdAt on every version is the
// "every rate change is logged with actor and timestamp" requirement; no
// separate log table needed since nothing here is ever overwritten or
// deleted). coachId null = the default rate for that session type; coachId
// set = a per-coach override, checked first by getApplicableRate. See
// src/lib/admin/coaching-rate-card.ts.
model CoachRateCard {
  id            String           @id @default(cuid())
  sessionType   CoachSessionType
  rateCents     Int
  effectiveDate DateTime
  coachId       String?
  coach         Coach?           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  createdBy     String
  createdAt     DateTime         @default(now())

  @@index([sessionType, coachId, effectiveDate])
}

// §A5.4 "Coach-candidate mismatch" (one-tap reassignment, no blame, admin
// routes) AND "Coach departure mid-engagement" (handoff protocol using the
// §A5.1 structured notes) share one model — both are, mechanically, "this
// candidate needs a new coach, here's why, here's the record of where they
// left off." requestedBy distinguishes the no-blame mismatch flow (COACH or
// CANDIDATE, reason optional/soft) from an admin-initiated departure
// handoff (ADMIN, toCoachId usually chosen at creation time already).
// handoffSummary is generated once, at the moment the reassignment actually
// completes (see completeReassignment in src/lib/coach/reassignment.ts) —
// snapshotting the candidate's latest 7-dimension read (§A5.1) and recent
// session notes so the receiving coach has a real clean handoff artifact,
// not just a name.
model CoachReassignmentRequest {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  fromCoachId String?
  fromCoach   Coach?  @relation("ReassignmentFromCoach", fields: [fromCoachId], references: [id])
  toCoachId   String?
  toCoach     Coach?  @relation("ReassignmentToCoach", fields: [toCoachId], references: [id])

  requestedBy ReassignmentRequestedBy
  reason      String?                   @db.Text
  status      ReassignmentRequestStatus @default(PENDING)

  // Snapshot written at completion time — see the model comment above.
  handoffSummary Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String? // admin email/identifier that routed this request

  @@index([candidateId, status])
  @@index([status])
}

enum ReassignmentRequestedBy {
  COACH
  CANDIDATE
  ADMIN
}

enum ReassignmentRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  DECLINED
}

// §A5.4 surge capacity — a real, working manual trigger rather than
// automated detection (per this phase's scope note: full automated surge
// detection is bigger than one phase). Records every time admin actually
// triggers bench outreach, so "did we notify the bench, and who" has a real
// audit trail rather than living only in an email inbox. See
// src/lib/coach/surge.ts.
model SurgeOutreachEvent {
  id                 String   @id @default(cuid())
  triggeredBy        String // admin email/identifier
  triggeredAt        DateTime @default(now())
  newSignupsInWindow Int // real count that prompted/accompanied the trigger, for the audit record
  benchCoachCount    Int
  notifiedCoachIds   String[]
  note               String?  @db.Text
}

// Prompt 60 — candidate-completed, self-serve coaching kickoff form (goal-
// setting + working-relationship preferences). Requires coachDossierConsentedAt
// to already be set, since these answers also feed Coaching Notes. Deliberately
// NOT the same thing as a coach-completed sensitive-topics intake (a separate,
// not-yet-built feature) — this form must only ever carry non-sensitive,
// standard-coaching material; never merge the two.
model CoachingOnboardingResponse {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  coachId     String
  coach       Coach            @relation(fields: [coachId], references: [id])
  answers     Json // keyed by question id -> string | string[] | number
  submittedAt DateTime         @default(now())
}

// A short, optional, coach-only-visible disclosure form — separate from
// CoachingOnboardingResponse on purpose (see that model's comment forbidding
// sensitive-topics questions there). Candidate answers once per coaching
// relationship; the coach sees it in Coaching Notes/Pre-Session Brief only —
// never in the Dossier, a report, or anywhere a recruiter/employer/other
// candidate could see it.
model CoachingConfidentialDisclosure {
  id             String           @id @default(cuid())
  candidateId    String           @unique
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  coachId        String
  coach          Coach            @relation(fields: [coachId], references: [id])
  hasDisclosure  Boolean // did the candidate indicate there's something to share, before free text
  disclosureText String?          @db.Text
  submittedAt    DateTime         @default(now())
}

// Premium-coaching add-on scaffold (opt-in, purchased alongside Executive
// Coaching — see CoachingWaitlist). The actual Checkr API call is gated
// behind CHECKR_API_KEY (same pattern as RESEND_API_KEY) — this model and
// its consent flow work today; live report retrieval activates once that
// key is added. disclosureText/authorizationText snapshot the exact FCRA-
// required language shown at consent time, for audit purposes — required
// regardless of provider, not a NextChapter-specific choice.
model BackgroundCheckConsent {
  id                      String           @id @default(cuid())
  candidateId             String           @unique
  candidate               CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  disclosureText          String           @db.Text
  authorizationText       String           @db.Text
  disclosureAcceptedAt    DateTime
  authorizationAcceptedAt DateTime
  checkrCandidateId       String?
  checkrReportId          String?
  status                  String           @default("consent_recorded") // consent_recorded | invited | pending | complete | disputed
  requestedAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime         @default(now())
}

// Admin-curated pedigree/prestige signals (Batch: "is an A achievable"
// follow-up) — feeds computePedigreeBonus() in
// src/lib/scoring/pedigree-bonus.ts, applied additively to the Target Fit
// category baseline. Deliberately three separate small lists rather than
// one generic table, mirroring the existing curated-company-list pattern
// from the ATS integration — each has a distinct match target.
model EliteInstitution {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @unique // matched against EducationEntry.schoolNameNormalized
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model PrestigeEmployer {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @unique // matched against WorkHistoryEntry.companyName (normalized)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model HighDemandSignal {
  id        String                 @id @default(cuid())
  label     String // e.g. "Chief AI Officer", "AI/ML Leadership"
  category  PedigreeSignalCategory
  keywords  String[] // loose-match tokens against primaryFunction/targetRoleType/resumeLatestJobTitle
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
}

// Recruiter P0-lite — the smallest possible entry point for the Instant
// Search Calibration Memo tool. Deliberately mirrors Coach P0-lite's shape:
// accessToken-gated, not Supabase-authenticated, no candidate database or
// search management (that's the full Recruiter P0/P1 build, out of scope
// here).
model Recruiter {
  id           String   @id @default(cuid())
  fullName     String
  workEmail    String   @unique
  firmName     String?
  specialty    String? // primary function/level covered, free text
  accessToken  String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  isSampleData Boolean  @default(false)

  // Real Supabase-auth login, added on top of the original P0-lite
  // accessToken model — nullable for the same reason as Coach.userId above.
  userId String? @unique

  profilePictureUrl String?

  marketDigestOptedOut       Boolean @default(false)
  // Separate opt-out from marketDigestOptedOut above — "a new A-grade
  // candidate is available" alerts are a distinct email type a recruiter
  // might want even if they don't want the periodic market digest (or vice
  // versa).
  newCandidateAlertsOptedOut Boolean @default(false)

  // Phase 3, Partners Master Build Script section A6.4 -- optional link to
  // firm-level admin config (onboarding/verification/status/seats/scope).
  // Nullable so every existing Recruiter row (individual login, free-text
  // firmName, no firm entity today) is unaffected until admin links it.
  recruiterFirmId String?
  recruiterFirm   RecruiterFirm? @relation(fields: [recruiterFirmId], references: [id])

  jobBoardSubmissions     ExclusiveJobPosting[]
  calibrationMemos        CalibrationMemo[]
  sourcedCandidates       SourcedCandidate[]
  sourcedProfiles         CandidateProfile[]
  messageThreads          MessageThread[]
  portfolioAccessRequests PortfolioAccessRequest[]
  candidateIntroductions  RecruiterCandidateIntroduction[]
  candidateSubmissions    RecruiterCandidateSubmission[]
  placements              RecruiterPlacement[]
}

enum SourcedCandidateStatus {
  ADDED
  INVITED
  SIGNED_UP
  ALREADY_HAD_ACCOUNT
}

// A recruiter's private book of candidates from their own network who
// aren't NC users yet — distinct from the searchable candidate pool
// (existing registered candidates a recruiter can already browse). Once
// invited and signed up, the person becomes an ordinary candidate (full
// onboarding, joins the general pool); this row just keeps the recruiter's
// own tracking + records the sourcing relationship via
// CandidateProfile.sourcingRecruiterId.
model SourcedCandidate {
  id               String                 @id @default(cuid())
  recruiterId      String
  recruiter        Recruiter              @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name             String
  email            String
  notes            String?                @db.Text
  status           SourcedCandidateStatus @default(ADDED)
  inviteToken      String?                @unique
  invitedAt        DateTime?
  candidateId      String?                @unique
  candidate        CandidateProfile?      @relation(fields: [candidateId], references: [id])
  // Recruiter's notes tied specifically to the candidate's resume (once
  // signed up) — distinct from `notes` above, which is general free-text
  // added when the candidate was first sourced.
  resumeCommentary String?                @db.Text
  // Curated into the recruiter's submittable "book" to present to employers.
  inBook           Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([recruiterId, email])
  @@index([recruiterId, status])
}

enum PortfolioAccessStatus {
  REQUESTED
  APPROVED
  DECLINED
}

// A recruiter viewing an unlocked (opted-in, A-grade) pool candidate can see
// their Dossier and resume directly, but Work Samples/Narrative ("My
// Portfolio") are a step more personal, so they're gated behind an explicit
// per-recruiter request the candidate approves or declines — same shape as
// ApprovedEmployer/CandidateInteraction's reveal gate, just scoped to
// portfolio content instead of identity. A DECLINED row can be
// re-requested (status flips back to REQUESTED); APPROVED never expires.
model PortfolioAccessRequest {
  id          String                @id @default(cuid())
  candidateId String
  candidate   CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   Recruiter             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  status      PortfolioAccessStatus @default(REQUESTED)
  requestedAt DateTime              @default(now())
  respondedAt DateTime?

  @@unique([candidateId, recruiterId])
  @@index([candidateId, status])
}

// Persists what used to be a stateless one-shot Calibration Memo generation
// (src/app/recruiters/calibrate/[token]/actions.ts) so a recruiter can look
// back at past briefs/memos instead of losing them the moment they navigate
// away.
model CalibrationMemo {
  id          String    @id @default(cuid())
  recruiterId String
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  briefText   String
  memoText    String
  createdAt   DateTime  @default(now())

  @@index([recruiterId])
}

// Admin-authored dashboard message rotation. One message is always pinned
// (isPinned — the "How NextChapter works" orientation content) and shown
// first to every candidate until they dismiss it; after that, whichever
// active, non-pinned message they haven't dismissed yet is shown next.
// No scheduling/targeting here by design — that's more than the current
// need (a simple rotating admin-authored feed) calls for.
// Sitewide 3-box page header system — replaces the old DashboardMessage
// (global-only, one message for the whole app). PageContent is scoped per
// page (pageKey) and per box type, with admin-manageable video/scheduling.
// See src/lib/dashboard/page-content.ts.
enum PageBoxType {
  DAILY_MESSAGE
  WHY_IT_MATTERS
  ACTION_PLAN
}

// One row per weekday, each mapped to a specific candidate email sender —
// admin-editable content/timing/eligibility for the weekly email cadence.
// See src/lib/email/dispatch/ for the sender each key maps to.
enum CandidateEmailKey {
  MORNING_MOTIVATION // Mon — send-weekly-goal-assigned.ts
  MARKET_UPDATE // Tue — send-market-digest-candidate.ts
  DAILY_NUDGE // Wed — generic branch of send-daily-action-email.ts
  MIDWEEK_CHECKIN // Thu — send-midweek-checkin.ts
  GAP_NUDGE // Fri — send-weekly-gap-nudge.ts
  COMMUNITY_DIGEST // Sat — send-community-coaching-digest.ts
  FINISH_LINE // Sun — send-finish-line-email.ts
}

enum VideoProvider {
  NC_HOSTED
  YOUTUBE
  OTHER // Instagram/TikTok/etc — link-out card unless useInlineEmbed is set
}

model PageContent {
  id      String      @id @default(cuid())
  pageKey String // e.g. "network", "dashboard" — see PAGE_KEYS constant
  boxType PageBoxType
  title   String
  leadIn  String? // one-sentence "why it matters" framing (WHY_IT_MATTERS only)
  bullets String[] // reminders (DAILY_MESSAGE) or pro-tips (WHY_IT_MATTERS)
  footer  String?

  videoProvider  VideoProvider?
  videoUrl       String?
  // YouTube/NC-hosted always render inline; for OTHER this is admin-chosen
  // per entry — off by default (safe link-out card), on if the admin pastes
  // a URL that's itself already embeddable (e.g. an Instagram post's own
  // /embed URL) and wants it to render inline instead.
  useInlineEmbed Boolean        @default(false)

  isActive      Boolean @default(true)
  // DAILY_MESSAGE only — a pinned message always wins over rotation, same
  // semantics as the old DashboardMessage.isPinned.
  isPinned      Boolean @default(false)
  // Non-pinned DAILY_MESSAGE rows with this set rotate in ascending order
  // before any row without one (which falls back to createdAt ordering).
  sequenceOrder Int?

  // Scheduling — hidden outside this window if set.
  publishAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey, boxType, isActive])
}

// Dismissal is keyed on (candidateId, pageKey, boxType) rather than a
// specific PageContent row, so admin can rotate/update content without
// silently resetting a candidate's dismissal. DAILY_MESSAGE dismissals are
// treated as expired once dismissedAt is before today (see
// getPageBoxContent) — the row is upserted with a fresh timestamp each time
// it's re-dismissed, exactly like the old CandidateMessageDismissal.
// WHY_IT_MATTERS dismissals are permanent until the candidate explicitly
// re-enables (deletes this row) from /dashboard/privacy.
model PageBoxDismissal {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  pageKey     String
  boxType     PageBoxType
  dismissedAt DateTime         @default(now())

  @@unique([candidateId, pageKey, boxType])
}

// One admin-editable row per day of week, driving both content (title,
// description, static intro copy prepended above the sender's own dynamic/
// LLM/computed body) and timing (sendHourUtc) for that day's candidate email.
// dayOfWeek/emailKey are fixed at seed time (0=Sun..6=Sat) — the admin console
// only edits copy, timing, active state, and privacy-tier eligibility, never
// which sender a weekday points to.
model CandidateEmailSchedule {
  id                   String            @id @default(cuid())
  dayOfWeek            Int               @unique // 0=Sun..6=Sat
  emailKey             CandidateEmailKey @unique
  title                String
  description          String? // admin-only note explaining the email's purpose; never sent
  introCopy            String? // static framing text threaded above the dynamic/computed body — same role as PageContent.leadIn
  sendHourUtc          Int               @default(13)
  isActive             Boolean           @default(true)
  // Empty = no restriction (all tiers eligible). Non-empty = only candidates
  // whose privacyTier is in this list receive this email.
  eligiblePrivacyTiers PrivacyTier[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Idempotency guard for the candidate-email-dispatch cron — the unique
// constraint IS the mechanism (attempt insert before sending, treat a
// unique-violation as "already sent, skip"), replacing the 5 inconsistent
// ad hoc "already sent" checks the old per-email crons each had.
model CandidateEmailSendLog {
  id          String            @id @default(cuid())
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  emailKey    CandidateEmailKey
  sentForDate DateTime          @db.Date // calendar day this send counts against, not a timestamp
  sentAt      DateTime          @default(now())

  @@unique([candidateId, emailKey, sentForDate])
}

// Admin-managed AI Training catalog — replaces the static
// AI_TRAINING_COURSES constant (src/lib/constants/ai-training-tiers.ts) so
// an admin can edit/add/retire courses without a code deploy. skillLevel
// replaces the old foundational/practical/technical tier naming with
// plain beginner/intermediate/advanced, aligned to CandidateProfile.
// aiFlexibilityLevel the same way the old tiers were (see defaultSkillLevel
// in src/lib/learning/courses.ts) — a candidate with low AI-skill
// confidence defaults to Beginner content, etc. Other Learning-page
// sections (certifications, business skills, function training, speaking)
// stay on the static-constants system for now — this only covers AI
// Training, deliberately scoped down from a full catalog migration.
enum CourseSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Mirrors the Learning page's former static-constants collections
// (src/lib/constants/{business-skills-learning,certifications-by-function,
// function-training,speaking-leadership}.ts, now deleted) — each category
// keeps that file's original gating shape via the fields below rather than
// forcing every collection into one generic shape:
//   AI_TRAINING       — gated by skillLevel vs. CandidateProfile.aiFlexibilityLevel
//   BUSINESS_SKILLS   — requiresManagementSignal splits general vs. leadership;
//                       excludeIfHasMBA hides a row from MBA holders
//   CERTIFICATION     — targetFunctions gates by PRIMARY_FUNCTION_OPTIONS
//   FUNCTION_TRAINING — keywords gates by substring match against the
//                       candidate's resolved content function
//   SPEAKING          — requiresManagementSignal splits general vs. gated
// Exec-ed-by-school (school-alias-keyed, one item per school) and AI tools
// (a distinct name/description/url shape with no provider/free/skillLevel)
// are deliberately NOT part of this model — different enough shapes that
// folding them in would force awkward blank fields on every other category.
enum CourseCategory {
  AI_TRAINING
  BUSINESS_SKILLS
  CERTIFICATION
  FUNCTION_TRAINING
  SPEAKING
}

model Course {
  id          String           @id @default(cuid())
  category    CourseCategory   @default(AI_TRAINING)
  title       String
  description String
  url         String
  logoUrl     String?
  sponsor     String? // issuing institution (Wharton, Google, IBM...) shown above the title
  provider    String           @default("coursera") // hosting platform slug — keys into LEARNING_PROVIDERS
  skillLevel  CourseSkillLevel
  free        Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int?

  // CERTIFICATION only — PRIMARY_FUNCTION_OPTIONS values this cert applies to.
  targetFunctions          String[] @default([])
  // FUNCTION_TRAINING only — matched as a case-insensitive substring against
  // the candidate's resolved content function (see resolveContentFunction).
  keywords                 String[] @default([])
  // BUSINESS_SKILLS / SPEAKING only — true means this row only shows once
  // hasManagementSignal is true (see build-learning-plan.ts).
  requiresManagementSignal Boolean  @default(false)
  // BUSINESS_SKILLS only — true hides this row from candidates with hasMBA set.
  excludeIfHasMBA          Boolean  @default(false)
  // Any category — optional admin tagging against CandidateProfile.industryContext
  // (case-insensitive substring match), surfaced in the Learning page's "For
  // your industry" section. Empty by default; starts empty until an admin
  // tags content, which is expected, not a bug.
  industries               String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillLevel, isActive])
  @@index([category, isActive])
  // getActiveCourses() (src/lib/learning/courses.ts) filters on isActive
  // alone with no category/skillLevel predicate — neither composite index
  // above has isActive leading, so this is the one that actually backs it.
  @@index([isActive])
}

enum AlumniGroupMatchType {
  EMPLOYER
  SCHOOL
}

// Network page "Alumni & Employer Networks" carousel — admin-curated, same
// shape as Course above (no reliable public API exists for "does this
// employer/school have an alumni group and what's its real URL," so this is
// hand-maintained rather than ingested). Matched against a candidate's own
// WorkHistoryEntry.companyName (EMPLOYER rows) or
// EducationEntry.schoolNameNormalized (SCHOOL rows) — see
// getMatchedAlumniGroups() in src/lib/network/alumni-groups.ts.
model AlumniNetworkGroup {
  id          String               @id @default(cuid())
  name        String // "Xoogler", "HKS Alumni Network"
  matchType   AlumniGroupMatchType
  // Case-insensitive substring match, checked BOTH directions against the
  // candidate's company/school text (handles "Google" matching "Google LLC"
  // and "Alphabet Inc (Google)" alike) — see matchesKeyword() in
  // alumni-groups.ts.
  keywords    String[]             @default([])
  url         String
  logoUrl     String?
  description String? // short line shown on the card, e.g. "Google's alumni community"
  isActive    Boolean              @default(true)
  sortOrder   Int?

  addedByAdminId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([matchType, isActive])
}

// Account-Based Job Search watchlist (Prompt 77) — a candidate names a
// specific target company and gets notified when a new posting from it
// shows up. Deliberately no new sourcing here: notifications are computed
// by matching companyNameNormalized against postings already flowing
// through the NC Job Board / ATS feed (ExclusiveJobPosting.companyName is
// a bare denormalized string, so matching goes through the same
// normalizeOrgName() convention used for resume-derived company dedup).
model CompanyWatchlistEntry {
  id                    String           @id @default(cuid())
  candidateId           String
  candidate             CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyName           String // as typed by the candidate
  companyNameNormalized String
  createdAt             DateTime         @default(now())
  // Postings created after this timestamp count as "new" for this entry's
  // notification badge — bumped to now() whenever the candidate visits the
  // Company Tracker page, same "visit resets the counter" convention as
  // communityLastViewedAt.
  lastViewedAt          DateTime         @default(now())

  @@unique([candidateId, companyNameNormalized])
  @@index([companyNameNormalized])
}

// Sitewide counter for metered third-party APIs — currently just JSearch's
// free 200-calls/month tier. One row per (service, calendar month); once
// count reaches the cap, that service is skipped for the rest of the month
// rather than erroring or silently paying for overage.
model ApiUsageCounter {
  id      String @id @default(cuid())
  service String
  period  String // "YYYY-MM"
  count   Int    @default(0)

  @@unique([service, period])
}

// The five triage buckets every ingested URL gets auto-classified into —
// see ResearchLibraryItem below.
enum ResearchBucket {
  GUIDE_SEO
  MARKET_BRIEF
  PRODUCT_POSITIONING
  PR_MEDIA_HOOK
  PERSONA_RESEARCH
}

// Admin-only Research Library: every external article/URL ingested (via the
// company research@ inbox or manual paste), fetched, AI-summarized, and
// classified. Permanent, growing — rows are never deleted, only moved
// through `status`.
model ResearchLibraryItem {
  id              String   @id @default(cuid())
  url             String
  dateFound       DateTime @default(now())
  // 'inbox' | 'manual'
  ingestionSource String

  title          String?
  fetchedContent String? @db.Text
  fetchFailed    Boolean @default(false)

  summary         String?         @db.Text
  bucket          ResearchBucket?
  confidenceScore Float?
  // Low-confidence classifications land here instead of being auto-filed —
  // surfaced separately in the admin triage view rather than silently
  // buried in their guessed bucket.
  needsReview     Boolean         @default(false)
  // 'recognized' | 'unknown' — source credibility, always surfaced, never hidden.
  credibilityTier String?

  suggestedAction           String? @db.Text
  // PERSONA_RESEARCH items that appear to contradict an existing locked
  // product decision get flagged prominently and separately, never folded
  // quietly into a routine digest entry.
  contradictsLockedDecision Boolean @default(false)
  // EmploymentSituation enum value, set only when bucket = PERSONA_RESEARCH —
  // reuses the existing persona-adjacent taxonomy rather than a new one.
  personaTag                String?

  // MARKET_BRIEF items an admin has queued into the next Weekly Market
  // Digest send (see the Digest Composer).
  queuedForDigest Boolean @default(false)

  // 'new' | 'reviewed' | 'actioned' | 'dismissed'
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([bucket, status])
  @@index([needsReview])
  @@index([queuedForDigest])
}

// One company-owned Gmail inbox (research@...), connected via OAuth by an
// admin — reads Google Alert emails only, never a candidate's personal
// account, so this carries none of the CASA/sensitive-scope weight of a
// third-party personal-account integration. Most-recent row wins if
// reconnected; not a hard singleton constraint.
model GoogleInboxConnection {
  id               String    @id @default(cuid())
  email            String
  accessToken      String    @db.Text
  refreshToken     String    @db.Text
  expiresAt        DateTime
  connectedByEmail String
  connectedAt      DateTime  @default(now())
  lastSweepAt      DateTime?
}

// One row per Weekly Market Digest send run (aggregate, not per-recipient —
// recipient PII doesn't belong in a permanent admin-visible history table).
// Written by each audience's cron once per run.
model DigestSend {
  id             String   @id @default(cuid())
  audience       String // 'candidate' | 'coach' | 'recruiter' | 'employer'
  sentAt         DateTime @default(now())
  recipientCount Int
  itemIds        String[] // ResearchLibraryItem ids included in this send, for audit

  @@index([audience, sentAt])
}

enum ThreadPartnerType {
  COACH
  RECRUITER
  EMPLOYER
  // Prompt 85 — candidate-to-candidate community DM, distinct risk profile
  // from the other three (see MessageThread's peerCandidateA/BId comment).
  PEER
}

enum MessageSenderRole {
  CANDIDATE
  COACH
  RECRUITER
  EMPLOYER
}

// One thread per (candidate, partner) relationship, not subject-based —
// matches CoachConversation's existing "one durable channel per
// relationship" precedent. A candidate can have up to one coach-thread, one
// recruiter-thread, and one employer-thread simultaneously (Postgres treats
// NULL as distinct per-row in unique constraints, so the three @@unique
// clauses below don't collide on each other's null columns).
model MessageThread {
  id          String            @id @default(cuid())
  // Null only for PEER threads, which have two candidates and no single
  // "owning" side — see peerCandidateA/BId below instead.
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  partnerType ThreadPartnerType

  coachId     String?
  coach       Coach?           @relation(fields: [coachId], references: [id])
  recruiterId String?
  recruiter   Recruiter?       @relation(fields: [recruiterId], references: [id])
  employerId  String?
  employer    EmployerProfile? @relation(fields: [employerId], references: [id])

  // PEER threads only — always stored with the lexicographically-smaller
  // candidateId first (see getOrCreatePeerThread) so a thread between two
  // candidates can never be created twice regardless of who messages first.
  peerCandidateAId       String?
  peerCandidateA         CandidateProfile? @relation("PeerThreadA", fields: [peerCandidateAId], references: [id], onDelete: Cascade)
  peerCandidateBId       String?
  peerCandidateB         CandidateProfile? @relation("PeerThreadB", fields: [peerCandidateBId], references: [id], onDelete: Cascade)
  // Who sent the first message in a PEER thread — the unsolicited-first-
  // contact rate limit counts threads by initiator, not by participant, so
  // replying to someone else's DM never counts against your own limit.
  initiatedByCandidateId String?

  // Candidate-controlled safety state (PEER threads only, Prompt 85) — a
  // report flags the conversation for the narrow admin review surface
  // below; it does not itself stop messages (use CandidateBlock for that).
  reportedAt            DateTime?
  reportedByCandidateId String?
  reportReason          String?

  createdAt           DateTime @default(now())
  lastMessageAt       DateTime @default(now())
  candidateLastReadAt DateTime @default(now())
  partnerLastReadAt   DateTime @default(now())

  messages Message[]

  @@unique([candidateId, coachId])
  @@unique([candidateId, recruiterId])
  @@unique([candidateId, employerId])
  @@unique([peerCandidateAId, peerCandidateBId])
  @@index([candidateId])
  @@index([peerCandidateAId])
  @@index([peerCandidateBId])
}

model Message {
  id                String            @id @default(cuid())
  threadId          String
  thread            MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole        MessageSenderRole
  // Which of the two candidates sent this — only set (and only needed) on
  // PEER threads, where senderRole is CANDIDATE on both sides and can't by
  // itself say who. Null for every other thread type, where senderRole
  // already disambiguates.
  senderCandidateId String?
  body              String            @db.Text
  createdAt         DateTime          @default(now())

  // Optional — a candidate sender can attach one of their own resume
  // versions (see MessageComposer's resumeOptions prop, only ever passed
  // on candidate-facing PEER-thread composers, never coach/recruiter/
  // employer). SetNull, not Cascade — deleting a resume version doesn't
  // delete the message history referencing it.
  attachedResumeId String?
  attachedResume   Resume? @relation(fields: [attachedResumeId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

// Candidate-controlled, immediate, no approval needed (Prompt 85). A block
// is directional but enforced both ways at the messaging layer (see
// assertPeerNotBlocked) — if either side has ever blocked the other,
// neither can send, though only the blocker's own action can lift it.
model CandidateBlock {
  id                 String           @id @default(cuid())
  blockerCandidateId String
  blocker            CandidateProfile @relation("BlockerCandidate", fields: [blockerCandidateId], references: [id], onDelete: Cascade)
  blockedCandidateId String
  blocked            CandidateProfile @relation("BlockedCandidate", fields: [blockedCandidateId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([blockerCandidateId, blockedCandidateId])
  @@index([blockedCandidateId])
}

// Prompt 86 — live webinar scheduling. hostLabel is free text ("Coach Jane
// Smith" / "NextChapter Team") rather than an FK to Coach — admin creates
// every webinar (no per-coach OAuth flow, see AdminGoogleCalendarConnection
// below), so attribution is descriptive, not a real relation.
model Webinar {
  id              String    @id @default(cuid())
  title           String
  description     String?
  hostLabel       String
  scheduledAt     DateTime
  durationMinutes Int       @default(45)
  // Populated once AdminGoogleCalendarConnection successfully creates the
  // underlying Calendar event — null until then, so the admin UI can show
  // "not yet scheduled on Google Calendar" distinctly from a real failure.
  meetLink        String?
  googleEventId   String?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?

  registrations WebinarRegistration[]
}

model WebinarRegistration {
  id             String           @id @default(cuid())
  webinarId      String
  webinar        Webinar          @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  registeredAt   DateTime         @default(now())
  reminderSentAt DateTime?

  @@unique([webinarId, candidateId])
  @@index([candidateId])
}

// "Videos and Webinars" candidate page — YouTube long-form + Shorts carousel
// content, auto-pulled via src/lib/content/youtube-ingest.ts (gated on
// YOUTUBE_API_KEY being configured) and/or added directly by an admin.
// Distinct from PageContent.videoProvider/videoUrl (a single embed inside
// arbitrary admin-authored page content elsewhere in the site) — this is a
// searched/curated LIST rendered as its own carousel, not a single embed.
enum VideoFormat {
  LONG_FORM
  SHORT
}

enum VideoContentSource {
  AUTO_PULLED
  ADMIN_ADDED
}

// GENERAL is the existing Videos/Shorts carousel pool; AI_TOOLS is the
// "Tools for You" carousel — AI-tool explainer content, tagged by industry
// (aiToolIndustry) for personalization. LINKEDIN_TIPS is the "LinkedIn
// Posting Tips" carousel on the Marketing Plan page — not personalized,
// same catalog for everyone. Same underlying table/ingestion pipeline as
// GENERAL, just different search passes — see youtube-ingest.ts's
// refreshAiToolVideos()/refreshLinkedInTipsVideos().
enum VideoCategory {
  GENERAL
  AI_TOOLS
  LINKEDIN_TIPS
  // Encouragement/perspective videos shown on the dashboard's Check In card
  // carousel — never shown alongside the low-sentiment help-advice block
  // (see MoodCheckInCard), since that's the one moment a candidate should
  // see focused support content, not a content carousel.
  MOTIVATIONAL
}

model CuratedVideo {
  id              String             @id @default(cuid())
  youtubeVideoId  String             @unique
  title           String
  description     String?            @db.Text
  thumbnailUrl    String
  channelTitle    String
  publishedAt     DateTime
  durationSeconds Int
  format          VideoFormat
  source          VideoContentSource
  category        VideoCategory      @default(GENERAL)
  // Only set when category = AI_TOOLS — one of INDUSTRY_BUCKET_NAMES
  // (src/lib/constants/industry-buckets.ts), or null for a
  // general/cross-industry AI-tools video. Personalized "Tools for You"
  // shows industry- and/or function-matched rows; a video tagged neither
  // populates the separate "AI Tips & Tools" section instead (see
  // curated-content.ts) — no longer a silent fallback for an unmatched
  // industry.
  aiToolIndustry  String?
  // Only set when category = AI_TOOLS — one of PRIMARY_FUNCTION_OPTIONS
  // (src/lib/constants/onboarding.ts), or null. A video can be tagged by
  // industry, by function, or (rarely) neither — never both dimensions at
  // once in practice, since AI_TOOL_TOPICS entries are written one-or-the-
  // other. "Tools for You" matches against a candidate's industry AND
  // function signals, so either dimension matching is enough to surface a
  // video — see getCarouselVideos.
  aiToolFunction  String?
  // Only set when category = AI_TOOLS — a short human label of what AI
  // capability the video actually covers (e.g. "AI video & content
  // creation"), set from AI_TOOL_TOPICS at ingest time. Shown on the
  // candidate-facing card as part of "why this was recommended," alongside
  // the industry/function match.
  aiToolFocus     String?
  // Only set when category = GENERAL — same shape as aiToolIndustry/
  // aiToolFunction above but for the "Career and Interview Advice"/"Tips"
  // carousels, which previously had zero personalization tagging. Either
  // dimension matching is enough to surface a video (see getCarouselVideos'
  // GENERAL-matching pass) — a video tagged with neither this nor
  // videoSkill below stays in the untagged general-advice pool.
  videoIndustry   String?
  videoFunction   String?
  // Only set when category = GENERAL — a short free-text skill label (e.g.
  // "Salary Negotiation", "Behavioral Interviewing") matched case-
  // insensitively against the candidate's skillsToBuild and low-comfort
  // signals (negotiationComfort/interviewComfort). Admin-set at
  // ingest/curation time, same role aiToolFocus plays for AI_TOOLS videos.
  videoSkill      String?
  addedByAdminId  String?
  // Admin soft-delete. refreshYouTubeVideos() must never resurrect a video
  // that has this set on a later ingest run (see youtube-ingest.ts).
  removedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([format, removedAt])
  @@index([category, removedAt])
}

// Podcasts carousel — admin-curated only, no auto-pull (no podcast-search
// API is wired up). All three platform links are optional since not every
// episode has all three.
model Podcast {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  thumbnailUrl String?
  appleUrl     String?
  spotifyUrl   String?
  youtubeUrl   String?
  publishedAt  DateTime
  removedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([removedAt])
}

enum ContentLikeType {
  // Shorts share this type too, distinguished by CuratedVideo.format, not a
  // separate like-type.
  CURATED_VIDEO
  WEBINAR
  PODCAST
}

// One Like posts to the Support Network feed on the FIRST like only (see
// maybeCreateContentLikePost in src/lib/content/content-likes.ts, which
// bypasses SUBMITTABLE_POST_TYPES the same way maybeCreateMilestonePost
// does). The unique constraint makes a second click on an already-liked item
// an unlike (row deleted) rather than a duplicate feed post.
model ContentLike {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contentType ContentLikeType
  contentId   String
  likedAt     DateTime         @default(now())

  @@unique([candidateId, contentType, contentId])
  @@index([contentType, contentId])
}

// One-directional "not interested" signal — no undo UI (matches the user's
// own casual phrasing for this ask; keep it simple). Disliking something
// deletes any existing ContentLike for the same item (mutual exclusivity,
// see toggleContentLike/dislikeContentAction), and once disliked an item is
// excluded from that candidate's future carousel queries
// (getCarouselVideos/getCarouselPodcasts). channelTitle is denormalized
// (only ever populated for CURATED_VIDEO) so the "2 dislikes from the same
// author blocks the whole author" rule (see getCarouselVideos) can query it
// directly without a join back to CuratedVideo.
model ContentDislike {
  id           String           @id @default(cuid())
  candidateId  String
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contentType  ContentLikeType
  contentId    String
  channelTitle String?
  dislikedAt   DateTime         @default(now())

  @@unique([candidateId, contentType, contentId])
  @@index([candidateId, contentType])
}

// Logged on every "open the video/podcast player" click (see
// logContentClickAction, fired fire-and-forget from CuratedVideoCard.tsx /
// PodcastCard.tsx alongside opening VideoPlayerModal). Feeds the admin Stats
// tab's per-item click counts — write-mostly, so no unique constraint here
// (every click is its own row, unlike Like/Dislike which toggle a single row
// per candidate+item).
model ContentClick {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contentType ContentLikeType
  contentId   String
  clickedAt   DateTime         @default(now())

  @@index([contentType, contentId])
}

// Singleton — a single NextChapter-owned Google Calendar connection admin
// uses to create webinar events with an auto-generated Meet link, distinct
// from CalendarConnection (candidate-owned, read-only, Prompt 79) and from
// src/lib/google/oauth.ts's research-inbox client. Only ever one row.
model AdminGoogleCalendarConnection {
  id               String   @id @default(cuid())
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  connectedByEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Prompt 65 — "Give a Reference." An employer/manager leaves a reference
// for someone they just let go, before that person has a NextChapter
// account. This is intentionally NOT a Reference row with a nullable
// candidateId — Reference.candidateId is required everywhere downstream
// (Dossier, Coaching Notes, reference-delta scoring all assume a real
// candidate relation), so relaxing it would mean auditing every one of
// those call sites for a new "might be unclaimed" case. Instead this is a
// fully separate holding model: nothing here is a Reference (the only
// thing Dossier/Coaching Notes/etc. actually query), so the consent
// guarantee in the prompt — "nothing becomes visible, attached to a real
// candidate profile, or usable ANYWHERE until the invited person
// explicitly accepts" — holds by construction, not by a filter someone
// could forget. Accepting (claimEmployerReferenceSubmission) is the one
// moment this becomes a real Reference row, at that point owned by the
// claiming candidate like any other reference.
model EmployerReferenceSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Submitting employer/manager. No real company-email-domain verification
  // exists anywhere in the app yet (confirmed against job-board-submission.ts,
  // which documents the same gap and uses a named-contact requirement as its
  // trust gate instead) — same trust gate reused here rather than building a
  // second, parallel verification system.
  submitterName    String
  submitterTitle   String?
  submitterCompany String
  submitterEmail   String

  // Departing employee — minimal by design (Prompt 65 section 3): just
  // enough to send the invite, nothing else collected at this stage.
  employeeName  String
  employeeEmail String

  // Reference content — the exact same fields/instrument as Reference
  // (Prompt 48's mirrored-trait framework: relationship/context, BARS
  // dimensions, five character traits with one-example-each, open-ended
  // "superpower"/story questions, would-work-again). Duplicated as columns
  // here rather than relaxing Reference itself — see model comment above.
  relationshipType    ReferenceType
  yearsWorkedTogether Int?

  overallRating     Int?
  wouldHireAgain    Boolean?
  strengthSummary   String?  @db.Text
  growthAreaSummary String?  @db.Text
  contextNotes      String?  @db.Text

  barsVelocity          Int?
  barsArchitecture      Int?
  barsStructure         Int?
  barsCommunication     Int?
  barsEnvironment       Int?
  barsLeadership        Int?
  barsOversight         Int?
  barsCommitment        Int?
  barsConscientiousness Int?

  traitAdaptabilityRating   Int?
  traitAdaptabilityExample  String? @db.Text
  traitFollowThroughRating  Int?
  traitFollowThroughExample String? @db.Text
  traitPresenceRating       Int?
  traitPresenceExample      String? @db.Text
  traitCollaborationRating  Int?
  traitCollaborationExample String? @db.Text
  traitComposureRating      Int?
  traitComposureExample     String? @db.Text

  superpowerText           String? @db.Text
  underPressureStory       String? @db.Text
  definingStory            String? @db.Text
  wouldWorkWithAgainReason String? @db.Text

  quotableWithAttribution Boolean?

  // The soft, optional layoff-context question (section 5) — a single
  // "yes" here has to produce BOTH the immediate founder notification AND
  // the Attio outplacement-pipeline record, not one or the other.
  isLayoffContext      Boolean   @default(false)
  founderNotifiedAt    DateTime? // set once sendLayoffContextAlertEmail succeeds
  // No live Attio API integration exists in this app yet (no client, no
  // credentials configured) — attioSyncRequestedAt marks "this needs to
  // sync to the outplacement pipeline" so a real sync can run the moment
  // Attio credentials exist, without losing which submissions are waiting.
  // See IDEAS.md.
  attioSyncRequestedAt DateTime?
  attioSyncedAt        DateTime?

  // Claim state (Prompt 65 section 1's consent gate). Status stays
  // 'pending' until the invited person explicitly acts — 'claimed' only
  // after they accept (which also creates the real Reference row via
  // createdReferenceId), 'declined' if they choose not to.
  status               String            @default("pending")
  inviteToken          String            @unique @default(cuid())
  invitedAt            DateTime?
  claimedByCandidateId String?
  claimedByCandidate   CandidateProfile? @relation(fields: [claimedByCandidateId], references: [id], onDelete: SetNull)
  claimedAt            DateTime?
  declinedAt           DateTime?
  createdReferenceId   String?

  @@index([employeeEmail])
  @@index([inviteToken])
  @@index([status])
}

// Prompt 68 — Interim Work page. Fractional/talent-marketplace, expert-
// network, and board/advisory listings for sections 2-4, stored as
// editable data rather than hardcoded into the page — several of these
// are pending direct partner outreach, so the designation has to be
// updatable from the admin portal without a code deploy each time a
// partnership status changes. See src/app/support/admin/interim-listings.
enum InterimListingCategory {
  MARKETPLACE_TECHNICAL // AI/technical background — Mercor, Toptal
  MARKETPLACE_GENERAL // strategy/ops/finance — Catalant, Business Talent Group
  MARKETPLACE_MARKETING // MarketerHire
  MARKETPLACE_STARTUP // startup-stage operator — Bolster
  MARKETPLACE_ANY_FUNCTION // Fractional Jobs — shown regardless of function
  EXPERT_NETWORK // GLG, AlphaSights, Guidepoint, Third Bridge
  BOARD_ADVISORY // NACD, BoardProspects, Athena Alliance, theBoardlist — seniority-gated
  NONPROFIT_BOARD // shown instead of BOARD_ADVISORY below the seniority gate
}

enum InterimListingDesignation {
  PARTNER // a confirmed revenue arrangement actually exists
  INCLUDED_FOR_QUALITY // no revenue claim — included because it's a real, relevant option
}

// A listing whose own platform is explicitly positioned around a specific
// audience (Athena Alliance, theBoardlist — both marketed as communities for
// women executives), separate from InterimListingDesignation (which is about
// NextChapter's own relationship to the platform, not who it's for).
// Deliberately NOT gated on CandidateProfile.eeocGenderIdentity — that field
// carries a hard guardrail (see its schema comment) barring it from every
// candidate-facing feature for discrimination-liability reasons. This is
// gated on the separate, feature-scoped boardDiversityListingsOptIn opt-in
// below instead, which exists only to answer "do you want these shown."
enum InterimListingAudienceFocus {
  GENERAL
  WOMEN_FOCUSED
}

model InterimListing {
  id              String                      @id @default(cuid())
  category        InterimListingCategory
  name            String
  description     String
  url             String
  // Admin-pasted logo image URL — shown in the carousel view on
  // /dashboard/interim-work (marketplaces/expert networks). Optional: a
  // listing with no logo yet falls back to an initial-letter badge rather
  // than blocking on every partner having a hosted logo image up front.
  logoUrl         String?
  designation     InterimListingDesignation   @default(INCLUDED_FOR_QUALITY)
  audienceFocus   InterimListingAudienceFocus @default(GENERAL)
  // Free-text nuance on the designation, e.g. Toptal's client-referral
  // (not talent-referral) program — shown alongside the badge so the
  // distinction isn't silently lost.
  designationNote String?                     @db.Text
  isActive        Boolean                     @default(true)
  sortOrder       Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  signups InterimMarketplaceSignup[]

  @@index([category, isActive, sortOrder])
}

// One row per (candidate, listing) "I created a profile on X" self-report
// — persisted (not just this week's Sprint JSON) so the checkbox reflects
// a durable checked state and the points-eligible action only logs once
// per listing per candidate, ever.
enum InterimSignupSource {
  SELF_REPORTED // candidate clicked "I created a profile"
  GMAIL_DETECTED // found via a real confirmation/welcome email from the listing's own domain in a connected inbox — see sync-gmail.ts's interim-listing-domain block
}

model InterimMarketplaceSignup {
  id          String              @id @default(cuid())
  candidateId String
  candidate   CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  listingId   String
  listing     InterimListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source      InterimSignupSource @default(SELF_REPORTED)
  createdAt   DateTime            @default(now())

  @@unique([candidateId, listingId])
}

// Prompt 69 — optional EEOC self-ID enums. Kept separate per question
// rather than one shared enum, since the option sets don't overlap.
enum EeocGenderIdentity {
  WOMAN
  MAN
  NON_BINARY
  SELF_DESCRIBE
  PREFER_NOT_TO_ANSWER
}

enum EeocRaceEthnicity {
  AMERICAN_INDIAN_ALASKA_NATIVE
  ASIAN
  BLACK_AFRICAN_AMERICAN
  HISPANIC_LATINO
  MIDDLE_EASTERN_NORTH_AFRICAN
  NATIVE_HAWAIIAN_PACIFIC_ISLANDER
  WHITE
  TWO_OR_MORE_RACES
  PREFER_NOT_TO_ANSWER
}

enum EeocYesNoDecline {
  YES
  NO
  PREFER_NOT_TO_ANSWER
}

// Prompt 70 — observability retrofit. One row per (candidate, partner,
// day) — the unique constraint on dayKey is what makes "once per
// candidate per partner per day" a real cap instead of a UI-only
// suggestion; a second click same-day is a normal PostHog-tracked event
// but does not insert a new row or award points again.
model PartnerClickThrough {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  partnerName String
  section     String // 'interim_work' | 'job_board_recommendations'
  dayKey      String // 'YYYY-MM-DD' UTC
  createdAt   DateTime         @default(now())

  @@unique([candidateId, partnerName, dayKey])
}

// Manually-added Gmail/Calendar tester emails that aren't (yet) tied to a
// CandidateProfile — e.g. an admin's own test inbox. Real candidates get
// toggled via CandidateProfile.gmailTrackingTesterEnabled instead; this
// table is the "add by email" escape hatch, managed from
// /support/admin/tracking-testers.
model TrackingTesterAllowlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String? // admin auth email, for audit purposes
  createdAt DateTime @default(now())
}

// ── ADMIN ANALYTICS (Phase 2 Master Script, Part B) ─────────────────────────
// Three additive tables: the resume-issue analytics spine, precomputed
// weekly population snapshots, and an admin individual-record access log.
// None of these has a Postgres RLS policy — this schema doesn't use RLS
// anywhere for admin-only data (see PrestigeAudit above, the one existing
// precedent: "This table is service-role read only by convention — no
// application code may select it from a request that renders to the
// candidate, even though Prisma doesn't enforce that automatically").
// Protection here is the same convention: these three models must only ever
// be imported from server-only, admin-gated modules (src/lib/admin/*,
// gated by requireAdmin()/isAdminEmail() in src/lib/admin/auth.ts) — never
// from a path a candidate-facing request can reach. Admin identity
// throughout is a plain email string (ADMIN_EMAILS allowlist — there is no
// Admin/AdminUser model in this schema), matching AdminEmailLog.sentByEmail's
// existing convention above.

// One row per detected issue per ResumeAnalysis — the analytics spine for
// Part B's prevalence/fix-rate/point-impact admin views. Exploded from a
// completed ResumeAnalysis by src/lib/analytics/capture-resume-issues.ts
// (called from resume-analysis/compute.ts immediately after the analysis
// + its ReviewerQuestion rows are created), from three sources: every
// dimensionFindings Finding across all 11 dimensions (now carrying its own
// issueCode — see Finding.issueCode), every modifiers.ts reconciliation
// Finding (ReconciliationFinding.issueCode), and every ReviewerQuestion
// created alongside the analysis (mapped via
// REVIEWER_DETECTION_TYPE_TO_ISSUE_CODE in issue-taxonomy.ts).
model ResumeIssue {
  id               String           @id @default(cuid())
  candidateId      String
  candidate        CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resumeAnalysisId String
  resumeAnalysis   ResumeAnalysis   @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)

  issueCode String // IssueCode (src/lib/analytics/issue-taxonomy.ts) — permanent, see that file's header comment before ever touching an existing value
  category  String // IssueCategory — denormalized from ISSUE_TAXONOMY[issueCode].category at write time, so a prevalence-by-category query never has to join back to the taxonomy module
  severity  String // "low" | "medium" | "high" | "critical" — this instance's severity (mapped from the source Finding where one exists; falls back to ISSUE_TAXONOMY[issueCode]'s "typical" severity for reviewer-question-sourced rows, which have no per-instance severity)
  dimension String // "your_experience" | "your_resume" — denormalized from ISSUE_TAXONOMY[issueCode].dimension

  // estimatedPointGain / |penalty|, where the source Finding or
  // ReconciliationFinding carried one. Null for reviewer-question-sourced
  // rows — ReviewerDetection carries no per-instance point estimate, and
  // fabricating one would overstate precision the engine doesn't have (see
  // ISSUE_TAXONOMY[issueCode].typicalPointImpact for a population-level
  // planning figure instead).
  pointImpact Int?

  detectedAt DateTime @default(now())

  resolvedAt     DateTime?
  // "fixed" | "dismissed_not_applicable" | "declined_leave_as_is" |
  // "corrected_source_data" | "superseded" — String, not a Prisma enum,
  // matching ReviewerQuestion.resolutionType's existing convention.
  resolutionType String?

  surfacedInWalkthrough Boolean @default(false)
  walkthroughStep       String?

  // Correlation keys back to the two live walkthrough resolution surfaces —
  // plain strings, not Prisma relations, since this table's job is
  // analytics correlation, not referential integrity. At most one of the
  // two is ever set on a given row.
  //
  // findingKey: `${DimensionKey}:${arrayIndex}` for dimensionFindings-sourced
  // rows (exactly matches walkthrough/mechanical-findings.ts's existing key
  // format) or `reconciliation:${index}` for modifiers.ts-sourced rows —
  // lets resolveMechanicalFindingAction (walkthrough/actions.ts) update this
  // exact row instead of guessing. Null for reviewer-question-sourced rows.
  findingKey         String?
  // Set only for rows sourced from a ReviewerQuestion detection — lets
  // resolveReviewerQuestionAction (walkthrough/actions.ts) update this row
  // by id instead of text-matching. Null for dimensionFindings/reconciliation-
  // sourced rows.
  reviewerQuestionId String? @unique

  @@index([issueCode, detectedAt])
  @@index([candidateId])
  @@index([category, detectedAt])
}

// One row per week per segment — precomputed so Part B Prompt 5's trend
// views never recompute live (Prompt 6: "A dashboard that recomputes 40
// weeks of history on load will be abandoned"). Written by the Monday
// 00:15 UTC weekly snapshot job (Prompt 6), not modeled in this pass —
// this table is schema-only foundation for that job and for the Prompt 4/5
// admin views built on top of it.
model PopulationSnapshot {
  id            String   @id @default(cuid())
  weekStartDate DateTime // Monday 00:00 UTC for the week this snapshot covers
  segmentType   String // "all" | "seniority" | "function" | "industry" | "metro" | "persona" | "employment_status" | "usage_tier"
  segmentValue  String // e.g. "EXECUTIVE" for segmentType "seniority"; "all" for segmentType "all" — never empty, so the unique constraint below always has a real key
  memberCount   Int
  metrics       Json // whatever Part B Prompt 4/5's metric set computes for this segment/week — shape owned by the snapshot job, not fixed here
  computedAt    DateTime @default(now())

  // "Rerunning a week overwrites cleanly" (Prompt 6) — the snapshot job
  // upserts on this constraint rather than a skip-if-exists check. Postgres
  // backs a unique constraint with a real index, so this also satisfies
  // the spec's index requirement on the same three columns — no separate
  // @@index needed.
  @@unique([weekStartDate, segmentType, segmentValue])
}

// Every individual-record view by an admin — Part B Prompt 8: "Log every
// individual-record view... with a required reason field. Not optional,
// not a text box that accepts empty." The empty-reason rejection is
// enforced at the server-action layer (Prisma can't express "non-empty
// string" as a constraint); this table only records what already passed
// that check.
model AdminAccessLog {
  id         String @id @default(cuid())
  // Plain email string, not a relation — see this section's header comment.
  adminEmail String

  // Exactly one of viewedCandidateId/viewedCompanyId is set on any row —
  // enforced at the server-action layer (logAdminAccess in
  // src/lib/admin/access-log.ts), not here (Prisma has no CHECK-constraint
  // equivalent). Originally viewedCandidateId was required-only; widened
  // (additive, both nullable) by Part C Prompt 7 so the same log can cover
  // a company-level view (the nervous-employee panel on the admin company
  // page) without inventing a second log table. Every pre-existing row has
  // viewedCandidateId set and viewedCompanyId null, so this migration needs
  // no backfill.
  viewedCandidateId String?
  viewedCandidate   CandidateProfile? @relation(fields: [viewedCandidateId], references: [id], onDelete: Cascade)
  viewedCompanyId   String?
  viewedCompany     Company?          @relation(fields: [viewedCompanyId], references: [id], onDelete: Cascade)

  surface  String // e.g. "admin/issues", "admin/population", "admin/companies/[id]" — which panel triggered the view
  reason   String // required, never empty (enforced at the server-action layer)
  viewedAt DateTime @default(now())

  @@index([viewedCandidateId, viewedAt])
  @@index([viewedCompanyId, viewedAt])
  @@index([adminEmail, viewedAt])
}

// ── COMPANIES & INSIDER NETWORK ─────────────────────────────────────────────
// Phase 2 Master Script, Part C, Prompts 1-4 — Phase A of a two-phase build
// (schema + candidate-facing page + insider network; the admin company view
// and nervous-employee panel are Prompts 6/7, Phase B, not built yet).
//
// Two things the spec assumes exist and don't, confirmed absent anywhere in
// this codebase before this pass:
//
// 1. A WARN-filing monitoring agent — no cron, no model, no real input.
//    CompanySignal.warnFilings12mo/warnEmployeesAffected below are added
//    nullable so the schema doesn't need another migration once that agent
//    is real, but this phase's nightly job (see the company-signals cron)
//    never populates them, and trajectory is computed from posting deltas
//    alone (see that column's comment). Never fabricate a WARN number —
//    every candidate-facing "contraction signal" surface renders an
//    explicit "not available yet" state instead of reading these two
//    columns.
// 2. (Resolved) A dedicated "Confidential Search Mode" boolean — task #966,
//    NextChapter_Search_Visibility_References_Leaderboards.md — now exists
//    as CandidateProfile.confidentialSearchMode above. src/lib/companies/
//    insider-network.ts and src/app/support/admin/(portal)/population/
//    page.tsx's ConfidentialSection were both updated to read it directly
//    instead of the old privacyTier === 'STEALTH' proxy.
//
// Join strategy: there is no domain-based join key anywhere in this
// codebase (ExclusiveJobPosting.companyName and WorkHistoryEntry.companyName
// are both free text) — Company.canonicalNameNormalized is keyed by
// normalizeOrgName() (src/lib/text/org-name-match.ts), the same
// normalization idiom CompanySizeLookup/CompanyIndustryLookup/
// CompanyWatchlistEntry/WorkHistoryEntry already use.

// Phase 9 §A3.3/§A3.7 — PE/VC ownership mapping. No automated
// firmographics/ownership detection exists anywhere in this codebase, and
// building one requires a licensed vendor (Crunchbase/Grata/PrivCo, §A3.2)
// with confirmed redistribution rights (§E2.2) — neither exists yet. This
// is a real, manually-admin-set field (Admin > Companies), never inferred
// or guessed, so the target list builder's ownership filter shows only
// what an admin has actually confirmed — everything else reads UNKNOWN.
enum CompanyOwnershipType {
  PE_BACKED
  VC_BACKED
  PUBLIC
  PRIVATELY_HELD_INDEPENDENT
}

model Company {
  id                      String                @id @default(cuid())
  name                    String // display name, first-seen casing
  canonicalNameNormalized String                @unique // via normalizeOrgName() — the real join key
  industry                String?
  sizeBand                CompanySizeBand?
  hqMetro                 String?
  // One-sentence "what this company actually does" — lazily LLM-resolved
  // and cached here forever, same cost-scoped pattern as industry/sizeBand
  // (see resolveCompanyMetadataIfMissing in company-lookup.ts).
  description             String?               @db.Text
  // No real per-employer ATS-vendor signal exists anywhere in this codebase
  // (AtsParseResult is about RESUME parsing, not the hiring company's own
  // ATS) — nullable, never populated this phase. The company page renders
  // an explicit "not available yet" state for this field rather than a
  // guess, same treatment as the WARN-dependent contraction signal.
  atsPlatform             String?
  // Phase 9 — real, admin-set-only PE/VC ownership flag (see enum comment
  // above for why nothing here is ever auto-detected). Null = not yet
  // reviewed by an admin, shown to candidates as "Unknown", never as a
  // guessed value.
  ownershipType           CompanyOwnershipType?
  isVerified              Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  signals             CompanySignal[]
  memberEmployment    MemberEmployment[]
  intel               CompanyIntel[]
  insiderRequests     InsiderRequest[]
  applicationOutcomes CompanyApplicationOutcome[]
  // Part C Prompt 7 — the admin company page's nervous-employee panel logs
  // every view here (see AdminAccessLog.viewedCompanyId's own comment).
  adminAccessLogViews AdminAccessLog[]

  @@index([industry])
}

// Computed nightly, purely from ExclusiveJobPosting + inferFunctionFromTitle()
// — no WARN input (see this section's header comment). One row per
// company per ISO week.
model CompanySignal {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekStartDate DateTime // Monday 00:00 UTC, same convention as PopulationSnapshot

  openRolesTotal        Int
  openRolesDirectorPlus Int
  rolesDelta4wk         Int
  rolesDelta12wk        Int
  // 'growing' | 'flat' | 'contracting' — computed from rolesDelta12wk alone
  // (posting-signal-only), NOT the spec's WARN-overridden definition (no
  // real WARN input exists — see header comment). Thresholds and reasoning
  // documented in src/lib/companies/signals.ts.
  trajectory            String
  topFunctionsHiring    Json // string[], ranked most-hired-for first
  topSkillsRequested    Json // string[], ranked — keyword-frequency extraction, see src/lib/companies/skills-extraction.ts for why this isn't an LLM call
  medianPostingAgeDays  Int?

  // Nullable, forward-compatible columns for a future real WARN agent.
  // NEVER populated by this phase's cron — see header comment. Any
  // candidate-facing read of these two columns must be gated behind an
  // explicit "not available yet" state, never a fabricated number.
  warnFilings12mo       Int?
  warnEmployeesAffected Int?

  createdAt DateTime @default(now())

  @@unique([companyId, weekStartDate])
  @@index([companyId])
}

// The contribution graph — a candidate's tagged/confirmed employment at a
// company, the unlock gate for querying anyone else's rows (Prompt 4.1) and
// the source of the "people who know this company" insider list (4.2).
// Distinct from WorkHistoryEntry (candidate's own resume-derived history,
// company as free text): this is the company-graph-joined, insider-network-
// specific record, created only once a candidate has actively confirmed it
// (verifiedFromResume tracks whether that confirmation started from a
// resume-parsed row or a manual add — same verified/resumeDerived shape as
// WorkHistoryEntry, reused rather than inventing a new verification concept).
model MemberEmployment {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title         String
  function      String? // inferFunctionFromTitle() output, same vocabulary as PRIMARY_FUNCTION_OPTIONS
  seniorityBand String? // inferLevelFromTitle() output

  startDate DateTime?
  endDate   DateTime? // null = current
  isCurrent Boolean   @default(false)

  // Default true per spec, but gated off in practice (never surfaced as an
  // insider) for STEALTH-tier candidates and current employees who haven't
  // explicitly opted in — see src/lib/companies/insider-network.ts,
  // isEligibleAsNamedInsider().
  visibleAsInsider   Boolean @default(true)
  verifiedFromResume Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, companyId])
  @@index([companyId])
  @@index([candidateId])
}

// Crowdsourced "how to get hired here" — the candidate-facing core of the
// company page. Every row is moderated before publish (see
// src/lib/companies/intel-moderation.ts) — status starts 'pending', never
// 'published', until that classification runs.
model CompanyIntel {
  id                     String           @id @default(cuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contributorCandidateId String
  contributorCandidate   CandidateProfile @relation(fields: [contributorCandidateId], references: [id], onDelete: Cascade)

  // 'interview_loop' | 'timeline' | 'what_they_test' | 'who_decides' |
  // 'recruiter_responsiveness' | 'what_kills_candidates' — the spec's six
  // structured intel types.
  intelType       String
  body            String
  roleLevelAtTime String?
  // 'within_2yrs' | '2_5yrs' | '5yrs_plus'
  recencyBucket   String?
  isAnonymous     Boolean @default(true)
  helpfulCount    Int     @default(0)

  // 'pending' | 'published' | 'removed'
  status              String  @default("pending")
  moderationCategory  String? // see src/lib/companies/intel-moderation.ts's own small taxonomy — deliberately NOT CommunityModerationCategory
  moderationReasoning String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([contributorCandidateId])
}

// The 1:1 "ask an insider" flow (Prompt 4.3). Never queryable by anyone but
// the two parties — no admin surface reads this table in Phase A. Declines
// are silent by product design: the asker's own view must never distinguish
// 'declined' from 'pending' (enforced in the query layer, not here — see
// src/lib/companies/insider-network.ts).
model InsiderRequest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  askerCandidateId   String
  askerCandidate     CandidateProfile @relation("InsiderRequestAsker", fields: [askerCandidateId], references: [id], onDelete: Cascade)
  insiderCandidateId String
  insiderCandidate   CandidateProfile @relation("InsiderRequestInsider", fields: [insiderCandidateId], references: [id], onDelete: Cascade)

  question String
  // 'pending' | 'accepted' | 'declined' | 'expired' | 'answered'
  status   String  @default("pending")
  answer   String?

  askedAt     DateTime  @default(now())
  respondedAt DateTime?

  @@index([askerCandidateId, status])
  @@index([insiderCandidateId, status])
  @@index([companyId])
}

// Aggregate-only outcome rollup for "how members have fared" — computed
// nightly from real JobPosting rows (candidateId, companyName, appliedAt/
// declinedAt/interviewLandedAt/offerReceivedAt), joined to Company via
// normalizeOrgName(companyName) === canonicalNameNormalized. Never a
// per-candidate record — every read of this table on the candidate-facing
// company page runs through suppressSmallCells() before rendering.
model CompanyApplicationOutcome {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekStartDate DateTime

  applications Int @default(0)
  responses    Int @default(0)
  interviews   Int @default(0)
  offers       Int @default(0)

  // Averaged over this company's applications that have both timestamps
  // (appliedAt + interviewLandedAt / declinedAt) — null when no application
  // to this company has a computable duration yet. Same
  // appliedAt-to-X-days formula already used in rejection-insights.ts.
  avgDaysToInterview Float?
  avgDaysToRejection Float?

  createdAt DateTime @default(now())

  @@unique([companyId, weekStartDate])
  @@index([companyId])
}

// Dedup log for "intel marked helpful" (Prompt 4.4, 15 points to the
// CONTRIBUTOR, not the voter) — CompanyIntel.helpfulCount is a plain
// counter with no vote history of its own, so without this a candidate
// could reload and re-click "helpful" to farm points for someone
// indefinitely. Unique on [intelId, voterCandidateId] makes one vote per
// member per piece of intel a real DB-level guarantee, not just a UI debounce.
model CompanyIntelHelpfulVote {
  id               String   @id @default(cuid())
  intelId          String
  voterCandidateId String
  createdAt        DateTime @default(now())

  @@unique([intelId, voterCandidateId])
  @@index([intelId])
}

// Partners Master Build Script §A3.4 (task #979, Phase 9) — the Premium
// weekly personalized market brief. One row per (candidate, ISO week),
// generated on demand today (a button on the Market Intelligence page, not
// yet a cron — see that phase's report) from real per-candidate data only:
// their own CompanyWatchlistEntry targets and those companies' latest
// CompanySignal, insider-network activity (MemberEmployment/InsiderRequest),
// and a comp band when enough real ExclusiveJobPosting salary data exists.
// factsJson is the exact fact list handed to the model — kept for audit so
// "did the model add something that wasn't in the facts" is always
// checkable, never re-derived from the generated prose. See
// src/lib/market-intelligence/weekly-brief.ts for the generation discipline
// (never fabricate a company name or number — omit the line instead).
model MarketIntelWeeklyBrief {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStartDate DateTime // Monday 00:00 UTC, same convention as CompanySignal
  factsJson     Json
  content       String           @db.Text
  generatedAt   DateTime         @default(now())

  @@unique([candidateId, weekStartDate])
  @@index([candidateId])
}

// ─────────────────────────────────────────────────────────────────────────
// Partners Master Build Script §A1 — identity architecture (task #971,
// Phase 1). See docs/specs/NextChapter_Partners_Master_Build_Script.md.
// ─────────────────────────────────────────────────────────────────────────

// Base values from spec §A1.1 — "Role grants: candidate · alum · member ·
// coach · recruiter · hiring_manager · employer_admin · employer_viewer ·
// nc_admin. Each granted separately, gated separately, logged separately."
//
// employer_legal / employer_finance added in Phase 5 (§A7's own role-
// permission line: "employer_admin (enroll, billing, all reporting) ·
// employer_viewer (reporting only) · employer_legal (compliance pack
// only) · employer_finance (invoices only)") — Phase 1 built the ledger
// with only employer_admin/employer_viewer since the employer portal
// itself didn't exist yet to need the other two. Additive to the enum, so
// no existing RoleGrant row is affected.
enum RoleGrantRole {
  candidate
  alum
  member
  coach
  recruiter
  hiring_manager
  employer_admin
  employer_viewer
  employer_legal
  employer_finance
  nc_admin
  nen_employer
}

// The audit ledger for "who holds what role, granted by whom, when, and
// whether it's since been revoked" — does NOT replace CandidateProfile/
// Coach/Recruiter/EmployerProfile, which stay the system of record for
// role-specific profile data. This is purely the grant/revoke log, and the
// thing getRoleGrants() reads (see src/lib/auth/role-grants.ts) instead of
// the old pattern of separately querying all four role tables by userId.
//
// Deliberately NOT a hard @@unique([userId, role]) — a role can be granted,
// revoked, and re-granted over time (e.g. a recruiter relationship that
// lapses and later resumes), and each of those is its own row so the ledger
// stays a real history instead of one row that gets overwritten. The
// "only one ACTIVE grant per (userId, role)" invariant is enforced in
// application code (grantRoleIfMissing), not the schema.
model RoleGrant {
  id     String        @id @default(cuid())
  userId String // Supabase auth.users id — same identity every portal's CandidateProfile/Coach/Recruiter/EmployerProfile.userId already points at.
  role   RoleGrantRole

  grantedAt DateTime @default(now())
  // Supabase auth.users id of the admin who granted this, or null for a
  // system-granted role (the ordinary case — a candidate finishing their
  // own signup, a coach/recruiter completing their own onboarding).
  grantedBy String?

  revokedAt DateTime?
  revokedBy String?

  @@index([userId])
  @@index([userId, role, revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Employer portal (outplacement buyers) — Partners Master Build Script
// §A7, Phase 5. NEW models, additive. Do NOT confuse with EmployerProfile/
// EmployerSeat/EmployerTier above (§2216+) — those belong to `/talent`, a
// pre-existing, unrelated self-serve recruiting product where the
// "employer" is a company hiring, not a company buying outplacement seats
// for departing employees. This section is a completely separate domain:
// an HR/CHRO buys Core/Plus/Premium seats (§A2.2) for people who no longer
// work there.
//
// The privacy invariant every read against these models must respect (see
// §A1.2/§A1.3 and src/lib/employer/candidate-identity-guard.ts, Phase 1):
// an outplacement buyer must never resolve any individual candidate's
// identity, activity, or grade — aggregates only, minimum cell size 10,
// rounded below 50 seats, quarterly-only under 20 seats. OutplacementSeat
// below is the one legitimate exception (someone has to know which real
// person occupies a purchased seat, for billing/compliance) — see that
// model's own comment for exactly how it's read and never read.
// ─────────────────────────────────────────────────────────────────────────

enum OutplacementTier {
  CORE
  PLUS
  PREMIUM
}

enum OutplacementContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// §A7's last line, verbatim: "employer_admin (enroll, billing, all
// reporting) · employer_viewer (reporting only) · employer_legal
// (compliance pack only) · employer_finance (invoices only)." A dedicated
// enum rather than reusing RoleGrantRole's employer_* values — this table
// must never be able to hold a non-employer role, and RoleGrantRole is a
// much larger, app-wide enum with no schema-level way to constrain a
// foreign key to a subset of its values.
enum OutplacementRole {
  ADMIN
  VIEWER
  LEGAL
  FINANCE
}

enum OutplacementSeatStatus {
  INVITED
  ACTIVATED
  DEACTIVATED
}

// API enrollment is spec'd (§A7) but explicitly NOT built this phase — real
// third-party API auth/integration is out of scope (see this phase's
// report). No API value here so the enum can't imply a path that doesn't
// exist.
enum OutplacementEnrollmentMethod {
  SINGLE
  BULK_CSV
}

// The buying company. One org can run multiple contracts over time — a
// renewal, a second RIF cohort, a different tier for a different group —
// see OutplacementContract.cohortLabel for §A7's "multi-cohort views."
model OutplacementEmployerOrg {
  id                  String   @id @default(cuid())
  name                String
  programBrandName    String? // §A7 "program branding" — shown on this org's own portal chrome
  primaryContactName  String?
  primaryContactEmail String
  // Throwaway orgs created for this phase's own privacy-invariant
  // verification (see report) — never real seed/production data. Lets a
  // future cleanup script find and delete them without guessing.
  isSampleData        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contracts OutplacementContract[]
  orgUsers  OutplacementOrgUser[]
}

// A single purchase — seats, tier, term, PO/invoice reference. Admin-
// managed per spec §A9 ("Employer contracts — seats, term, tier, discount,
// PO, renewal date, utilization, renewal risk").
model OutplacementContract {
  id    String                  @id @default(cuid())
  orgId String
  org   OutplacementEmployerOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  cohortLabel      String? // e.g. "RIF — Q1 2026 Engineering" — §A7 multi-cohort views
  tier             OutplacementTier
  seatCount        Int
  termStartAt      DateTime
  termEndAt        DateTime
  poReference      String?
  invoiceReference String?
  status           OutplacementContractStatus @default(ACTIVE)
  isSampleData     Boolean                    @default(false)

  createdAt DateTime @default(now())
  createdBy String // admin userId — contracts are admin-managed, never self-service

  seats OutplacementSeat[]

  @@index([orgId])
  @@index([status, termEndAt])
}

// The one legitimate link between a purchased seat and a real candidate —
// "someone has to know which real person occupies which purchased seat for
// billing/compliance purposes." How this table is (and is never) read:
//
//   - Reporting/dashboard code (src/lib/employer/outplacement-reporting.ts)
//     may only reach CandidateProfile through
//     employerCandidateAggregates.count/aggregate/groupBy (Phase 1's
//     candidate-identity-guard.ts) — never a row, never candidateId itself.
//   - The org's own enrollment roster (outplacement-roster.ts) reads ONLY
//     invitedEmail/invitedName/status/dates below — fields the
//     employer_admin typed in themselves at enrollment time, never
//     candidateId, never a join to CandidateProfile. Redisplaying an
//     org's own enrollment input back to them isn't a privacy violation;
//     resolving an ARBITRARY candidate's identity is what's prohibited.
//   - candidateId itself is read row-level in exactly one place —
//     outplacement-compliance.ts's compliance pack, gated to the
//     employer_legal role, and even there it never surfaces job-search
//     activity/grade/detections — only contract/enrollment/service-
//     delivery facts (see that model — sorry, that file's — own comment).
model OutplacementSeat {
  id         String               @id @default(cuid())
  contractId String
  contract   OutplacementContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  invitedEmail String
  invitedName  String?

  inviteToken      String                       @unique @default(cuid())
  enrollmentMethod OutplacementEnrollmentMethod @default(SINGLE)
  status           OutplacementSeatStatus       @default(INVITED)

  // Set once the invited person accepts and either creates a fresh
  // CandidateProfile or links an existing one (see
  // src/app/employer/(app)/enroll/actions.ts). NEVER read directly by
  // reporting/dashboard code — see this model's own comment above.
  candidateId String?
  candidate   CandidateProfile? @relation(fields: [candidateId], references: [id])

  enrolledAt    DateTime  @default(now())
  activatedAt   DateTime?
  deactivatedAt DateTime?

  // A service-delivery fact ("the outplacement benefit was provided"), not
  // a job-search-outcome claim ("this person got hired") — this phase
  // deliberately does not claim placement rate/speed/success without real
  // substantiating data (spec §E3.9). Set by employer_admin from the org's
  // own roster (markSeatPlaced) when they close out a seat, exactly like
  // any other outplacement vendor's "case closed" marker.
  placedAt DateTime?

  // Throwaway seats created for this phase's own privacy-invariant
  // verification — see report.
  isSampleData Boolean @default(false)

  @@index([contractId])
  @@index([candidateId])
  @@index([contractId, status])
}

// The four-role RBAC for an employer-portal login. Distinct from the
// global RoleGrant ledger (which only records "this identity holds
// employer_admin somewhere," for RoleContextBanner purposes) — this table
// scopes WHICH buying org that grant applies to, and is what every
// employer-portal query/action actually authorizes against.
model OutplacementOrgUser {
  id    String                  @id @default(cuid())
  orgId String
  org   OutplacementEmployerOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role  OutplacementRole

  invitedEmail String
  fullName     String?
  inviteToken  String    @unique @default(cuid())
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  userId       String?   @unique

  @@unique([orgId, invitedEmail])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Recruiter portal §A6.2 fix — "Consented candidates only, never
// browsable." Replaces a direct browsable CandidateProfile query
// (privacyTier-filtered but otherwise open to any recruiter) with a
// per-recruiter consent gate, same shape as PortfolioAccessRequest's
// existing candidate-controlled reveal pattern above.
// ─────────────────────────────────────────────────────────────────────────

enum RecruiterIntroductionStatus {
  REQUESTED
  CONSENTED
  DECLINED
  REVOKED
}

// How a CONSENTED row came to exist — kept distinct from the ledger events
// below so "why is this recruiter able to see this candidate" is answerable
// from the row itself without walking the event log.
enum RecruiterIntroductionSource {
  RECRUITER_SOURCED // candidate signed up through this recruiter's own SourcedCandidate invite
  ENGAGEMENT_BACKFILL // one-time backfill from a pre-existing MessageThread between this pair (see scripts/backfill-recruiter-introductions.ts)
  COACH_INTRODUCED // not yet wired to any UI this phase — reserved for a coach-initiated introduction
  ADMIN_INTRODUCED // not yet wired to any UI this phase — reserved for an admin-initiated introduction
  CANDIDATE_REQUESTED // not yet wired to any UI this phase — reserved for a candidate-initiated opt-in to a specific recruiter
}

// One row per (recruiter, candidate) relationship. A CONSENTED row is the
// ONLY thing that makes a candidate visible to a recruiter's search/detail
// pages or messaging — see getConsentedCandidateIds/isCandidateConsentedFor
// Recruiter in src/lib/recruiter/introductions.ts, which is now the single
// place recruiter-side candidate visibility is decided. REVOKED rows are
// never deleted (the ledger below needs them); a revoked introduction can
// be re-requested, which creates a fresh row rather than resurrecting the
// old one, so the history of "this was revoked once" is never lost.
model RecruiterCandidateIntroduction {
  id          String                      @id @default(cuid())
  recruiterId String
  recruiter   Recruiter                   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      RecruiterIntroductionStatus @default(REQUESTED)
  source      RecruiterIntroductionSource

  requestedAt      DateTime  @default(now())
  respondedAt      DateTime?
  revokedAt        DateTime?
  // Phase 3, Partners Master Build Script section A6.4 -- set when status
  // becomes CONSENTED, from RecruiterSettings.consentExpiryDays as of that
  // moment (see createConsentedIntroductionIfMissing). Enforced alongside
  // status in getConsentedCandidateIds/isCandidateConsentedForRecruiter --
  // an expired introduction stops granting visibility without needing a
  // background job to flip its status.
  consentExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RecruiterCandidateIntroductionEvent[]

  @@unique([recruiterId, candidateId])
  @@index([candidateId, status])
  @@index([recruiterId, status])
}

// Append-only consent ledger per spec §A9 — "every recruiter introduction,
// what was shared, revocations." Written alongside every status change on
// the introduction row above, plus (optionally) finer-grained access events
// like a resume/dossier view, so admin's future Consent Ledger surface has
// a real audit trail to render instead of just the current status.
enum RecruiterIntroductionLedgerEvent {
  REQUESTED
  CONSENTED
  DECLINED
  REVOKED
  DOSSIER_VIEWED
  RESUME_VIEWED
  MESSAGED
}

model RecruiterCandidateIntroductionEvent {
  id             String                           @id @default(cuid())
  introductionId String
  introduction   RecruiterCandidateIntroduction   @relation(fields: [introductionId], references: [id], onDelete: Cascade)
  event          RecruiterIntroductionLedgerEvent
  // Free-text actor description, e.g. "recruiter:<id>", "candidate:<id>",
  // "system:backfill" — deliberately not a foreign key, since the actor can
  // be any of several unrelated tables (or the system itself) and this is a
  // log, not a relation other code should join through.
  actor          String
  // What was shared / why, e.g. "resume, dossier" or "backfilled from
  // existing message thread" — the "what was shared" half of §A9.
  detail         String?
  createdAt      DateTime                         @default(now())

  @@index([introductionId, createdAt])
}

// =============================================================================
// Phase 3 -- Admin: commercial management. Partners Master Build Script
// section A9 ("Nothing else can be operated without it"): plan catalog,
// coaching settings, recruiter settings. CoachRateCard (section A2.5) lives
// up near CoachSession above, closer to what it prices.
// =============================================================================

enum CoachAssignmentMode {
  AUTO_MATCH
  ADMIN_ASSIGN
  CANDIDATE_CHOICE
}

enum UnusedHoursPolicy {
  EXPIRE
  ROLLOVER
  REFUND
}

// Admin-managed coaching operations config, section A5.3. Single row -- id
// is a fixed literal so a second row can never be created -- read by the
// app, updated in place; every change is written to AdminSettingsChangeLog
// below with a field-level diff, actor, and timestamp. Deliberately NOT
// versioned-by-effective-date like CoachRateCard/PlanCatalogEntry: this is
// operational policy, not something individual historical records need to
// stay locked against the way a coach's pay for a past session does.
model CoachingSettings {
  id String @id @default("singleton")

  sessionLengthMinutesDefault Int  @default(50)
  // Keyed by planKey (matches PlanCatalogEntry.planKey below) -> sessions
  // included per billing period, e.g. {"dtc_coaching_plus": 2}.
  sessionsIncludedByPlan      Json @default("{}")
  coachMaxActiveClients       Int  @default(25)

  // Matching weights consumed by src/lib/coach/matching.ts -- mirrors the
  // score contributions that already existed there as hardcoded consts
  // (function/industry match and seniority match), now admin-editable.
  // matchWeightTimezone/matchWeightStyle are stored for admin to set ahead
  // of time but are NOT YET read anywhere -- timezone is currently a hard
  // constraint (candidate preference excludes non-matching coaches
  // entirely) rather than a weighted score, and no style-compatibility
  // signal exists in matching.ts yet. See this phase's report.
  matchWeightFunctionIndustry        Int @default(3)
  matchWeightSeniorityLevel          Int @default(2)
  matchWeightHighNeedBoost           Int @default(4)
  matchWeightTimezone                Int @default(0)
  matchWeightStyle                   Int @default(0)
  // Phase 8, §A2.4 "priority coach booking" -- an additive boost, never a
  // quality/grade signal, applied only to candidates with an ACTIVE
  // MembershipSubscription.priorityCoachBooking flag. See the invariant
  // comment on generateCoachShortlist (src/lib/coach/matching.ts) for why
  // this is safe to add: it's a membership perk, not something that makes a
  // candidate look "easier," same exemption already carved out for
  // levelRankScore.
  matchWeightMembershipPriorityBoost Int @default(3)
  matchShortlistSize                 Int @default(3)

  // CANDIDATE_CHOICE reflects current live behavior: generateCoachShortlist
  // ranks candidates a shortlist, /dashboard/coaching-match lets the
  // candidate pick from it. AUTO_MATCH/ADMIN_ASSIGN are not wired to any
  // flow yet -- this field records admin's chosen policy, consumed once
  // that logic exists.
  assignmentMode CoachAssignmentMode @default(CANDIDATE_CHOICE)

  cancellationWindowHours Int               @default(24)
  noShowConsumesHour      Boolean           @default(true)
  lateCancelConsumesHour  Boolean           @default(true)
  unusedHoursPolicy       UnusedHoursPolicy @default(EXPIRE)

  responseTimeSlaHoursCore    Int @default(72)
  responseTimeSlaHoursPlus    Int @default(48)
  responseTimeSlaHoursPremium Int @default(24)

  // Trigger thresholds. streakBreakWeeksThreshold is the only one currently
  // wired to real detection logic (detectAvoidancePattern in
  // src/lib/coach/pre-session-brief.ts, which flags an action type
  // committed-but-never-completed across this many recent weeks). The other
  // two are stored for admin to set ahead of a not-yet-built
  // interviews-without-offers / dormancy detector -- see this phase's
  // report for what's wired vs. not.
  interviewsWithoutOffersThreshold Int @default(8)
  dormancyDaysThreshold            Int @default(14)
  streakBreakWeeksThreshold        Int @default(2)

  // Free-text policy description shown alongside the one-tap reassignment
  // flow that already exists per section A5.4 -- that flow's UI/action
  // isn't part of this phase, this is just the admin-editable policy text.
  escalationReassignmentPolicy  String?  @db.Text
  sessionRatingPromptEnabled    Boolean  @default(true)
  // Average rating below which a coach enters a removal queue. Null = no
  // auto threshold set. Not yet consumed by any removal-queue UI.
  sessionRatingRemovalThreshold Decimal? @db.Decimal(3, 2)
  // Number of pending/at-capacity signals that should trigger bench
  // outreach for a surge (section A5.4). Null = no threshold set. Not yet
  // consumed by any outreach automation.
  surgeCapacityBenchThreshold   Int?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum RecruiterFirmStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REMOVED
}

// Firm-level admin config, section A6.4. Recruiter (defined earlier in this
// file) stays an individual login row with free-text firmName, same as
// today; this is an optional relation so existing recruiters are unaffected
// until admin links them to a firm record.
model RecruiterFirm {
  id     String              @id @default(cuid())
  name   String              @unique
  status RecruiterFirmStatus @default(PENDING)

  verifiedAt DateTime?
  verifiedBy String?

  // Free-text description of scope (e.g. "Director+ only, tech function")
  // -- the admin-recorded policy, not query-layer enforcement; actual
  // scope-limited access enforcement is future work once a concrete case
  // needs it (today every VERIFIED firm's recruiters get the same
  // consented-candidates-only access every other recruiter gets).
  accessScope String?
  seatCount   Int     @default(1)

  // Null = inherits RecruiterSettings.feedbackSlaHoursDefault below.
  feedbackSlaHours          Int?
  exportDestinationsEnabled String[]

  // Phase 6, §A6.2 -- "branded submission packet ... with the recruiter's
  // own logo." Public URL in the same `avatars` storage bucket/pattern as
  // Recruiter.profilePictureUrl / Coach photo uploads (see
  // uploadAvatarFile) -- nullable since most firms won't have uploaded one
  // yet; the packet falls back to firm name only when absent.
  logoUrl String?

  // Phase 6, §A6.2/§A6.4 -- "fee arrangements and placement tracking
  // terms." Recorded default for this firm's placements; a per-placement
  // row (RecruiterPlacement below) can still override it, same
  // "firm default, per-instance override" shape as feedbackSlaHours above.
  // Nullable/no default enum value -- "not yet configured" must be
  // representable and distinct from "confirmed $0 fee."
  feeArrangementType          RecruiterFeeArrangementType?
  // 0-100, used when feeArrangementType = PERCENTAGE_OF_COMP.
  feeArrangementPercentage    Float?
  // Whole-dollar amount, used when feeArrangementType = FLAT_FEE.
  feeArrangementFlatAmountUsd Int?
  feeArrangementNotes         String?                      @db.Text

  suspendedAt DateTime?
  suspendedBy String?
  notes       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiters Recruiter[]
}

enum RecruiterFeeArrangementType {
  PERCENTAGE_OF_COMP
  FLAT_FEE
  RETAINER
}

enum RecruiterFeedbackEnforcement {
  NONE
  WARN
  SUSPEND
}

// Global recruiter operations config, section A6.4. Same singleton +
// change-log pattern as CoachingSettings above.
model RecruiterSettings {
  id String @id @default("singleton")

  // Default consent-expiry window applied when an introduction becomes
  // CONSENTED (see createConsentedIntroductionIfMissing in
  // src/lib/recruiter/introductions.ts) -- feeds
  // RecruiterCandidateIntroduction.consentExpiresAt.
  consentExpiryDays Int @default(90)

  // How much Dossier completeness promotes a candidate in recruiter-facing
  // ranking (section A6.1/A6.4). Stored now; Phase 6's recruiter portal
  // ranking will consume it -- not read anywhere yet.
  rankingWeightDossierCompleteness Int @default(5)

  feedbackSlaHoursDefault             Int                          @default(120)
  feedbackSlaEnforcement              RecruiterFeedbackEnforcement @default(WARN)
  // Consecutive SLA misses before a firm should be auto-flagged for
  // suspension when feedbackSlaEnforcement = SUSPEND. Not yet consumed by
  // any enforcement job -- recorded policy, no automation built this phase.
  feedbackNonResponseSuspendThreshold Int                          @default(3)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum AdminSettingsScope {
  COACHING
  RECRUITER
}

// Shared audit log for CoachingSettings and RecruiterSettings changes --
// same "actor + timestamp, every change logged" requirement as
// RecruiterCandidateIntroductionEvent above, one table instead of two since
// both settings objects are edited the same way (single row, updated in
// place, never versioned rows).
model AdminSettingsChangeLog {
  id        String             @id @default(cuid())
  scope     AdminSettingsScope
  actor     String
  changedAt DateTime           @default(now())
  // { fieldName: { from, to } } for every field that actually changed.
  diff      Json
}

// =============================================================================
// Phase 6 -- Recruiter portal (Partners Master Build Script §A6.2): the
// feedback loop ("reviewed / screened / submitted / interviewed / placed /
// passed with reason") and placement + fee tracking. Distinct from
// RecruiterCandidateIntroduction above -- an introduction is CONSENT to see
// a candidate at all; a submission is a specific "I put this candidate
// forward for a role" event that only makes sense once consent already
// exists. A candidate can have a live introduction with no submission yet
// (browsed but not submitted), or (in theory, if consent were later
// revoked) a submission whose introduction has since lapsed -- the
// submission record itself is never deleted, since it's the recruiter's own
// activity log and the fee/placement history it can lead to must survive a
// later revocation.
// =============================================================================

enum RecruiterSubmissionStage {
  REVIEWED
  SCREENED
  SUBMITTED
  INTERVIEWED
  PLACED
  PASSED
}

model RecruiterCandidateSubmission {
  id          String           @id @default(cuid())
  recruiterId String
  recruiter   Recruiter        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Free-text -- kept even now that reqId (below) exists, since not every
  // submission maps to a live req (a recruiter working a firm that hasn't
  // onboarded a hiring manager yet, or a role outside the hiring portal
  // entirely) and this is still the recruiter's own record of what they
  // submitted the candidate for, same "recruiter's own log" pattern as
  // SourcedCandidate.notes.
  roleTitle   String
  companyName String

  // Phase 7, Partners Master Build Script §A8 -- the hiring-manager portal.
  // Nullable and set automatically (see autoLinkSubmissionToReq in
  // src/lib/hiring/req-matching.ts, called from advanceSubmissionStage when
  // a submission reaches SUBMITTED) by matching companyName/roleTitle above
  // against the hiring manager's own open HiringReq -- deliberately NOT a
  // field the recruiter sets directly, so nothing in the Recruiter portal's
  // UI needs to change for this phase. A hiring manager's visibility into
  // this submission (see src/lib/hiring/visibility.ts) is gated on reqId
  // being set AND stage being SUBMITTED or later -- "candidates submitted
  // to their req," never a browsable pool, same discipline as
  // isCandidateConsentedForRecruiter.
  reqId String?
  req   HiringReq? @relation(fields: [reqId], references: [id], onDelete: SetNull)

  stage          RecruiterSubmissionStage @default(REVIEWED)
  // Only meaningful when stage = PASSED -- "passed with reason" per §A6.2.
  passedReason   String?                  @db.Text
  // Bumped on every stage change -- the one field the feedback-SLA tracker
  // reads (see src/lib/recruiter/submissions.ts's getLateSubmissions): a
  // submission sitting in a non-terminal stage longer than the firm's SLA
  // window is "late," full stop, regardless of when it was first created.
  stageUpdatedAt DateTime                 @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    RecruiterCandidateSubmissionEvent[]
  placement RecruiterPlacement?

  // Phase 7 -- one interview guide, one panel, and (once placed) one
  // post-hire feedback request per submission; many scorecards (one per
  // panelist) per submission. See the Hiring Manager Portal section below.
  interviewGuide   InterviewGuide?
  interviewPanel   InterviewPanel?
  scorecards       Scorecard[]
  postHireFeedback PostHireFeedback?

  @@index([recruiterId, stage])
  @@index([candidateId])
  @@index([reqId, stage])
}

// Append-only history of stage changes, same ledger pattern as
// RecruiterCandidateIntroductionEvent -- "how did this submission get to
// PASSED" should be answerable from the row history, not just the current
// stage.
model RecruiterCandidateSubmissionEvent {
  id           String                       @id @default(cuid())
  submissionId String
  submission   RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage        RecruiterSubmissionStage
  actor        String
  note         String?
  createdAt    DateTime                     @default(now())

  @@index([submissionId, createdAt])
}

// One row per placement, §A6.2/§A6.4 "placement and fee tracking." Created
// once a RecruiterCandidateSubmission reaches PLACED. Defaults from
// RecruiterFirm.feeArrangement* at creation time (a firm-level default
// changing later must not silently rewrite an already-recorded placement's
// terms -- same snapshot-at-creation convention as CoachSession's
// rateSnapshotCents), with every field still independently overridable per
// placement.
model RecruiterPlacement {
  id           String                       @id @default(cuid())
  submissionId String                       @unique
  submission   RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  recruiterId  String
  recruiter    Recruiter                    @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    CandidateProfile             @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  placedAt  DateTime  @default(now())
  startDate DateTime?

  feeType          RecruiterFeeArrangementType?
  feePercentage    Float?
  feeFlatAmountUsd Int?
  feeNotes         String?                      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId])
  @@index([candidateId])
}

enum PlanCatalogCategory {
  OUTPLACEMENT
  DIRECT_TO_CONSUMER
  MEMBERSHIP
}

enum PlanBillingPeriod {
  NONE
  ONE_TIME
  MONTHLY
  ANNUAL
}

// Plan catalog, section A9 top bullet. Source of truth for every priced
// plan (outplacement A2.2, direct-to-consumer A2.3, membership A2.4),
// versioned by effective date exactly like CoachRateCard above: a price
// change never edits a past row, it inserts a new one with a later
// effectiveDate under the same planKey. "Current" for new signups = the
// latest active row with effectiveDate <= now for a planKey (see
// getCurrentPlan). Grandfathering an already-enrolled account is a property
// of THAT account's own subscription/contract record snapshotting its own
// priceCents at enrollment time -- the same lock-at-assignment pattern as
// CoachSession.rateSnapshotCents -- not something this catalog table itself
// needs to track, since no subscription/contract entity consumes it yet
// (real Stripe integration and per-account contracts are later phases; see
// this phase's report).
model PlanCatalogEntry {
  id            String              @id @default(cuid())
  planKey       String
  name          String
  category      PlanCatalogCategory
  priceCents    Int
  billingPeriod PlanBillingPeriod
  termMonths    Int?
  features      Json                @default("[]")
  effectiveDate DateTime
  active        Boolean             @default(true)
  createdBy     String
  createdAt     DateTime            @default(now())

  @@index([planKey, effectiveDate])
}

// ============================================================================
// Hiring manager portal -- Partners Master Build Script §A8, Phase 7.
//
// A hiring manager sees ONLY candidates submitted to their own req(s), never
// a browsable pool -- same discipline as the Recruiter portal's
// consented-candidates-only rule. Rather than a parallel submission model,
// this reuses RecruiterCandidateSubmission (see reqId above): "candidates
// submitted to their req" is the SUBMITTED-and-later stage of the exact same
// REVIEWED -> SCREENED -> SUBMITTED -> INTERVIEWED -> PLACED/PASSED pipeline
// Phase 6 already built. See src/lib/hiring/visibility.ts for the query that
// enforces both the stage floor and the conflict-of-interest exclusion below.
// ============================================================================

model HiringManager {
  id        String @id @default(cuid())
  fullName  String
  workEmail String @unique

  // The hiring manager's OWN current employer -- i.e. the company doing the
  // hiring. This is the primitive src/lib/hiring/conflict-check.ts compares
  // against a candidate's current employer (via getCurrentEmployerName /
  // orgNamesMatch, the same fuzzy-match helper already used for the
  // candidate-side "don't apply to your own employer" warning) to
  // auto-detect the §A8 "same current employer" conflict.
  companyName String

  // Real Supabase-auth login -- nullable only for the brief window between
  // a fresh signUp() and email confirmation finishing the row (see
  // completeHiringManagerSignupFromSession), same pattern as Recruiter.userId.
  userId String? @unique

  createdAt    DateTime @default(now())
  isSampleData Boolean  @default(false)

  reqs              HiringReq[]
  conflictFlags     HiringConflictFlag[]
  postHireFeedbacks PostHireFeedback[]
}

enum HiringReqStatus {
  OPEN
  FILLED
  CLOSED
}

// One open role a hiring manager is hiring for. Deliberately minimal for
// this phase (spec §A8 doesn't ask for a full req/ATS-style entity) -- just
// enough for autoLinkSubmissionToReq (src/lib/hiring/req-matching.ts) to
// match a recruiter's free-text roleTitle/companyName on
// RecruiterCandidateSubmission against an open req by company, and for a
// hiring manager to scope "my candidates" to "my reqs."
model HiringReq {
  id              String        @id @default(cuid())
  hiringManagerId String
  hiringManager   HiringManager @relation(fields: [hiringManagerId], references: [id], onDelete: Cascade)

  title  String
  status HiringReqStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions RecruiterCandidateSubmission[]

  @@index([hiringManagerId, status])
}

enum HiringConflictSource {
  // Auto-detected: candidate's current employer (WorkHistoryEntry.isCurrent)
  // matches HiringManager.companyName via orgNamesMatch.
  AUTO_SAME_EMPLOYER
  DECLARED_RELATIONSHIP
  DECLARED_HOUSEHOLD
  DECLARED_OTHER
}

// §A8's conflict rule + §E3.5/§E4.4's enforcement requirement -- "a real
// enforcement point that hides the candidate from that specific hiring
// manager's view when flagged (not just an admin dashboard note)." A row
// existing with clearedAt = null is the ENTIRE enforcement mechanism: every
// hiring-manager-facing query in src/lib/hiring/visibility.ts filters out
// any candidate with an uncleared flag for that hiring manager. clearedAt
// lets a false-positive auto-flag be retracted without losing the audit
// trail (row stays, just no longer blocks) -- deleting it outright would
// erase the "why was this ever hidden" history.
model HiringConflictFlag {
  id              String           @id @default(cuid())
  hiringManagerId String
  hiringManager   HiringManager    @relation(fields: [hiringManagerId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source     HiringConflictSource
  note       String?              @db.Text // free-text context for a DECLARED_* flag
  detectedAt DateTime             @default(now())
  clearedAt  DateTime?
  clearedBy  String?

  @@unique([hiringManagerId, candidateId])
  @@index([candidateId])
}

// Generated content for one submitted candidate, §A8 "generated interview
// guide from Dossier gaps" and "reference questions worth asking." Kept as
// ONE row per submission (not per-generation-history) with a straightforward
// overwrite-on-regenerate policy, same convenience-cache shape as
// CandidateProfile.dossierGeneratedCache -- there's no product need yet to
// keep prior guide versions.
model InterviewGuide {
  id           String                       @id @default(cuid())
  submissionId String                       @unique
  submission   RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // LLM-generated (see src/lib/hiring/generate-interview-guide.ts), grounded
  // in this candidate's real Dossier gaps -- [{ competency, question,
  // rationale }][]. competency is a HiringCompetencyKey string or null for a
  // narrative-gap question that isn't one of the five competencies.
  candidateQuestions Json?
  // Rule-based, non-LLM derivation (see src/lib/hiring/reference-questions.ts)
  // -- a distinct, cheaper artifact from candidateQuestions above, per §A8's
  // separate "reference questions worth asking" item. Same shape.
  referenceQuestions Json?

  generatedAt     DateTime?
  generationError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// §A8 "panel coordination -- assign each interviewer a different
// competency." One panel per submission for this phase (a candidate gets
// re-panel'd by creating a new submission if a second round is ever needed,
// same "no history" simplicity as InterviewGuide above).
model InterviewPanel {
  id           String                       @id @default(cuid())
  submissionId String                       @unique
  submission   RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdByHiringManagerId String
  createdAt                DateTime @default(now())

  panelists InterviewPanelist[]
}

enum HiringCompetencyKey {
  LEADERSHIP
  SKILLS_EXECUTION
  COMMUNICATION
  ADAPTABILITY
  OWNERSHIP
}

// One interviewer on a panel. assignedCompetency is set at panel-creation
// time by round-robin over the five HiringCompetencyKey values (see
// assignPanelistCompetencies in src/lib/hiring/panels.ts) so four
// interviewers don't ask the same question -- nullable only for a 6th+
// panelist beyond the five competencies, who gets no default assignment.
// scorecardToken is a public, unguessable link (same shape as
// Reference.token) so a panelist can submit their scorecard without a
// NextChapter account, mirroring the /ref/[token] referee flow.
model InterviewPanelist {
  id      String         @id @default(cuid())
  panelId String
  panel   InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  name  String
  email String

  assignedCompetency HiringCompetencyKey?
  scorecardToken     String               @unique @default(cuid())

  createdAt DateTime @default(now())

  scorecard Scorecard?

  @@index([panelId])
}

enum ScorecardRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

// §A8 "structured scorecard tied to the five competencies," §A8 next item
// "side-by-side comparison on shared evidence." submissionId is denormalized
// (also reachable via panelist -> panel -> submission) purely so
// getScorecardComparison (src/lib/hiring/scorecards.ts) can query every
// panelist's scorecard for a candidate in one indexed lookup instead of a
// three-table join.
model Scorecard {
  id           String                       @id @default(cuid())
  panelistId   String                       @unique
  panelist     InterviewPanelist            @relation(fields: [panelistId], references: [id], onDelete: Cascade)
  submissionId String
  submission   RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // { LEADERSHIP: { score: 1-5, notes: string }, ... } -- every panelist CAN
  // score all five competencies, not just their assignedCompetency (§A8:
  // "and can see/fill others if relevant"); UI defaults focus to the
  // assigned one.
  competencyScores      Json
  overallRecommendation ScorecardRecommendation?
  overallNotes          String?                  @db.Text

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([submissionId])
}

// §A8 "90-day post-hire feedback" -- seeded automatically once a submission
// reaches PLACED (see the hook in recordPlacement, src/lib/recruiter/
// submissions.ts) when that submission has a reqId, i.e. came through the
// hiring-manager pipeline. dueAt = placement start date (or placedAt if no
// start date was recorded) + 90 days. This IS the seed of real outcome data
// per §E2.2 -- nothing consumes it yet, but it's stored for real rather than
// stubbed.
model PostHireFeedback {
  id              String                       @id @default(cuid())
  submissionId    String                       @unique
  submission      RecruiterCandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  hiringManagerId String
  hiringManager   HiringManager                @relation(fields: [hiringManagerId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  requestedAt DateTime?
  submittedAt DateTime?

  howIsItGoingRating Int? // 1-5
  wouldHireAgain     Boolean?
  notes              String?  @db.Text

  createdAt DateTime @default(now())

  @@index([hiringManagerId])
  @@index([dueAt])
}

// ============================================================================
// Membership & Alumni Benefits Network -- Partners Master Build Script §A2.4
// and §A4, Phase 8.
//
// §A2.4: `alum` is granted for real the moment a candidate is verifiably
// placed (see activateAlumStatus, src/lib/membership/activate-alum.ts, hooked
// into recordPlacement and approveBountyClaim -- the two documented,
// human-verified "this candidate really got hired" signals in the codebase;
// see this phase's report for why the other two candidate-status transitions
// were judged too weak/ambiguous to hook). Membership itself
// (MembershipSubscription) is a real record with NO live billing this phase
// -- status/plan/price/freeUntil only, per this session's established
// no-payment-collection pattern for commercial features.
//
// §A4: alumni-sourced institutional benefits, NOT admin-curated courses --
// deliberately a separate system from LearningBadge/the admin Course
// catalog (`/support/admin/courses`). See BenefitsNetworkCompletion's own
// comment for the hard rule this phase was asked to enforce and verify:
// completions here must never feed computeDossierCompetencies.
// ============================================================================

enum MembershipStatus {
  ACTIVE
  LAPSED
  CANCELLED
}

enum MembershipSource {
  SELF_SERVE
  FREE_PREMIUM_PLACEMENT
}

// One row per candidate -- "the" real record of their Membership state. No
// live Stripe integration this phase; currentPeriodEnd/freeUntil are the
// informational fields a later billing integration would replace with real
// invoice-driven dates. status flips ACTIVE -> LAPSED by the
// membership-lapse-check cron (currentPeriodEnd, and freeUntil if set, both
// in the past) -- that's what gives break-glass reactivation
// (reactivateMembership, src/app/dashboard/membership/actions.ts) something
// real to react against, not just a copy promise.
model MembershipSubscription {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Points at PlanCatalogEntry.planKey ('membership_monthly' | 'membership_annual')
  // -- price is always read live from getCurrentPlan(planKey), never copied
  // here, so an admin price change (§A2.4/§A9) takes effect immediately.
  planKey String
  status  MembershipStatus @default(ACTIVE)
  source  MembershipSource @default(SELF_SERVE)

  // §A2.4 "priority coach booking" -- consumed as an additive score term in
  // generateCoachShortlist (src/lib/coach/matching.ts), gated on status
  // ACTIVE. Defaults on for every member; a real settings UI to turn it off
  // isn't asked for by the spec, so this exists mainly as the flag the
  // matching code reads, per the phase brief's "a real preference flag."
  priorityCoachBooking Boolean @default(true)

  // Free for 12 months when placement came through a Premium outplacement
  // seat (§A2.4) -- set once at auto-activation, never on self-serve signup.
  freeUntil        DateTime?
  currentPeriodEnd DateTime?

  startedAt     DateTime  @default(now())
  lapsedAt      DateTime?
  cancelledAt   DateTime?
  reactivatedAt DateTime?

  // §A2.4 benefit-delivery bookkeeping -- each cron (membership-dossier-
  // refresh, membership-market-check, membership-network-nudge) reads/writes
  // its own timestamp so "was this benefit actually delivered" is a real,
  // checkable fact instead of a stored promise.
  lastDossierRefreshAt   DateTime?
  lastMarketCheckAt      DateTime?
  lastNetworkNudgeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
}

// §A2.4 "quarterly market check with comp benchmarking" -- one row per run,
// kept as history (not overwritten) so a member can see the trend over time.
// Reuses getMarketConditions (src/lib/market/index.ts) for job-market volume
// and BLS trend; comp benchmarking is computed fresh here (no existing
// dollar-figure comp function was found in src/lib/market/ -- see this
// phase's report) from real salary data already on ExclusiveJobPosting rows,
// compared against the candidate's own stated targetCompMin.
model MembershipMarketCheck {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  checkedAt DateTime @default(now())

  adzunaCount      Int?
  blsYoyChangePct  Float?
  targetCompMin    Int?
  compBenchmarkMid Int?
  compSampleSize   Int

  createdAt DateTime @default(now())

  @@index([candidateId, checkedAt])
}

enum BenefitsListingStatus {
  PENDING_VERIFICATION
  LISTED
  DELISTED
  EXPIRED
}

enum BenefitsRedemptionMethod {
  CODE
  LINK
  EMAIL_INTRO
}

// §A4.2 -- an alum-proposed institutional benefit. Not listed (status stays
// PENDING_VERIFICATION, never shown in the catalog) until
// BenefitsNetworkVerification.confirmedAt is set via a click from an
// institution-domain email address -- see confirmBenefitsNetworkVerification,
// src/lib/benefits-network/verification.ts. institutionDomain is the actual
// proof of authority (derived from the confirmed email), not free text the
// alum typed.
model BenefitsNetworkListing {
  id     String           @id @default(cuid())
  alumId String
  alum   CandidateProfile @relation(fields: [alumId], references: [id], onDelete: Cascade)

  institutionName     String
  institutionDomain   String? // set only once verification confirms the institutional email
  programName         String
  description         String  @db.Text
  // §A4.4 "total cost stated including anything not covered" -- kept as its
  // own required field (not folded into description) so the catalog/listing
  // pages can render it as a distinct, always-visible line, never buried.
  fullCostNote        String  @db.Text
  discountDescription String

  seatCount              Int?
  redemptionMethod       BenefitsRedemptionMethod
  redemptionValue        String // the code, or the link/instructions
  redemptionInstructions String                   @db.Text

  // Catalog filter facets (§A4.3) -- free-text, admin/alum-authored, same
  // "no premature enum" judgment call as ExclusiveJobPosting.level/
  // sourceCategory above.
  function       String
  level          String
  format         String // e.g. self-paced, live cohort, hybrid
  costType       String // e.g. free, discounted, waived application fee
  timeCommitment String
  credentialType String // e.g. certificate, badge, none

  // §A4.3 "tied to the skills gap" -- short free-text tags, loosely matched
  // (case-insensitive substring, see src/lib/benefits-network/skill-match.ts)
  // against a candidate's cached skillGapSuggestions. Deliberately NOT an
  // LLM call at match time -- read-only against an already-cached field, no
  // new metered cost.
  skillGapTags String[] @default([])

  status     BenefitsListingStatus @default(PENDING_VERIFICATION)
  expiresAt  DateTime
  reviewDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verification BenefitsNetworkVerification?
  redemptions  BenefitsNetworkRedemption[]
  ratings      BenefitsNetworkRating[]
  reports      BenefitsNetworkReport[]
  completions  BenefitsNetworkCompletion[]

  // Catalog query is `status: LISTED, expiresAt: { gt: now }` -- this index
  // backs that read directly. A separate cron (benefits-network-expire-
  // listings) also flips status to EXPIRED past expiresAt so admin's own
  // listing table doesn't keep showing a dead listing as "Listed" --
  // belt-and-suspenders, the query filter is what actually enforces §A4.4's
  // auto-expiry requirement even before the cron next runs.
  @@index([status, expiresAt])
  @@index([alumId])
}

// §A4.2 step 2 -- "anything material requires confirmation from an
// institutional email address, not the alum's word." One row per listing;
// token is a public, unguessable link (same cuid()-as-token convention as
// OutplacementSeat.inviteToken/InterviewPanelist.scorecardToken elsewhere in
// this schema) mailed to the institutional address the alum supplied. The
// listing is NEVER shown in the catalog until confirmedAt is set -- see
// getCatalogListings, src/lib/benefits-network/listings.ts.
model BenefitsNetworkVerification {
  id        String                 @id @default(cuid())
  listingId String                 @unique
  listing   BenefitsNetworkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  institutionEmail String
  token            String    @unique @default(cuid())
  sentAt           DateTime  @default(now())
  expiresAt        DateTime
  confirmedAt      DateTime?

  @@index([token])
}

// §A4.2 step 4 -- one row per (listing, candidate) redemption. Unique
// constraint prevents double-counting the same candidate's redemption toward
// alum standing if they click "redeem" twice.
model BenefitsNetworkRedemption {
  id          String                 @id @default(cuid())
  listingId   String
  listing     BenefitsNetworkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime               @default(now())

  @@unique([listingId, candidateId])
  @@index([listingId])
}

// §A4.4 "member ratings on listings ... delist on sustained poor feedback."
// One rating per (listing, candidate) -- re-rating overwrites via upsert
// rather than accumulating duplicates. Admin's own view aggregates these
// (avg rating + count) to surface delisting-review candidates; nothing here
// auto-delists, matching this session's established human-judgment-required
// pattern for any removal/exclusion consequence.
model BenefitsNetworkRating {
  id          String                 @id @default(cuid())
  listingId   String
  listing     BenefitsNetworkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  rating      Int // 1-5
  comment     String?                @db.Text
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([listingId, candidateId])
  @@index([listingId])
}

enum BenefitsReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// §A4.4 "member reports it in one tap." reportedByCandidateId is nullable-
// free-text-reason only (not a rating) -- a single tap plus an optional
// reason, reviewed by admin exactly like /support/admin/reported-messages.
model BenefitsNetworkReport {
  id                    String                 @id @default(cuid())
  listingId             String
  listing               BenefitsNetworkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedByCandidateId String
  reportedBy            CandidateProfile       @relation(fields: [reportedByCandidateId], references: [id], onDelete: Cascade)
  reason                String?                @db.Text
  status                BenefitsReportStatus   @default(OPEN)
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())

  @@index([listingId, status])
}

// §A4.5 -- "a completed course appears in the Dossier as evidence of effort,
// NEVER as a competency score." Deliberately its own model, NOT a
// LearningBadge row and NOT anything referenced by
// GRADE_RELATIONS_INCLUDE/CandidateWithGradeRelations in
// src/lib/scoring/dossier-competencies.ts -- computeDossierCompetencies and
// computeCategoryGrades must never gain a relation to this model. The only
// consumer is getGapAreasAndLearningItems/getLearningGrowth
// (src/lib/reports/dossier-sections.ts), which surfaces these merged with
// LearningBadge rows in the Dossier's Learning & Growth Trajectory section
// only. This phase's report states the exact grep that verifies this holds.
model BenefitsNetworkCompletion {
  id          String                 @id @default(cuid())
  listingId   String
  listing     BenefitsNetworkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  completedAt DateTime               @default(now())
  note        String?                @db.Text

  createdAt DateTime @default(now())

  @@unique([listingId, candidateId])
  @@index([candidateId])
}

// ── Crucible (launchyournextchapter.com/crucible) ───────────────────────
// Standalone landing page + teaser AI-judgment challenge, Part A of a
// separate future two-part product — see the Crucible Part A build spec.
// Works for both anonymous visitors (no NextChapter account — tracked via
// a session-id cookie, candidateId stays null) and existing authenticated
// candidates (NC_NEWGRAD/NC_ASSESSMENT sources, candidateId populated from
// their real session). Deliberately does NOT reuse the onboarding
// anonymous-Supabase-auth-session pattern — that would create a real
// auth.users + CandidateProfile row for every throwaway teaser visitor,
// most of whom will never become NextChapter candidates. Real account
// creation only ever happens later, if/when someone converts via
// /crucible/full or the main site — never as a side effect of just taking
// the teaser.

enum CrucibleSource {
  LANDING
  NC_NEWGRAD
  NC_ASSESSMENT
}

// The raw "what kind of work are you going for?" pick (§10 addendum) — kept
// distinct from `variant` (the challenge actually routed to) since intent x
// score x degree-field is the flagship research query, and intent
// distribution alone tells us which discipline variant to build next.
enum CrucibleJobIntent {
  TECH
  MARKETING
  DATA
  DESIGN
  BUSINESS
  UNSURE
}

// The challenge actually served. Design/Business/Unsure route onto an
// existing variant (Design→marketing, Business→data, Unsure→code) rather
// than getting their own enum value — see the job-intent fork's routing
// table. One real scenario per variant today (DoorList promo bug / MIDNIGHT
// DROP / Promo memo) — a retry serves a DIFFERENT variant than the one just
// attempted, which is what "no repeat content" actually means until a
// second scenario per discipline exists.
enum CrucibleVariant {
  CODE
  MARKETING
  DATA
}

enum CrucibleSessionState {
  STARTED
  CHALLENGE
  PROMPT_TASK
  DATASET_TASK
  RESULTS_TASK
  TOOLS
  RESUME
  SCORED
}

enum CrucibleVerdict {
  SHIP
  BLOCK
  SHIP_WITH_CONDITIONS
}

// The difficulty ladder — every activity starts EASY; clearing a tier
// reveals the next tier's scenario for that same activity (see
// qaTierPassed/aiGradeTierPassed in scoring.ts).
enum CrucibleTier {
  EASY
  MEDIUM
  HARD
}

enum CrucibleBranch {
  PASS
  GROWTH
}

model CrucibleSession {
  id          String               @id @default(cuid())
  candidateId String?
  candidate   CandidateProfile?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // Captured upfront (right after the landing CTA, before the challenge)
  // for LANDING-sourced sessions — never required for NC-sourced sessions,
  // which already have a real candidate email on file.
  email       String?
  source      CrucibleSource       @default(LANDING)
  jobIntent   CrucibleJobIntent?
  variant     CrucibleVariant?
  state       CrucibleSessionState @default(STARTED)
  // Read once at session start (getClientIp(), same helper as
  // HomepageVisitEvent) — used only to rate-limit the two AI-graded
  // activities below, never displayed or used for anything else.
  ip          String?

  // QA judgment activity — string[] of CrucibleChecklistOption ids the
  // candidate selected, scored deterministically (see scoring.ts). Replaced
  // the original click-a-line-to-flag interaction, which testing showed was
  // unclear with no visible "what am I even looking for" cue.
  //
  // *Tier fields hold only the CURRENT/latest tier's inputs and score for
  // each activity — clearing a tier overwrites these with the next tier's
  // submission rather than archiving every intermediate attempt. What
  // matters for the hiring signal is the highest tier reached and that
  // tier's own result, not a full history of every round.
  selectedOptionIds Json?
  verdict           CrucibleVerdict?
  qaTier            CrucibleTier     @default(EASY)

  // Prompt-authoring activity — candidate writes a prompt to get an AI to
  // analyze/improve a fixed demo webpage. AI-graded (real per-attempt LLM
  // cost — see checkCrucibleAiRateLimit in rate-limit.ts).
  promptSubmission String?      @db.Text
  promptScore      Int?
  promptFeedback   String?      @db.Text
  promptTier       CrucibleTier @default(EASY)

  // Dataset-analysis activity — candidate is given business context + a
  // small dataset and asked to analyze/recommend. Also AI-graded.
  datasetSubmission String?      @db.Text
  datasetScore      Int?
  datasetFeedback   String?      @db.Text
  datasetTier       CrucibleTier @default(EASY)

  // Read-the-Results activity — a test already ran and the result looks
  // clean; candidate has to decide ship/kill/extend. AI-graded, single
  // scenario (no difficulty ladder yet, unlike the other three activities).
  resultsSubmission String? @db.Text
  resultsScore      Int?
  resultsFeedback   String? @db.Text

  // Real count of AI-grading calls made from this session (prompt + dataset
  // + results combined), incremented once per call regardless of tier or
  // pass/fail — the rate limiter (rate-limit.ts) sums this across a whole
  // IP's recent sessions rather than counting sessions themselves, since one
  // session clearing all 3 tiers of an activity now makes 3 real calls, not 1.
  aiGradeCallCount Int @default(0)

  // { tools: string[], bestMove: string }
  aiTools        Json?
  resumeFilePath String? // crucible-resumes bucket, leads/<uuid>.<ext> — same "service-role upload, never scored" pattern as ResumeSubmissionLead
  resumeFileName String?

  // Explicit opt-in — true only when a resume was uploaded AND the
  // candidate checked "share with employers" (CrucibleTestFlow's resume
  // step). The employer directory's whole visibility gate is exactly
  // branch=PASS AND resumeFilePath IS NOT NULL AND resumeShareConsent=true.
  resumeShareConsent   Boolean   @default(false)
  resumeShareConsentAt DateTime?

  score  Int?
  band   String?
  branch CrucibleBranch?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  retryOfId String?
  retryOf   CrucibleSession?  @relation("CrucibleRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries   CrucibleSession[] @relation("CrucibleRetry")

  interests           CrucibleInterest[]
  contestEntries      CrucibleContestEntry[]
  employerResumeViews CrucibleEmployerResumeView[]

  @@index([email])
  @@index([source])
  @@index([candidateId])
  @@index([branch, resumeShareConsent])
}

enum CrucibleInterestKind {
  FULL
  LESSON
}

// "Reserve my full assessment" / "Start the lesson" — both routes are Part A
// stubs (interest capture only, no real product behind them yet).
model CrucibleInterest {
  id        String               @id @default(cuid())
  sessionId String
  session   CrucibleSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      CrucibleInterestKind
  email     String
  createdAt DateTime             @default(now())

  @@index([kind])
  @@index([email])
}

// ── NEN employer portal ─────────────────────────────────────────────────
// The first authenticated portal under /crucible — everything above this
// point (CrucibleSession, CrucibleInterest) is anonymous, cookie-based. An
// employer is a real Supabase-auth'd user, resolved the same way every
// other portal in this app resolves its role (profile table + RoleGrant),
// deliberately NOT via /talent's EmployerProfile — that table carries
// paid-tier/Stripe fields and a dossier-unlock gate that don't apply to
// NEN's free, Crucible-pass-gated candidate pool, and reusing it would tie
// NEN back to a NextChapter-shaped product after this session's rebrand
// away from exactly that.

enum CrucibleFunctionInterest {
  TECH
  MARKETING
  DATA
  DESIGN
  BUSINESS
  GENERALIST
}

model CrucibleEmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique // Supabase auth id — v1 is single-owner-per-company, no seats/team yet
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName    String
  companyWebsite String?
  companySize    String? // "1-10" | "11-50" | "51-200" | "201-1000" | "1000+" — plain string, same convention as /talent's EmployerProfile.companySize
  contactName    String?

  functionInterest      CrucibleFunctionInterest?
  onboardingCompletedAt DateTime?

  contests    CrucibleContest[]
  resumeViews CrucibleEmployerResumeView[]

  @@index([functionInterest])
}

enum CrucibleContestState {
  DRAFT
  OPEN
  CLOSED
}

// Employer-posted business problem candidates can submit ideas against for
// a shot at a tailored paid hire. State is one-way (DRAFT -> OPEN ->
// CLOSED, no reopen) — the simplest thing that supports "post it, let
// qualified candidates respond, then review entries."
model CrucibleContest {
  id         String                  @id @default(cuid())
  employerId String
  employer   CrucibleEmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  title           String
  businessProblem String  @db.Text
  referenceFilePath String? // crucible-contest-files bucket, public-URL posture (employer knowingly shares it with candidates)
  referenceFileName String?

  targetFunction CrucibleFunctionInterest? // null = open to every PASS + resume-share-consented candidate, regardless of function
  state          CrucibleContestState      @default(DRAFT)

  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  closedAt    DateTime?

  entries CrucibleContestEntry[]

  @@index([employerId])
  @@index([state])
}

enum CrucibleContestEntryStatus {
  INVITED
  SUBMITTED
}

// One row per (contest, qualifying session) — created when the contest is
// published and an invite email goes out, not when the candidate actually
// responds. The row IS the invite: its cuid `token` is the entire access
// mechanism for a candidate with no persistent account, and the
// [contestId, sessionId] uniqueness below doubles as the notify
// dispatcher's idempotency claim (create-then-send), so publishing twice
// never double-invites anyone. Resubmission overwrites `submission` in
// place — no versioning, no edit-window timer.
model CrucibleContestEntry {
  id        String          @id @default(cuid())
  contestId String
  contest   CrucibleContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sessionId String
  session   CrucibleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  token String @unique @default(cuid())

  status CrucibleContestEntryStatus @default(INVITED)

  submission  String?   @db.Text
  submittedAt DateTime?
  openedAt    DateTime? // first time the candidate's link was actually opened
  emailSentAt DateTime? // null until the invite email actually sends successfully

  shortlisted   Boolean   @default(false) // employer's own manual flag for their review list — no AI ranking in v1
  shortlistedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, sessionId])
  @@index([contestId, status])
}

// Resume-view audit log AND the safeguard against an employer bulk-
// scraping the directory: one row per (employerId, sessionId), so
// re-viewing an already-seen candidate never counts twice against the
// rolling 24h view cap enforced in application code.
model CrucibleEmployerResumeView {
  id         String                  @id @default(cuid())
  employerId String
  employer   CrucibleEmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  sessionId  String
  session    CrucibleSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contestId  String? // set when the view happened from a contest's entry list, null when from the general directory
  viewedAt   DateTime                @default(now())

  @@unique([employerId, sessionId])
  @@index([employerId, viewedAt])
}
