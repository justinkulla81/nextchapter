}

// The 5x5 Support Network builder's categories — see "My Support Network"
// in the product spec.
enum ContactCategory {
  FORMER_COLLEAGUE
  HIRING_CONNECTION
  OWES_A_FAVOR
  RECENT_TRANSITION
  COULD_HELP_IN_RETURN
}

enum ContactWarmth {
  HOT
  WARM
  COLD
}

enum ContactSource {
  MANUAL
  CSV_IMPORT
  CALENDAR_IMPORT
  EMAIL_DETECTED
}

// Who this person is to the candidate — deliberately separate from
// ContactCategory above (that's "how this relationship might help my
// search"; this is "what role does this person actually have"). A contact
// can hold several at once (a former manager who is now also a recruiter),
// so it's a list, not a single select.
enum RelationshipTag {
  HIRING_MANAGER
  RECRUITER
  PROFESSIONAL_CONTACT
  FORMER_COLLEAGUE
  HELPING_ME
  COACH
  PERSONAL_FRIEND
  SAME_SCHOOL
  OTHER
}

// NextChapter admin's own follow-up status on a candidate-surfaced
// recruiter/coach/hiring-manager contact — see SupportNetworkContact's
// adminOutreachStatus comment for why this is a separate axis from
// anything the candidate sets.
enum ContactAdminOutreachStatus {
  NOT_REVIEWED
  TO_CONTACT
  CONTACTED
  NOT_INTERESTED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  PHONE
  TEXT
  // Auto-logged from a detected calendar networking-call/interview with
  // this contact — see addAttendeesToNetwork in sync-google-calendar.ts.
  MEETING
}

// "What's your biggest concern about reaching out?" — asked once, shapes
// which of the 9 outreach script variants (3 warmth x 3 anxiety tiers) a
// candidate sees. The 5 answer options map down to 3 tiers in
// src/lib/network/scripts.ts.
enum NetworkingAnxiety {
  SEEM_DESPERATE
  BURDEN_PEOPLE
  NOT_SURE_WHAT_TO_SAY
  NETWORK_NOT_STRONG
  DONT_LIKE_ASKING_FOR_HELP
  ALREADY_USED_UP_NETWORK
  OTHER
}

enum NetworkComfortLevel {
  VERY_COMFORTABLE
  SOMEWHAT_COMFORTABLE
  NOT_VERY_COMFORTABLE
  RATHER_NOT
}

// Comfort with PUBLIC visibility of being unemployed/searching (LinkedIn
// "Open to Work", public posts, etc.) — a distinct axis from
// NetworkComfortLevel above, which is about telling people you know
// directly, privately. Deliberately not merged: public-comfort and
// private-comfort don't necessarily move together (Prompt 53).
enum PublicDisclosureComfort {
  PRIVATE_ONLY
  CLOSE_CONTACTS_ONLY
  BECOMING_COMFORTABLE
  FULLY_COMFORTABLE
}

// Blockers and Motivations coaching-tone calibration (Search Strategy) —
// how Victoria should push, not what she should push toward. See
// CandidateProfile.coachingStylePreference/changePacePreference/changeReadiness.
