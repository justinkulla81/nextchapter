  TOUGH_LOVE
  GENTLE_ENCOURAGEMENT
  SOMEWHERE_IN_BETWEEN
}

enum ChangePacePreference {
  BABY_STEPS
  BIG_LEAPS
  SOMEWHERE_IN_BETWEEN
}

enum ChangeReadiness {
  NOT_LOOKING_FOR_BIG_CHANGE
  WANT_CHANGE_NOT_READY_YET
  WANT_CHANGE_AND_READY
}

// How recently a candidate was last networked/referred into a job —
// lightweight, not a detailed history capture (Prompt 53).
enum ReferralRecency {
  THIS_SEARCH
  PAST_TWO_YEARS
  LONGER_AGO
}

enum ContentVenue {
  LINKEDIN
  SUBSTACK
  CONFERENCES
  WEBINARS
  EXPERT_NETWORKS
  INSTAGRAM_FACEBOOK_YOUTUBE
  PODCAST
}

enum ApplicationChannel {
  COLD_APPLICATION // job board or company site, no personal connection
