// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum PrivacyTier {
  PUBLIC // Full name, photo, complete history visible to all
  SEMI_PUBLIC // First name + last initial, company names, role level
  PRIVATE // Fully anonymized signal only
  STEALTH // Visible only to pre-approved companies
  LOCKED // Invisible to all searches (building profile)
}

enum EngagementType {
  FULL_TIME
  FRACTIONAL
  INTERIM
  CONSULTING
  INTERNSHIP
}

// Highest degree completed — resume-derived (Phase 1), candidate-confirmable.
// Used for the education/outcome correlation on the admin metrics page.
enum HighestEducationLevel {
  SOME_COLLEGE
  ASSOCIATE
  BACHELORS
  MASTERS
  MBA
  MPH
  JD
  MD
  DO // Doctor of Osteopathic Medicine — same licensure track as MD
  PHARMD // Doctor of Pharmacy
  DDS // Doctor of Dental Surgery (DMD is the equivalent degree, same bucket)
  DVM // Doctor of Veterinary Medicine
  PSYD // Doctor of Psychology (licensed clinical psychologist track)
  PHD
  OTHER
}

// Computed from WorkHistoryEntry title-level changes over time (see
// detectCareerTrajectory in work-history-facts.ts) — null means there isn't
// enough work history yet to judge, never a guessed default.
enum CareerTrajectory {
  PROMOTED
  STABLE
  DEMOTED
}

enum CoachingFocus {
  CAREER
  LIFE
  EXECUTIVE
  EOS
  OTHER
}

enum EmploymentSituation {
  COMPANY_WIDE_LAYOFF
  DIVISION_ELIMINATED
  COMPANY_SHUTDOWN
  ACQUISITION_REDUNDANCY
  OFFSHORED_OUTSOURCED
  LEFT_TO_START_SOMETHING
  CAREGIVER_LEAVE
  SABBATICAL
  VALUES_MISALIGNMENT
  CAREER_PIVOT
  BURNOUT
  NEW_MANAGEMENT
  LEFT_DIFFICULT_ENVIRONMENT
  PERFORMANCE_SEPARATION
  COMPLICATED
  FIRST_ROLE
  RETURNING_AFTER_ABSENCE
  RELOCATED_FOR_FAMILY
  MEDICAL_LEAVE
  CURRENTLY_EMPLOYED_EXPLORING
}

enum SearchIntensity {
  ACTIVELY_SEARCHING
  CASUALLY_LOOKING
  EXPLORING
  OPEN
}

enum CurrentJobStatus {
  EMPLOYED_CONSIDERING_MOVE
  LAID_OFF
  RESIGNED
  CAREGIVER_LEAVE_SABBATICAL
  CAREER_PIVOT
  RELOCATED_FOR_FAMILY
  NEW_GRADUATE_FIRST_JOB
}

enum GapDurationBucket {
  ZERO_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  TWELVE_PLUS_MONTHS
}

// "When are you most ready to take action?" — controls daily email timing.
enum ActionWindow {
  MORNING // Plan and act in the morning
  NIGHT_PLAN_MORNING_ACT // Plan at night, act in the morning
  MIDDAY
  EVENING
  VARIABLE // No strong preference — default
}

enum Mood {
  STUCK
  GETTING_THERE
  MOVING
  FIRED_UP
}

enum ReferenceType {
  DIRECT_MANAGER
  SKIP_LEVEL_MANAGER
  PEER
  DIRECT_REPORT
  CLIENT
  VENDOR
  FACULTY_ADVISOR
  OTHER
}

enum ReferenceStatus {
  REQUESTED
  REMINDER_SENT
  COMPLETED
  DECLINED
  EXPIRED
}

// The 5x5 Support Network builder's categories — see "My Support Network"
// in the product spec.
enum ContactCategory {
  FORMER_COLLEAGUE
  HIRING_CONNECTION
  OWES_A_FAVOR
  RECENT_TRANSITION
  COULD_HELP_IN_RETURN
}

enum ContactWarmth {
  HOT
  WARM
  COLD
}

enum ContactSource {
  MANUAL
  CSV_IMPORT
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  PHONE
  TEXT
}

// "What's your biggest concern about reaching out?" — asked once, shapes
// which of the 9 outreach script variants (3 warmth x 3 anxiety tiers) a
// candidate sees. The 5 answer options map down to 3 tiers in
// src/lib/network/scripts.ts.
enum NetworkingAnxiety {
  SEEM_DESPERATE
  BURDEN_PEOPLE
  NOT_SURE_WHAT_TO_SAY
  NETWORK_NOT_STRONG
  DONT_LIKE_ASKING_FOR_HELP
  ALREADY_USED_UP_NETWORK
  OTHER
}

enum NetworkComfortLevel {
  VERY_COMFORTABLE
  SOMEWHAT_COMFORTABLE
  NOT_VERY_COMFORTABLE
  RATHER_NOT
}

// Comfort with PUBLIC visibility of being unemployed/searching (LinkedIn
// "Open to Work", public posts, etc.) — a distinct axis from
// NetworkComfortLevel above, which is about telling people you know
// directly, privately. Deliberately not merged: public-comfort and
// private-comfort don't necessarily move together (Prompt 53).
enum PublicDisclosureComfort {
  PRIVATE_ONLY
  CLOSE_CONTACTS_ONLY
  BECOMING_COMFORTABLE
  FULLY_COMFORTABLE
}

// How recently a candidate was last networked/referred into a job —
// lightweight, not a detailed history capture (Prompt 53).
enum ReferralRecency {
  THIS_SEARCH
  PAST_TWO_YEARS
  LONGER_AGO
}

enum ContentVenue {
  LINKEDIN
  SUBSTACK
  CONFERENCES
  WEBINARS
  EXPERT_NETWORKS
  INSTAGRAM_FACEBOOK_YOUTUBE
  PODCAST
}

enum ApplicationChannel {
  COLD_APPLICATION // job board or company site, no personal connection
  REFERRAL // someone at the company referred you
  RECRUITER_OUTREACH // a recruiter reached out to you
  WARM_NETWORK_INTRO // introduced through your network
  OTHER
}

enum NotificationTier {
  FULL // daily nudge every day
  ESSENTIALS // daily nudge twice a week (Mon/Thu) instead of daily
  MINIMAL // no recurring nudge — core/transactional emails only
}

enum JobReactionType {
  INTERESTED
  NOT_INTERESTED
  UNSURE
}

enum NotInterestedReason {
  WRONG_FUNCTION
  WRONG_INDUSTRY
  COMP_TOO_LOW
  SENIORITY_MISMATCH
  LOCATION_MISMATCH
  MISSING_EXPERIENCE
  COMPANY_UNATTRACTIVE
  DONT_FEEL_QUALIFIED
  WOULD_PURSUE_WITH_CONNECTION
}

enum EmployerTier {
  CHARTER // Free/minimal — product partners
  STANDARD // $200/mo
  PRO // $500-600/mo
}

enum EmployerSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum ShareRecipientType {
  HIRING_MANAGER
  RECRUITER
  COACH
}

enum CandidateInterestStatus {
  VIEWED
  SAVED
  INTEREST_EXPRESSED
  CANDIDATE_REVEALED
  IN_CONVERSATION
  HIRED
  PASSED
}

// ── CANDIDATE SIDE ───────────────────────────────────────────────────────────

model CandidateProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Privacy & Visibility
  privacyTier            PrivacyTier @default(LOCKED)
  // One-time bonus marker for confirming a privacy tier choice at all — same
  // shape as introCommittedAt/registrationCompletedAt below. Checked before
  // awarding PRIVACY_CONFIRMED so it only ever fires once per candidate.
  privacyOpenedUpBonusAt DateTime?

  // Recruiter database — explicit candidate opt-in required before appearing
  // in any employer-facing Talent match list. privacyTier alone is opt-out,
  // not opt-in, and isn't sufficient consent for a matching/ranking surface.
  recruiterDatabaseOptIn       Boolean   @default(false)
  recruiterDatabaseRequestedAt DateTime?

  // Step 2: "Which of these sounds like you" persona picker — sets
  // currentJobStatus via SITUATION_TO_JOB_STATUS the same way a homepage
  // situational-entry click does, so Part 1 below never re-asks it.
  desireComplete Boolean @default(false)

  // Part 1: Your Situation
  currentJobStatus   CurrentJobStatus?
  gapDuration        GapDurationBucket? // only asked if currentJobStatus != EMPLOYED_CONSIDERING_MOVE
  // DEPRECATED — question removed from Your Situation page (Batch 24); the
  // "how difficult has your search been" question below covers this signal
  // instead. Column kept (not dropped) only so existing historical answers
  // aren't destroyed — do not read this in new code.
  jobSearchIntensity Int? // 0-100 slider, "casually looking" -> "extremely"
  biggestBarriers    String[]           @default([]) // multi-select (select-all), "What do you think are the biggest barriers to get a new job?" — see BIGGEST_BARRIER_OPTIONS
  // "How actively are you searching right now?" — a distinct axis from
  // jobSearchDifficultyLevel (how hard the search feels vs. how actively
  // they're even looking). Feeds Victoria's directness calibration
  // (isCasuallySearching) and suppresses week-count urgency language for
  // non-active searchers.
  searchIntensity    SearchIntensity?

  // Admin-confirmed match to a LayoffCohort (candidate matching, not
  // self-selected) — set via /support/admin/layoff-cohorts, surfaces a
  // cohort-scoped view inside Community once assigned.
  layoffCohortId String?
  layoffCohort   LayoffCohort? @relation(fields: [layoffCohortId], references: [id])
  currentCity    String? // resume-derived (Phase 1), candidate-confirmable
  currentState   String?
  currentCountry String        @default("US")
  // Normalized metro-area bucket derived from currentCity/currentState (see
  // src/lib/constants/metro-areas.ts) — never authoritative, only used for
  // Community metro grouping. currentCity/currentState stay the source of truth.
  metroArea      String?

  // Part 1: Job search activity self-report — all optional, all self-reported.
  jobsAppliedBucket         String? // "0-20" | "20-100" | "100+"
  interviewsReceivedCount   Int?
  networkingLevel           Int? // 1-4: Not much / Some but should do more / A lot / Can't do more
  learnedNewSkillsLevel     Int? // 1-3: Not yet / A little / Yes, actively
  triedPartTimeOrConsulting Boolean?
  triedExecutiveCoaching    Boolean?
  connectedWithRecruiters   Boolean?
  recruiterConnectionCount  Int?

  // Part 2: Working Style — see QuadBlock/LikertItem/CandidateAssessmentResponse
  // below. Superseded the old -2..+2 self-rated sliders with an ipsative
  // forced-choice + Likert cross-validation instrument.

  // Part 3: Experience
  yearsExperience     Int? // resume-derived (Phase 1), candidate-confirmable
  highestLevelReached String? // "IC", "Manager", "Director", "VP", "C-Suite"
  primaryFunction     String? // resume-derived (Phase 1), candidate-confirmable
  industryContext     String? // resume-derived (Phase 1), candidate-confirmable
  // Optional — a recent function/industry that differs from the primary
  // above (e.g. a recent pivot). Resume-derived alongside the primary, or
  // set/edited/cleared by the candidate on Search Strategy. Folded into job
  // matching (job-fit-bucket.ts, ats-job-board-feed.ts) as an additional
  // match, never a replacement for the primary.
  secondaryFunction        String?
  secondaryIndustryContext String?
  // Normalized industry bucket derived from industryContext (see
  // src/lib/constants/industry-buckets.ts) — never authoritative, only used
  // for Community industry grouping. industryContext stays the source of truth.
  industryBucket      String?
  resumeKeywords      String[] @default([]) // resume-derived, read-only in UI — refreshed automatically on resume re-upload, not candidate-editable
  isPeopleManager     Boolean? // gates teamSizeManaged + managementSkillConfidence questions
  teamSizeManaged     Int? // 0 = IC, otherwise largest team managed
  topStrengths        String[] @default([]) // multi-select, choose up to 3, "Select up to 3 strengths that best describe where you truly stand out" — see TOP_STRENGTH_OPTIONS
  knownFor            String? // "How former colleagues would describe me" — required before requesting references

  // Executive Dossier Positioning Statement (Prompt 47) — AI-drafted from
  // profile/accomplishment data, but never published in the Dossier until
  // the candidate explicitly approves or edits it. positioningStatementText
  // null = not yet approved; the draft alone is never Dossier-eligible.
  positioningStatementDraft String?   @db.Text
  positioningStatementText  String?   @db.Text
  positioningStatementSetAt DateTime?

  // Cache for the Dossier's two genuinely per-view LLM generations
  // (proof-point follow-ups, job-reaction pattern summary). Unlike
  // positioningStatementDraft above — which self-caches on first draft —
  // these two used to re-generate on EVERY render of /dashboard/
  // recruiter-report, /dashboard/coach-dossier, and the coach's full client
  // view, making cost scale with page views instead of with real activity.
  // Regenerated only when the candidate explicitly asks (see
  // regenerateDossierSections in dashboard/recruiter-report/actions.ts), so
  // a stale-but-cheap read is the default and refreshing is a deliberate act.
  dossierGeneratedCache     Json?
  dossierGeneratedAt        DateTime?
  functionSkillConfidence   Int? // 0-100, 4-stop discrete scale ("Good" -> "Among the best in my field")
  aiFlexibilityLevel        Int? // 0-100, repurposed as AI-skill confidence slider, same 4-stop scale
  managementSkillConfidence Int? // 0-100, 4-stop "soft trait" scale, only asked if isPeopleManager
  actionOrientedConfidence  Int? // 0-100, 4-stop "soft trait" scale
  creativityConfidence      Int? // 0-100, 4-stop "soft trait" scale
  communicatorConfidence    Int? // 0-100, 4-stop "soft trait" scale
  jobSearchDifficultyLevel  Int? // 1-4, "How difficult has your job search been so far?"

  // Interview Prep — Comfort Check self-assessment (0-100 slider, same scale as the confidence fields above)
  storyComfort       Int?
  interviewComfort   Int?
  elevatorPitchReady Int?

  // Part 4: Goals
  remotePreference    String? // "remote" | "hybrid" | "onsite" | "flexible" — moved here from Part 1 (Batch 24)
  targetRoleType      String?
  targetIndustries    String[]
  targetFunction      String? // aspirational target function, PRIMARY_FUNCTION_OPTIONS — distinct from primaryFunction (current/resume-derived background)
  targetCompanySize   String?
  targetCompanyStage  String?
  targetCompMin       Int?
  compFlexible        Boolean  @default(false)
  willingToStartLower Boolean  @default(false)
  startLowerRationale String?
  openToRelocation    Boolean  @default(false) // moved here so it follows "willing to start at a lower level" — both are flexibility signals
  relocationNotes     String?
  equityImportant     Boolean  @default(false)
  dealBreakers        String?

  // Hireability Assessment (Prompt 53) — feeds Market Reality Grade
  // (Prompt 46) and the Coach Dossier's Coaching Notes (Prompt 54); never
  // the external Executive Dossier (Prompt 47).
  publicDisclosureComfort PublicDisclosureComfort?
  hasBeenReferredBefore   Boolean?
  referralRecency         ReferralRecency?

  // Search Strategy — a standalone, editable-anytime setup step. Search
  // Stage itself isn't stored here — it's derived from currentJobStatus +
  // gapDuration, see searchStage() in src/lib/search-strategy.ts.
  applicationVolumeGoal     Int? // target applications per week
  isPivoting                Boolean   @default(false) // orthogonal to currentJobStatus — e.g. LAID_OFF + pivoting functions
  skillsStillNeeded         String?
  interimConsultingInterest Boolean   @default(false)
  searchStrategyConfirmedAt DateTime?

  // Resume auto-fill (Phase 1) — unconfirmed until candidate confirms via action plan
  firstName               String?
  lastName                String?
  phone                   String?
  streetAddress           String?
  graduationDate          DateTime?
  resumeFirstJobStartDate DateTime?
  resumeLatestJobTitle    String?
  resumeAiReadinessScore  Int?
  resumeAiReadinessNotes  String?
  // Highest degree completed — resume-derived, candidate-confirmable (same
  // convention as primaryFunction/industryContext above). Feeds the
  // education/outcome correlation on the admin metrics page.
  highestEducationLevel   HighestEducationLevel?
  // Individual credential flags — distinct from highestEducationLevel
  // (which only ever holds ONE value) because a candidate can legitimately
  // hold multiple professional credentials (e.g. a JD/MBA dual degree).
  // Resume-derived (inferred from EducationEntry.degree text), candidate-
  // confirmable. hasJD/hasMD in particular are load-bearing for job-fit
  // gating — e.g. never surfacing a law-firm "Partner"/attorney posting to
  // a candidate without hasJD, while still surfacing that firm's
  // non-lawyer roles to everyone (see job-fit-bucket.ts credential gate).
  hasMBA                  Boolean                @default(false)
  hasJD                   Boolean                @default(false)
  hasMD                   Boolean                @default(false)
  // Same licensure track as MD (job postings routinely phrase the
  // requirement as "MD or DO") — job-fit gating treats hasMD || hasDO as
  // "licensed physician." PharmD/DDS/DVM/PsyD don't get their own gating
  // flags yet — no pharmacist/dentist/vet/psychologist posting volume on
  // this platform today — but are captured via highestEducationLevel for
  // accurate education data and the admin correlation view.
  hasDO                   Boolean                @default(false)

  // Structural Market Reality signals, computed from WorkHistoryEntry (see
  // computeStructuralFlags in src/lib/resume/compute-structural-flags.ts) —
  // recomputed on resume upload and on any manual work-history edit, never
  // hand-set by the candidate. Feed the ownership category (hireability-grade.ts)
  // and the corresponding named reasons (named-reasons.ts).
  jobHoppingFlag   Boolean           @default(false)
  shortTenureCount Int               @default(0)
  careerTrajectory CareerTrajectory? // null = not enough work history yet to judge

  // A single free-text explanation the candidate can write for a real
  // employment gap ("what I learned/accomplished, why I haven't gone
  // stale") — one field, not per-gap, since most candidates have one gap
  // worth explaining. Only ever shown externally when both this toggle AND
  // the specific /share/[token] recipient's own toggle are on (see
  // CreateShareForm.tsx / profile-share.ts) — never shown by default.
  gapExplanation                 String? @db.Text
  includeGapExplanationInDossier Boolean @default(false)

  // Action-plan-only questions (not asked during onboarding)
  lastSalary        Int?
  workAuthorization String?
  visaStatus        String?

  // Action-plan confirmation tracking
  profileConfirmedAt  DateTime?
  industryConfirmedAt DateTime?
  functionConfirmedAt DateTime?
  salaryConfirmedAt   DateTime?
  workAuthConfirmedAt DateTime?

  // LinkedIn & job-search behaviors
  linkedInUrl               String?
  linkedInConfirmedAt       DateTime? // set once candidate provides a URL or explicitly says they don't have one yet — mandatory first action-plan item
  networkingListSubmittedAt DateTime? // "25 people" networking assignment
  askedForHelpAt            DateTime?

  // Content-page unlock gates
  // Prompt 72 — replaced the old free-text "biggest financial pressure"
  // question with a structured multi-select so the action plan below can
  // be generated deterministically (branch on real values) instead of
  // parsed from an LLM reading of free text. benefitsPressureOtherText is
  // only used when 'OTHER' is one of the selected values.
  benefitsPressures                String[]       @default([])
  benefitsPressureOtherText        String?
  // Which action-plan item ids the candidate has checked off — plain
  // completion tracking, not a Search Action, so no points/effort fields.
  benefitsActionPlanCompletedItems String[]       @default([])
  gigDirectoryUnlockAnswer         String? // target rate/openness question — gates the Gig Directory
  // One-time points award for answering the Gig Directory unlock question — mirrors privacyOpenedUpBonusAt
  gigDirectoryUnlockBonusAt        DateTime?
  interimOfferDefinition           String?        @db.Text // "what specific expertise are you offering" — Interim Launch Plan phase 2
  interimOutreachStartedAt         DateTime? // manual self-report — Interim Launch Plan phase 6 (no external signal to derive this from)
  contentComfortLevel              Int? // 0-100, 4-stop scale — "how comfortable are you sharing your thoughts publicly?", gates My Marketing Plan
  contentVenues                    ContentVenue[] @default([])
  // One-time points award for answering the Marketing Plan unlock question — mirrors privacyOpenedUpBonusAt
  contentUnlockBonusAt              DateTime?
  linkedinOpennessComfort          Int? // 0-100, 4-stop scale — "how do you feel about being open about your job search?", gates the LinkedIn post generator
  linkedinUsageFrequency           String? // "daily" | "weekly" | "rarely" | "never" — same gate
  linkedinProfileUpToDate          Boolean? // same gate
  // One-time points award for answering the LinkedIn unlock gate — mirrors privacyOpenedUpBonusAt
  linkedinUnlockBonusAt             DateTime?
  activeJobDescription             String?        @db.Text // pasted job posting, grounds all Interview Prep generation — persisted, editable anytime
  workSampleType                   String? // "writing" | "code" | "design" | "other" | "none" — portfolio-type gate; "none" hides the Work Samples section/nav entirely
  // One-time points award for answering the work-sample-type gate — mirrors privacyOpenedUpBonusAt
  workSampleTypeBonusAt             DateTime?
  substackHasAccount               Boolean? // null = not asked yet; gates the Substack Article/White Paper generator either way once answered
  substackUrl                      String?
  substackCritique                 Json? // { relevanceToBackground, noveltyOfIdeas, cadence, overallAssessment }
  substackAnalyzedAt               DateTime?

  // Daily loop — mood check-in + daily Victoria email
  actionWindow             ActionWindow     @default(VARIABLE) // "When are you most ready to take action?" — controls daily email send timing
  currentStreak            Int              @default(0) // consecutive days with a mood check-in
  longestStreak            Int              @default(0)
  lastCheckInAt            DateTime?
  moodCardDismissedAt      DateTime? // when the "How motivated are you today?" card's X was last clicked — resets daily, see startOfUTCDay
  lastDailyEmailSentAt     DateTime?
  dailyEmailOptedOut       Boolean          @default(false)
  weeklyReportOptedOut     Boolean          @default(false) // opt-out for the Friday gap nudge + Community & Coaching digest (the "Sunday Night Report" this was originally named for was retired before it ever shipped — this field was repurposed rather than left dead)
  sprintGoalEmailsOptedOut Boolean          @default(false) // the 3-email Weekly Search Sprint goal-setting reminder sequence
  marketDigestOptedOut     Boolean          @default(false) // the new Weekly Market Digest — own flag, deliberately not folded into weeklyReportOptedOut above
  notificationTier         NotificationTier @default(FULL)

  // TCPA-compliant SMS opt-in — deliberately separate from the resume-extracted
  // `phone` field above and from email preferences; SMS consent must be its
  // own explicit opt-in, never inferred. smsConsentedAt null = never send SMS.
  smsPhone       String?
  smsConsentedAt DateTime?

  // The Circle — community support + recognition
  aListOptOut              Boolean @default(false) // opt out of A-List name recognition specifically
  encouragementGivingOptIn Boolean @default(false) // opted in to occasional prompts to send support notes

  // Support Network / outreach
  networkComfortLevel       NetworkComfortLevel? // one-time comfort check, gates the rest of Activate My Network
  networkingConcerns        NetworkingAnxiety[]  @default([])
  networkConnectPreferences String[]             @default([])

  // Forced Tradeoff Rankings (1-10, lower = higher priority)
  priorityMaxComp     Int?
  priorityBrandName   Int?
  priorityJobSecurity Int?
  priorityWorkLife    Int?
  priorityMission     Int?

  // Display fields (computed from privacy tier)
  displayName    String? // Set based on privacy tier
  displayCompany String?

  // Profile picture — candidate-controlled, shown only in person-to-person
  // surfaces (messaging, A-List/badge recognition). Deliberately never
  // selected into hireability-report.ts, dossier-sections.ts,
  // hiring-manager-report.ts, or recruiter-report.ts: showing a photo to a
  // hiring manager alongside a candidate's grade/report would invite bias
  // accusations, so those generators must keep sourcing name-only display
  // fields, never this one.
  profilePictureUrl     String?
  profilePictureVisible Boolean @default(true)

  // Onboarding completion tracking
  part1Complete         Boolean   @default(false)
  part2Complete         Boolean   @default(false)
  part3Complete         Boolean   @default(false)
  part4Complete         Boolean   @default(false)
  assessmentComplete    Boolean   @default(false)
  assessmentCompletedAt DateTime? // set alongside assessmentComplete — used for reminder cadence math
  contractAccepted      Boolean   @default(false)
  contractAcceptedAt    DateTime?
  introCommittedAt      DateTime? // set once the candidate finishes the post-signup welcome/payoff page and clicks "I'm committed" — gates dashboard access, backs its 5-point Search Sprint bonus

  // Deferred signup (resume-first onboarding, account creation last)
  email                     String? // resume-extracted (or candidate-edited); NOT the Supabase auth email until registration completes
  resumeStepComplete        Boolean   @default(false)
  registrationCompletedAt   DateTime? // set once the anonymous->permanent auth conversion completes
  passwordSetAt             DateTime? // set once a password or Google identity is attached — registrationCompletedAt alone doesn't mean the account has a durable way back in
  duplicateEmailBlockedAt   DateTime? // set instead of registrationCompletedAt when the now-confirmed email already belongs to another registered account — see findExistingRegisteredAccount()
  // Claims the "no report exists yet, go generate one" window in resolveLatestReport()
  // so two near-simultaneous /dashboard loads (or a registration load racing a later
  // load) can't both pass the check and each generate + email a duplicate report.
  // Treated as stale after REPORT_GENERATION_CLAIM_STALE_MS — see report-generation-lock.ts.
  reportGenerationClaimedAt DateTime?
  lastReminderSentAt        DateTime?
  reminderEmailCount        Int       @default(0)
  reminderEmailsOptedOut    Boolean   @default(false)

  // Relations
  workHistory                  WorkHistoryEntry[]
  educationHistory             EducationEntry[]
  references                   Reference[]
  referenceQuotes              ReferenceQuote[]
  claimedEmployerReferences    EmployerReferenceSubmission[]
  jobClickEvents               JobClickEvent[]
  workSamples                  WorkSample[]
  interviewResponses           InterviewResponse[]
  peerNominations              PeerNomination[]
  learningBadges               LearningBadge[]
  employerInteractions         CandidateInteraction[]
  approvedEmployers            ApprovedEmployer[]
  assessmentResults            AssessmentResult[]
  assessmentResponses          CandidateAssessmentResponse[]
  resumes                      Resume[]
  jobPostings                  JobPosting[]
  communityPosts               CommunityPost[]
  expressedInterests           CommunityPostInterest[]
  hireabilityReports           HireabilityReport[]
  linkedInActivityLogs         LinkedInActivityLog[]
  coachConversation            CoachConversation?
  narratives                   CandidateNarrative[]
  coachingWaitlistEntries      CoachingWaitlist[]
  guideLeadEntries             GuideLead[]
  bountyClaims                 BountyClaim[]
  dailyCheckIns                DailyCheckIn[]
  weeklySprints                WeeklySprint[]
  sundayNightReports           SundayNightReport[]
  weeklyBadgesEarned           WeeklyBadgeEarned[]
  marketRealitySnapshots       MarketRealitySnapshot[]
  encouragementNotesSent       EncouragementNote[]           @relation("EncouragementSent")
  encouragementNotesReceived   EncouragementNote[]           @relation("EncouragementReceived")
  supportNetworkContacts       SupportNetworkContact[]
  outreachLogs                 OutreachLog[]
  surfacedJobs                 SurfacedJob[]
  jobBoardIntroRequests        JobBoardIntroRequest[]
  candidateJobBoardSubmissions ExclusiveJobPosting[]
  pivotIdeas                   PivotIdea[]
  marketResponseLogs           MarketResponseLog[]
  profileShares                ProfileShare[]
  interimMarketplaceSignups    InterimMarketplaceSignup[]
  partnerClickThroughs         PartnerClickThrough[]

  // Prompt 69 — optional EEOC self-ID. Every field defaults unanswered
  // (null); PREFER_NOT_TO_ANSWER is a distinct explicit answer, not the
  // same as never having visited the section. HARD GUARDRAIL: these four
  // fields must never be read by any candidate-facing feature (job board,
  // Job Fit, Interim Work, Victoria, anything) — read only by the
  // admin-only bias-detection dashboard (src/lib/admin/bias-detection.ts),
  // which enforces a server-side minimum-cohort-size suppression before
  // returning any aggregate built from these fields.
  eeocGenderIdentity   EeocGenderIdentity?
  eeocRaceEthnicity    EeocRaceEthnicity?
  eeocDisabilityStatus EeocYesNoDecline?
  eeocVeteranStatus    EeocYesNoDecline?
  eeocRespondedAt      DateTime?

  // Coach P0-lite — set once, at profile creation, when the candidate came in
  // through a coach's personal invite link. Never re-assigned afterward (an
  // existing candidate clicking a coach link doesn't get silently re-tagged).
  coachId       String?
  coach         Coach?         @relation(fields: [coachId], references: [id])
  coachSessions CoachSession[]

  // Recruiter candidate book — set once, at profile creation, when the
  // candidate came in through a recruiter's sourced-candidate invite. Same
  // write-once invariant as coachId above; a candidate can have both a coach
  // and a sourcing recruiter simultaneously, they're independent.
  sourcingRecruiterId String?
  sourcingRecruiter   Recruiter?        @relation(fields: [sourcingRecruiterId], references: [id])
  sourcedCandidate    SourcedCandidate?

  messageThreads MessageThread[]

  // Coach-Candidate Matching System, Phase 1 — captured once, when the
  // candidate requests a match (see generateCoachShortlist in
  // src/lib/coach/matching.ts). All optional; every one defaults to "no
  // preference" rather than forcing a choice.
  coachGenderPreference             String?
  coachCommunicationStylePreference String? // 'direct' | 'context_first' — no reusable existing field for this despite what earlier design notes assumed
  coachLanguagePreference           String?
  coachTimezonePreference           String?

  // Mandatory, specific consent gate (Prompt 54) before a coach can see the
  // Executive Dossier or Coaching Notes — being assigned a coachId is NOT
  // sufficient on its own. Null = no coach-side access to either document,
  // full stop; every read path checks this explicitly. Cleared whenever the
  // candidate disconnects their coach (see disconnectCoach action), which is
  // what "revoke access" means in this codebase since coachId itself is
  // otherwise never reassigned.
  coachDossierConsentedAt DateTime?

  // Prompt 60 — set once the candidate completes the Coaching Onboarding
  // Form; its mere existence is the "already submitted" check everywhere.
  coachingOnboardingResponse CoachingOnboardingResponse?

  resumeSubmissionLeads ResumeSubmissionLead[]
  messageDismissals     CandidateMessageDismissal[]

  // Support Network nav badge — "how many new things since I last opened
  // this" needs a baseline. Defaults to now() so existing candidates don't
  // see a surprise flood of historical activity counted as unread the
  // moment this field ships; it only starts counting forward from here.
  communityLastViewedAt DateTime @default(now())

  // Prompt 62 — job-board usage check-in (Find a Job / Job Fit page).
  // jobBoardUsage: { linkedin, indeed, theladders, company_pages } -> 'daily' | 'few_times_week' | 'rarely' | 'never'
  // ZipRecruiter was dropped — its posting mix skews well below the level
  // this platform's candidates target, so asking about it implied we'd
  // recommend it. TheLadders replaced it as the executive-focused board.
  jobBoardUsage             Json?
  jobBoardUsageOther        String? // free text — boards we don't list (e.g. Otta, Built In, an industry board)
  jobBoardUsageNudgeShownAt DateTime? // caps the Victoria nudge to once/week
  jobBoardUsageBonusAt      DateTime? // one-time points award for answering, mirrors privacyOpenedUpBonusAt

  // Scoring Model 2.0 — persisted per-category baseline (Record<CategoryKey,
  // number>, 0-100 each). The weekly grade is baseline + a bounded weekly
  // performance nudge, NOT a full live recompute — this is the state that
  // carries forward week to week. Null until the first grade computation
  // backfills it. Only changes via a rewrite-action event (see
  // src/lib/scoring/rewrite-actions.ts) or a full assessment retake, never
  // on ordinary page reads.
  categoryBaselineScores    Json?
  categoryBaselineUpdatedAt DateTime?

  @@index([privacyTier])
  @@index([currentJobStatus])
  @@index([currentState, currentCity])
}

// Prompt: Portfolio — a candidate can hold several distinct narratives (e.g.
// "Why I'm leaving finance for product", "The RIF story"), not just one.
// The earliest-created row per candidate ("My Story") stays the one Interview
// Prep and the Guides unlock-gate read by default, so that existing single-
// narrative UX keeps working unchanged; everything past the first is a
// portfolio-only addition.
model CandidateNarrative {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  label         String @default("My Story") // candidate-facing name for this narrative/scenario
  coreStatement String // 2-3 sentence "Core Narrative Statement", candidate-editable
  adaptations   Json // {linkedinHeadline, linkedinAbout, resumeSummary, emailOpening, verbal30s, tellMeAboutYourself}

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([candidateId, generatedAt])
}

model WorkHistoryEntry {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyName     String
  companyIndustry String?
  roleTitle       String
  startDate       DateTime
  endDate         DateTime? // null = current
  isCurrent       Boolean              @default(false)
  teamSize        Int?
  managedPeople   Boolean              @default(false)
  keyAchievement  String?
  departureReason EmploymentSituation?
  verified        Boolean              @default(false)
  verifiedBy      String?

  // Never rendered as a qualifier on external-facing documents (Recruiter
  // Report, What They See) — see sanitizeRoleTitle() — but tracked so the
  // candidate can flag it and so concurrent fractional/interim engagements
  // can be collapsed to one displayed at a time via isPrimaryEngagement.
  engagementType      EngagementType @default(FULL_TIME)
  isPrimaryEngagement Boolean        @default(false)

  // Re-verification for active fractional/interim engagements (Prompt 51) —
  // Victoria checks in roughly every 30 days (or at expectedEndDate, if
  // given) asking "still doing this work?" so isCurrent/endDate stay
  // accurate — the resume's "one active engagement at a time" rule
  // (sanitize.ts) depends on this being current, not stale.
  expectedEndDate DateTime?
  nextReverifyAt  DateTime?

  // Normalized via normalizeOrgName() (src/lib/text/org-name-match.ts) —
  // used for company-group membership on Community and for resume-parsing
  // dedup, so "Google" and "Google LLC" collapse to the same group instead
  // of fragmenting. Backfilled for pre-existing rows by
  // scripts/backfill-profile-buckets.ts.
  companyNameNormalized String  @default("")
  // True only for rows written by the resume-parsing sync (never for
  // manually-entered rows) — lets that sync tell its own rows apart from
  // candidate-typed ones without a separate join table.
  resumeDerived         Boolean @default(false)

  @@index([candidateId])
  @@index([companyNameNormalized])
}

// Structured, one-row-per-degree education history — mirrors WorkHistoryEntry's
// conventions exactly. Supports multiple degrees per candidate (undergrad +
// MBA at different schools, etc.); isPrimary marks the one that represents
// them for the alma-mater exec-ed lookup (Learning page) and the alumni
// community group.
model EducationEntry {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Normalized to the parent institution only (e.g. "Harvard University",
  // never "Harvard Kennedy School") — both the resume-extraction prompt and
  // schoolNameNormalized enforce this, so exec-ed lookup and alumni grouping
  // never fragment by sub-school/department.
  schoolName           String
  schoolNameNormalized String
  degree               String?
  fieldOfStudy         String?
  startDate            DateTime? // nullable — resumes routinely omit this
  graduationDate       DateTime?

  // Exactly one row per candidate should end up primary — see
  // syncResumeEducation() for the tie-break rule (most recent graduation
  // date wins, then degree rank, then first-listed).
  isPrimary     Boolean @default(false)
  resumeDerived Boolean @default(false)
  verified      Boolean @default(false)
  verifiedBy    String?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([schoolNameNormalized])
}

model Reference {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  refereeEmail         String
  refereeName          String
  refereeTitle         String?
  refereeCompany       String?
  relationshipType     ReferenceType
  yearsWorkedTogether  Int?
  verifiedRelationship Boolean         @default(false)
  status               ReferenceStatus @default(REQUESTED)
  requestedAt          DateTime        @default(now())
  completedAt          DateTime?
  token                String          @unique @default(cuid())

  // Behavioral ratings (1-5 scale)
  ratingReliability   Int?
  ratingCommunication Int?
  ratingConflictNav   Int?
  ratingTeamLift      Int?
  ratingWorkEthic     Int?
  ratingGrowthMindset Int?
  ratingPositivity    Int?
  overallRating       Int?

  // Qualitative (shown to employers in summary only)
  strengthSummary   String?
  growthAreaSummary String?
  wouldHireAgain    Boolean?
  contextNotes      String?

  // Candidate-initiated dispute/correction, before this reference is ever
  // shared in a Certified Executive Dossier. A disputed-and-unresolved
  // reference is excluded from it — see getRecruiterReportData.
  candidateDisputeNote String?
  candidateDisputedAt  DateTime?
  disputeResolvedAt    DateTime?

  // BARS ratings per dimension (1-5 scale with behavioral anchors)
  // Used to compute CandidateAssessmentResponse.referenceDelta — see
  // src/lib/scoring/reference-delta.ts.
  barsVelocity          Int? // 1=deliberate, 5=urgent
  barsArchitecture      Int? // 1=creates playbook, 5=executes
  barsStructure         Int? // 1=needs clarity, 5=thrives in ambiguity
  barsCommunication     Int? // 1=async, 5=sync
  barsEnvironment       Int? // 1=deep focus, 5=constant collab
  barsLeadership        Int? // 1=coaching, 5=direct/blunt
  barsOversight         Int? // 1=hands-off, 5=micromanagement
  barsCommitment        Int? // 1=protects hours, 5=whatever it takes
  barsConscientiousness Int? // 1=flexible with process, 5=rigorous with detail

  // Reference Testimony Intake (Dossier Prompt 48) — five reference-only
  // character traits, deliberately NOT mirrored from Working Style's 9
  // neutral either-direction dimensions (Velocity, Structure, etc. don't
  // read as virtues on an external reference form). Each 1-5 rating pairs
  // with a required one-example text, same "give one example" spec as the
  // original prompt. Used for the Dossier's "confirmed by N of M
  // references" callout via testimony-processing.ts's strength-to-trait
  // mapping against the candidate's self-identified topStrengths.
  traitAdaptabilityRating   Int?
  traitAdaptabilityExample  String? @db.Text
  traitFollowThroughRating  Int?
  traitFollowThroughExample String? @db.Text
  traitPresenceRating       Int?
  traitPresenceExample      String? @db.Text
  traitCollaborationRating  Int?
  traitCollaborationExample String? @db.Text
  traitComposureRating      Int?
  traitComposureExample     String? @db.Text

  // Open-ended, reference-only questions (never asked of the candidate) —
  // raw material for Victoria's themed pull-quote drafts (ReferenceQuote).
  superpowerText           String? @db.Text
  underPressureStory       String? @db.Text
  definingStory            String? @db.Text // "one story that shows who they are, not just what they did"
  wouldWorkWithAgainReason String? @db.Text

  // null = not yet answered; true = ok to quote with name/title in the
  // Dossier; false = "available on request" only, never printed verbatim.
  quotableWithAttribution Boolean?

  quotes ReferenceQuote[]

  @@index([candidateId, status])
  @@index([token])
}

// Victoria-drafted, themed pull-quote sourced from a reference's open-ended
// answers — MANDATORY candidate approval gate before it can appear in the
// Dossier (Prompt 47/48's "never auto-publish a reference's words" rule).
// approvedByCandidateAt null = not yet Dossier-eligible; rejectedAt set =
// candidate removed it, never resurface.
model ReferenceQuote {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  referenceId String
  reference   Reference        @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  theme     String // e.g. "Under pressure", "Developing people", "Raising the bar"
  quoteText String @db.Text

  approvedByCandidateAt DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([candidateId, approvedByCandidateAt])
}

model WorkSample {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title            String
  description      String
  problemStatement String?
  candidateRole    String?
  outcome          String?
  sampleType       String // "case_study" | "writing" | "code" | "design" | "presentation" | "other"
  fileUrl          String?
  externalUrl      String?
  verified         Boolean  @default(false)
  verifiedByEmail  String?
  createdAt        DateTime @default(now())

  @@index([candidateId])
}

model InterviewResponse {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  questionId      String // References question bank
  questionText    String
  responseType    String // "text" | "audio" | "video"
  responseText    String?
  responseFileUrl String?
  aiSignalScore   Int? // Internal scoring 1-100
  aiSignalNotes   String? // Internal notes on response quality
  feedback        Json? // candidate-facing: {usesStarStructure, lengthNote, strengths, improvements}
  createdAt       DateTime @default(now())

  @@index([candidateId])
}

model PeerNomination {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  nominatorEmail      String
  nominatorName       String
  nominatorPlatformId String? // If nominator is also on NextChapter
  traitNominated      String // "cross-functional leadership" | "mentorship" | etc.
  context             String?
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([candidateId])
}

model LearningBadge {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  badgeType       String // "course_completed" | "certification" | "ai_project" | "conference_talk" | "published"
  title           String
  provider        String?
  description     String?  @db.Text // what was built/produced — only "ai_project" badges use this today
  judgmentCall    String?  @db.Text // "ai_project" only — the specific judgment call the candidate made while directing the AI (not just "completed a course"); the AI Fluency signal for Market Reality named reasons and the Dossier's AI Fluency section
  completedAt     DateTime
  verificationUrl String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([candidateId])
}

model AssessmentResult {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  assessmentType   String // "big_five" | "holland" | "high5" | "work_style"
  rawScores        Json // Raw instrument scores
  translatedOutput Json // Plain-English outputs for employer reports
  completedAt      DateTime @default(now())

  @@index([candidateId])
}

// ── WORK STYLE ASSESSMENT (quad-block / Likert / BARS) ─────────────────────
// First-pass, unvalidated instrument — see src/lib/scoring/assessment-vectors.ts
// for the scoring algorithm and its documented limitations.

model QuadBlock {
  id            String               @id @default(cuid())
  blockNumber   Int
  rotationGroup Int                  @default(1)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  statements    QuadBlockStatement[]
}

model QuadBlockStatement {
  id                      String    @id @default(cuid())
  blockId                 String
  block                   QuadBlock @relation(fields: [blockId], references: [id])
  dimension               String // "velocity" | "architecture" | "structure" | "communication" | "environment" | "leadership" | "oversight" | "commitment"
  pole                    String // "high" or "low" on that dimension
  statementText           String
  socialDesirabilityScore Float // Should be balanced 3.8-4.2 across all 4 in block
}

model LikertItem {
  id                  String  @id @default(cuid())
  dimension           String // Maps to same 8 dimensions
  pole                String // Which end of the dimension this probes
  itemText            String
  isReversed          Boolean @default(false) // If true, scoring is inverted
  targetedFriction    String // What specific anxiety or friction this surfaces
  pairedQuadDimension String // Which quad-block dimension this validates against
  rotationGroup       Int     @default(1)
  isActive            Boolean @default(true)
}

model CandidateAssessmentResponse {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())

  // Layer 1: Quad-block responses
  quadResponses Json // Array of {blockId, mostLikeMe: statementId, leastLikeMe: statementId}

  // Layer 2: Likert responses
  likertResponses Json // Array of {itemId, score: 1-5}

  // Computed vectors
  dimensionVectors Json // {velocity: -2..+2, architecture: -2..+2, ...}

  // Inconsistency Index
  inconsistencyScore   Float?
  inconsistencyPairs   Json? // Which specific pairs triggered variance
  manipulationRiskFlag Boolean @default(false)
  flagThreshold        Float? // The SD value that triggered flag, if any

  // Reference delta — populated by src/lib/scoring/reference-delta.ts once
  // both this response and at least one BARS-scored reference exist.
  referenceDelta   Json? // Candidate vector vs reference BARS aggregate
  frictionSurfaces String[] // Dimensions where delta > threshold — shown to employers

  @@index([candidateId])
}

model BARSAnchor {
  id         String  @id @default(cuid())
  dimension  String
  scalePoint Int // 1-5
  anchorText String // Specific observable behavior at this scale point
  isActive   Boolean @default(true)
}

model ApprovedEmployer {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    EmployerProfile  @relation(fields: [employerId], references: [id])
  approvedAt  DateTime         @default(now())

  @@unique([candidateId, employerId])
}

// ── EMPLOYER SIDE ────────────────────────────────────────────────────────────

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName     String
  companyWebsite  String?
  companySize     String? // "1-10" | "11-50" | "51-200" | "201-1000" | "1000+"
  companyStage    String? // "startup" | "growth" | "enterprise" | "non-profit" | "government"
  companyIndustry String?
  logoUrl         String?
  contactName     String?
  isSampleData    Boolean @default(false)

  // Personal profile picture for the hiring-manager user (distinct from the
  // company logoUrl above) — shown in messaging only, subject to
  // profilePictureVisible. Never surfaced to candidates elsewhere.
  profilePictureUrl     String?
  profilePictureVisible Boolean @default(true)

  // No-Ghosting Commitment — signup-time acknowledgment only (P0). The
  // response-rate/badge tracking system this later feeds is P1/P2, not built.
  noGhostingCommitmentAccepted   Boolean   @default(false)
  noGhostingCommitmentAcceptedAt DateTime?

  // Subscription
  subscriptionTier      EmployerTier               @default(CHARTER)
  subscriptionStatus    EmployerSubscriptionStatus @default(TRIALING)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  // Charter employer fields
  isCharterEmployer       Boolean @default(false)
  charterCommitmentSigned Boolean @default(false)
  charterFeedbackNotes    String?

  // Pro culture assessment (required for Pro tier matching)
  cultureAssessmentComplete Boolean   @default(false)
  culturePacePreference     Int?
  cultureFeedbackStyle      Int?
  cultureCollabStyle        Int?
  cultureStructureLevel     Int?
  cultureAmbiguityLevel     Int?
  cultureHoursExpectation   Int?
  cultureManagementStyle    Int?
  cultureAttritionRate      Float?
  cultureHonestyDeclaration Json? // What they offer more/less of vs market
  cultureVerifiedAt         DateTime?

  marketDigestOptedOut Boolean @default(false)

  // Relations
  savedSearches         SavedSearch[]
  roleProfiles          RoleProfile[]
  candidateInteractions CandidateInteraction[]
  approvedCandidates    ApprovedEmployer[]
  jobBoardSubmissions   ExclusiveJobPosting[]
  seats                 EmployerSeat[]
  messageThreads        MessageThread[]

  @@index([subscriptionTier, subscriptionStatus])
}

// Team seats, additive to the original single-owner EmployerProfile.userId
// (which stays the account owner and keeps working through its existing
// direct lookup, unaffected by whether any seats exist). userId is null
// until the invited person accepts and links their own Supabase account.
model EmployerSeat {
  id         String           @id @default(cuid())
  employerId String
  employer   EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  role       EmployerSeatRole @default(MEMBER)

  invitedEmail String
  inviteToken  String    @unique @default(cuid())
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  userId       String?   @unique

  @@unique([employerId, invitedEmail])
  @@index([userId])
}

enum EmployerSeatRole {
  OWNER
  MEMBER
}

model RoleProfile {
  id           String          @id @default(cuid())
  employerId   String
  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isActive     Boolean         @default(true)
  isSampleData Boolean         @default(false)

  roleTitle           String
  roleLevel           String?
  primaryFunction     String?
  locationRequirement String?
  remotePolicy        String?
  compMin             Int?
  compMax             Int?
  equityOffered       Boolean @default(false)

  // Role-specific work style requirements
  requiredPaceLevel     Int?
  requiredFeedbackStyle Int?
  requiredCollabStyle   Int?
  requiredStructure     Int?
  requiredAmbiguity     Int?
  requiredHours         Int?

  // Success definition
  success30Days  String?
  success90Days  String?
  success180Days String?

  // Hiring manager profile for this role
  hmWorkStyle          Int?
  hmFeedbackStyle      Int?
