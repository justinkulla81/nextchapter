// (CompanySizeLookup, the static tier list, and the calibration math in
// src/lib/scoring/level-rank.ts). Deliberately more granular than
// EmployerProfile.companySize (which tops out at "1000+") — see
// mapEmployerCompanySizeStringToBand() for the lossy adapter between the
// two. Never shown to any user; internal calibration input only.
enum CompanySizeBand {
  MICRO // 1-10
  SMALL // 11-50
  SMALL_MID // 51-200
  MID // 201-1000 — calibration anchor band
  MID_LARGE // 1001-5000
  LARGE // 5001-20000
  ENTERPRISE // 20001-100000
  MEGA // 100000+
}

