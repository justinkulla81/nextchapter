// detectCareerTrajectory in work-history-facts.ts) — null means there isn't
// enough work history yet to judge, never a guessed default.
enum CareerTrajectory {
  PROMOTED
  STABLE
  DEMOTED
}

enum PromotionVelocity {
  STEADY
  RAPID
  EXCEPTIONAL
}

enum PedigreeSignalCategory {
  FUNCTION
  INDUSTRY
  ROLE_TITLE
}

