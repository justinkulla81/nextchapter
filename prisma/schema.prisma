// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum PrivacyTier {
  PUBLIC // Full name, photo, complete history visible to all
  SEMI_PUBLIC // First name + last initial, company names, role level
  PRIVATE // Fully anonymized signal only
  STEALTH // Visible only to pre-approved companies
  LOCKED // Invisible to all searches (building profile)
}

// Source of a CandidateProfile.confidentialSearchMode change — see
// ConfidentialModeChangeLog.
enum ConfidentialModeChangeSource {
  ONBOARDING_DEFAULT // Set automatically by updateSituation from currentJobStatus
  SETTINGS_TOGGLE // Member flipped it themselves from Privacy settings
}

// PART FOUR §15 — the three leaderboard identity-display modes. Distinct
// from Community's identity system (generated handle vs. real name) even
// though GENERATED_HANDLE reuses the exact same deterministic-handle
// generator (see src/lib/community/identity.ts's generateCommunityHandle) —
// leaderboards additionally allow NOT_LISTED (ranked and counted, but shown
// with no name at all) and never allow a bare full/real name, only first
// name + last initial, per §15 "never displayed: employer, title, location,
// industry" — the same minimal-identity posture as Community's anonymize().
enum LeaderboardDisplayMode {
  FIRST_NAME_LAST_INITIAL
  GENERATED_HANDLE
  NOT_LISTED
}

// The six §14 boards. Kept as a real enum (unlike WeeklyBadgeEarned.badgeKey,
// which is deliberately a plain String) because LeaderboardPersonalBest rows
// are read back and switched on by board in application code (display
// labels, per-board copy) in a way that benefits from compile-time
// exhaustiveness — this table isn't an unbounded, ever-growing badge-key
// list the way WeeklyBadgeEarned is.
enum LeaderboardBoard {
  ACTION_SCORE
  OUTREACH
  APPLICATIONS
  VISIBILITY
  CONTRIBUTION
  LIFETIME_ACTION_SCORE
}

enum EngagementType {
  FULL_TIME
  FRACTIONAL
  INTERIM
  CONSULTING
  INTERNSHIP
}

// Highest degree completed — resume-derived (Phase 1), candidate-confirmable.
// Used for the education/outcome correlation on the admin metrics page.
enum HighestEducationLevel {
  HIGH_SCHOOL
  SOME_COLLEGE
  ASSOCIATE
  BACHELORS
  MASTERS
  MBA
  MPH
  JD
  MD
  DO // Doctor of Osteopathic Medicine — same licensure track as MD
  PHARMD // Doctor of Pharmacy
  DDS // Doctor of Dental Surgery (DMD is the equivalent degree, same bucket)
  DVM // Doctor of Veterinary Medicine
  PSYD // Doctor of Psychology (licensed clinical psychologist track)
  PHD
  OTHER
}

