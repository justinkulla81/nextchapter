// ── CANDIDATE SIDE ───────────────────────────────────────────────────────────

model CandidateProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One real row (see scripts/create-system-account.ts), backed by a real
  // Supabase auth user, that authors admin-originated CommunityPosts (see
  // src/lib/community/admin-story.ts) so ADMIN_STORY posts can use the same
  // non-null candidateId FK every other post uses instead of a nullable
  // column touching every author-identity call site. Every admin-facing
  // candidate count/list must exclude isSystemAccount: true — see
  // src/lib/admin/system-account-filter.ts.
  isSystemAccount Boolean @default(false)

  // Captured once, at the very first CandidateProfile row creation
  // (including anonymous pre-registration profiles) — a simple bot signal
  // for admin: many accounts sharing one IP in a short window is suspicious
  // in a way no single-account field can show. Never updated after create,
  // so it reflects signup origin, not most-recent activity.
  signupIp String?

  // Gates the single admin "new candidate" notification email — set the
  // first time firstName/lastName/email are all known (typically right
  // after resume extraction, occasionally later via the create-account
  // email fallback), never re-set. Replaces the old pair of premature
  // emails that used to fire at profile-creation and resume-row-creation
  // time, both before any identifying info existed.
  adminNewCandidateEmailSentAt DateTime?

  loginEvents         CandidateLoginEvent[]
  homepageVisitEvents HomepageVisitEvent[]

  // Privacy & Visibility
  privacyTier            PrivacyTier @default(LOCKED)
  // One-time bonus marker for confirming a privacy tier choice at all — same
  // shape as introCommittedAt/registrationCompletedAt below. Checked before
  // awarding PRIVACY_CONFIRMED so it only ever fires once per candidate.
  privacyOpenedUpBonusAt DateTime?

  // Confidential Search Mode — docs/specs/NextChapter_Search_Visibility_
  // References_Leaderboards.md PART ONE. A real, separate axis from
  // privacyTier below: privacyTier controls identity-display granularity
  // for the opt-in recruiter marketplace (Talent/Recruiter Database);
  // confidentialSearchMode controls whether ANYTHING the member does is
  // visible to anyone outside NextChapter (community, leaderboards,
  // LinkedIn, outreach, email, Gmail connection, Dossier distribution,
  // applications) — a hard rule, not a preference, checked at every render
  // and send path per the spec's Build Notes. The two are read together in
  // several places (e.g. Community identity display) but are never merged.
  //
  // Default set once at onboarding completion (see updateSituation in
  // src/app/onboarding/actions.ts) from currentJobStatus, per the accepted
  // Phase-A mapping — lossy, since no real 4-value persona field exists yet:
  //   EMPLOYED_CONSIDERING_MOVE -> ON  (closest match to "worried I'll be let go")
  //   RESIGNED                  -> ON  (garden leave / notice period / reference risk)
  //   everything else           -> OFF (LAID_OFF, CAREGIVER_LEAVE_SABBATICAL,
  //                                      CAREER_PIVOT, RELOCATED_FOR_FAMILY,
  //                                      NEW_GRADUATE_FIRST_JOB, and null)
  // After that, the member fully controls it (settings toggle — see
  // src/app/dashboard/privacy/actions.ts:setConfidentialSearchMode). Turning
  // on is immediate; turning off requires a confirmation naming exactly what
  // becomes visible (spec §3).
  //
  // §4.1 Leaderboards (not built yet — Phase-B+ of this spec): when the
  // Weekly Leaderboards feature is built, every leaderboard query MUST
  // hard-exclude candidates where confidentialSearchMode is true, with no
  // opt-in control shown to override it. Leave this comment for that build.
  //
  // Every change is appended to ConfidentialModeChangeLog below with a
  // timestamp, so "what was the state when X happened" is always
  // reconstructable — see spec Build Notes ("If something leaks, we need
  // the state at the time").
  //
  // Formerly proxied elsewhere as privacyTier === 'STEALTH' (explicitly
  // flagged "provisional until Confidential Search Mode exists" in
  // src/lib/companies/insider-network.ts, src/app/support/admin/(portal)/
  // population/page.tsx, and src/lib/analytics/population-metrics.ts) —
  // those call sites now read this field directly instead.
  confidentialSearchMode          Boolean                     @default(false)
  confidentialSearchModeChangedAt DateTime?
  confidentialModeChangeLog       ConfidentialModeChangeLog[]

  // PART THREE §10-12 — "Passive to Active" prompt (once, without
  // pressure). Purpose-built rather than reusing PageBoxDismissal: that
  // model is a single "dismissed today, reappears tomorrow" (or permanent
  // for WHY_IT_MATTERS) contract for admin-authored content keyed on
  // pageKey+boxType. This prompt needs three states its three buttons
  // produce — shown, soft-dismissed ("Not yet," can re-trigger on the next
  // real signal), and permanently dismissed ("Don't ask again") — plus a
  // real 30-day re-show cooldown, none of which maps cleanly onto that
  // shape. A timestamp + boolean pair, mirroring the proven
  // recruiterUnlockNudgedAt once-per-period nudge-throttle pattern above,
  // covers it more simply than bending PageBoxDismissal to fit.
  //
  // passiveToActivePromptLastShownAt is both the 30-day throttle reference
  // and the reference point for the "60 days elapsed with no prompt shown"
  // trigger (src/lib/dashboard/passive-to-active-prompt.ts).
  // passiveToActivePromptDontAskAgain is permanent and checked before every
  // trigger evaluation — never reset by anything.
  passiveToActivePromptLastShownAt  DateTime?
  passiveToActivePromptDontAskAgain Boolean   @default(false)

  // Baseline snapshot for the "persona changed from Worried to Laid off"
  // trigger (§11). Set whenever confidentialSearchMode transitions to true
  // (onboarding default in updateSituation, or the settings toggle in
  // setConfidentialSearchMode) to currentJobStatus's value AT THAT MOMENT —
  // not updated anywhere else. The trigger fires when this stayed
  // EMPLOYED_CONSIDERING_MOVE (the accepted lossy "Worried" proxy, same
  // mapping as defaultConfidentialSearchMode) while currentJobStatus is now
  // LAID_OFF. Left null for candidates who entered confidential mode before
  // this field existed — same "no surprise historical backlog" convention
  // as communityLastViewedAt above; the trigger simply can't fire for them
  // until they toggle the mode again. NOTE: currentJobStatus is currently
  // write-once at onboarding (updateSituation) with no candidate-facing
  // path to change it afterward anywhere in this codebase (confirmed by
  // investigation) — so this trigger's detection logic is real and correct,
  // but cannot fire in practice yet. That gap is a real "update your
  // situation" settings feature this spec doesn't ask for; deliberately not
  // built here to keep this change scoped to §10-12.
  confidentialModeEnteredJobStatus CurrentJobStatus?

  // PART FOUR §13-20 — Weekly Leaderboards. Opt-in, default off (§15),
  // checked at the query layer of every board alongside confidentialSearchMode
  // (see src/lib/leaderboard/queries.ts — a candidate in Confidential Search
  // Mode never gets an opt-in control shown at all, per §4.1, and is
  // hard-excluded regardless of this flag's value). leaderboardDisplayMode is
  // required (one of the three §15 modes) the moment leaderboardOptIn turns
  // true; null while opted out. leaderboardOptInAt backs the one-time
  // opt-in confirm bonus, mirroring privacyOpenedUpBonusAt above.
  leaderboardOptIn       Boolean                 @default(false)
  leaderboardDisplayMode LeaderboardDisplayMode?
  leaderboardOptInAt     DateTime?

  // §20 "personal bests" / §18 "personal best shown alongside every board" —
  // a real historical max needs real storage (live-querying "best week ever"
  // every render is computationally fine but throws away the record the
  // moment a later week is worse). One row per board, upserted with
  // MAX(stored, this week's live total) — see
  // src/lib/leaderboard/personal-bests.ts. Deliberately NOT an append-only
  // ledger of every week's total (that's just WeeklySprint/OutreachLog/etc.
  // themselves, already queryable) — this table exists only to remember the
  // single best one, the one number that can't be cheaply re-derived once a
  // later week beats it and the old high-water mark would otherwise be lost.
  leaderboardPersonalBests LeaderboardPersonalBest[]

  // Recruiter database — explicit candidate opt-in required before appearing
  // in any employer-facing Talent match list. privacyTier alone is opt-out,
  // not opt-in, and isn't sufficient consent for a matching/ranking surface.
  recruiterDatabaseOptIn       Boolean   @default(false)
  recruiterDatabaseRequestedAt DateTime?
  // Set when the "new great candidate" blast has been sent to recruiters for
  // this candidate (auto or admin-triggered) — the admin Recruiter Database
  // page's "requested" bucket. Distinct from recruiterDatabaseRequestedAt
  // above, which is when the CANDIDATE opted in, not when recruiters were
  // told about them.
  recruiterNotifiedAt          DateTime?
  // Throttle on the "you're A-grade — unlock the recruiter network" nudge
  // email, so the weekly auto-nudge cron doesn't re-send every week forever.
  recruiterUnlockNudgedAt      DateTime?

  // Resume Book — separate consent from recruiterDatabaseOptIn above (Resume
  // Book is scoped to resume + fit-matching only, not full profile access).
  // Defaults false at the schema level so existing candidates aren't
  // silently opted in; the resume-upload form itself renders the checkbox
  // pre-checked for anyone who hasn't set a preference yet, matching the
  // "checked automatically" product decision.
  resumeBookOptIn Boolean @default(false)

  // §4.3: LinkedIn posting through NextChapter's own integration is
  // disabled by default while Confidential Search Mode is on — this is the
  // explicit, deliberate override, shown once with the "your current
  // employer can see this" warning (src/components/dashboard/marketing-
  // plan/WaysToSayIt.tsx). Irrelevant while confidentialSearchMode is
  // false; not reset automatically when confidential mode turns back on
  // later, since re-showing the warning next time they try to post again
  // is the simpler, equally-safe behavior.
  confidentialLinkedInPostingOptIn Boolean @default(false)

  // Step 2: "Which of these sounds like you" persona picker — sets
  // currentJobStatus via SITUATION_TO_JOB_STATUS the same way a homepage
  // situational-entry click does, so Part 1 below never re-asks it.
  desireComplete Boolean @default(false)

  // Part 1: Your Situation
  currentJobStatus   CurrentJobStatus?
  gapDuration        GapDurationBucket? // only asked if currentJobStatus != EMPLOYED_CONSIDERING_MOVE
  // DEPRECATED — question removed from Your Situation page (Batch 24); the
  // "how difficult has your search been" question below covers this signal
  // instead. Column kept (not dropped) only so existing historical answers
  // aren't destroyed — do not read this in new code.
  jobSearchIntensity Int? // 0-100 slider, "casually looking" -> "extremely"
  biggestBarriers    String[]           @default([]) // multi-select (select-all), "What do you think are the biggest barriers to get a new job?" — see BIGGEST_BARRIER_OPTIONS
  // "How actively are you searching right now?" — a distinct axis from
  // jobSearchDifficultyLevel (how hard the search feels vs. how actively
  // they're even looking). Feeds Victoria's directness calibration
  // (isCasuallySearching) and suppresses week-count urgency language for
  // non-active searchers.
  searchIntensity    SearchIntensity?

  // Admin-confirmed match to a LayoffCohort (candidate matching, not
  // self-selected) — set via /support/admin/layoff-cohorts, surfaces a
  // cohort-scoped view inside Community once assigned.
  layoffCohortId String?
  layoffCohort   LayoffCohort? @relation(fields: [layoffCohortId], references: [id])
  currentCity    String? // resume-derived (Phase 1), candidate-confirmable
  currentState   String?
  currentCountry String        @default("US")
  // Normalized metro-area bucket derived from currentCity/currentState (see
  // src/lib/constants/metro-areas.ts) — never authoritative, only used for
  // Community metro grouping. currentCity/currentState stay the source of truth.
  metroArea      String?

  // Part 1: Job search activity self-report — all optional, all self-reported.
  jobsAppliedBucket         String? // "0-20" | "20-100" | "100+"
  interviewsReceivedCount   Int?
  networkingLevel           Int? // 1-4: Not much / Some but should do more / A lot / Can't do more
  learnedNewSkillsLevel     Int? // 1-3: Not yet / A little / Yes, actively
  triedPartTimeOrConsulting Boolean?
  triedExecutiveCoaching    Boolean?
